      "expect": {"delivered": true, "layerA": "ok", "layerB": "skipped", "source": "stash", "filled": 0, "lines_eq_accepted": true,
                 "preserve": {"archived": true, "stashed": true, "deleted": true}, "unstable_count": 0,
                 "sink_posts_min": 1, "sink_last_status": 200, "body_sha_matches_sink": true, "unrecovered_count": 0,
                 "note": "R5 정상 경로: delivered=true · 보충 0 · lineCount==accepted · unstable 미호출 · deleteDir 도달"}
    },
    "archive_fail": {
      "case": "01_normal", "run_preserve": true, "outcome": "completed", "sink": {"status": "200"},
