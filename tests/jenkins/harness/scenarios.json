                 "preserve": {"archived": true, "stashed": false, "deleted": true}, "unstable_count": 0,
                 "sink_posts_min": 1, "sink_last_status": 200,
                 "note": "R7: stash 실패 → finalizer 가 unarchive 로 회수 · archive 성공이므로 deleteDir"}
