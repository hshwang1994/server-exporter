                 "preserve": {"archived": false, "stashed": true, "deleted": false},
                 "unstable_contains": ["archive 실패 — stash 로만 전달"], "sink_posts_min": 1, "sink_last_status": 200,
                 "note": "R7: archive 실패가 stash 를 막지 않는다 · workspace 보존 · finalizer 는 stash 로 전달"}
