// tests/jenkins/harness/Jenkinsfile_harness — main 전용 실행 Harness (2026-10-04, Astra 3차 §5 · 4차 §2·§5). 운영 수집 Job 이 아니다.
//
//   Job: clovirone-cicd/clovirone-server-gather-harness — Pipeline from SCM(*/main) · Script Path 이 파일 · Lightweight checkout ·
//        **시나리오당 빌드 1개**(stash 이름 · artifact 이름 · currentBuild.result 가 빌드 단위라 한 빌드에 여러 시나리오를 섞지 않는다).
//   하는 일: Jenkinsfile_portal(main checkout 또는 CI 가 archive 한 생성 tree)의 최상위 함수를 build_functions.py 로 **글자 그대로** 잘라
//           wrapper(장애 주입 · params 그림자 · unstable 기록)와 함께 load → fixture.py 로 현재 빌드에 맞는 입력 준비 → callback_sink.py(POST 수신, controller loopback) →
//           sePreserveGatherOutput() / seFinalizeAndCallback() 을 **실제 Jenkins step 으로** 실행 → harness_verdict.py 가 PASS/FAIL/PARTIAL.
//   운영 코드에는 장애 주입 분기가 없다. 생성 tree 의 함수도 같은 Harness 로 검증한다(FUNCTIONS_SRC=artifact).
//   산출물: harness_result.json(판정) · harness_functions.groovy(+meta: 원본 해시) · harness_calls.json · harness_control.json ·
//           preserve_state.json · fixture_state.json · sink/record.jsonl · observed/{finalize_summary,callback_body}.json
//   2026-10-04 검토 C5: interruption 시나리오 — bounded(Tier 2, 승인 실측 → 없으면 PARTIAL/승인) · foreign_timeout · user_abort(자기 빌드 /stop) ·
//           aborted_outcome_finalize(ABORTED 빌드의 사후 finalize) · sink_hold(main Job T2 의 Callback 수신 증거용 sink 유지)

properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '200')),
    parameters([
        string(name: 'SCENARIO', defaultValue: 'normal_success', description: 'tests/jenkins/harness/scenarios.json 의 시나리오 이름'),
        string(name: 'MAIN_SHA', defaultValue: '', description: '검증 중인 개발 main SHA X — checkout 과 다르면 중단한다(비우면 검사 안 함)'),
        choice(name: 'FUNCTIONS_SRC', choices: ['checkout', 'artifact'], description: 'checkout = main 의 Jenkinsfile_portal · artifact = CI 빌드가 archive 한 생성 tree(prodtree.tar.gz)'),
        string(name: 'ARTIFACT_BASE_URL', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: CI 빌드 artifact 기준 URL (…/artifact)'),
        string(name: 'EXPECTED_SHA256', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: 생성 tree Jenkinsfile_portal 의 SHA-256 (CI 가 넘긴 값, 불일치면 중단)'),
        string(name: 'SINK_PORT', defaultValue: '18080', description: 'callback_sink.py 포트 — controller(built-in) 의 127.0.0.1 에 바인딩'),
        booleanParam(name: 'BOUNDED', defaultValue: false, description: 'SE_FINALIZER_BOUNDED=true — 4 시그니처가 승인된 Jenkins 에서만'),
        string(name: 'LOC', defaultValue: 'git', description: 'Callback body 의 loc'),
        string(name: 'DEPLOYMENT_ENV', defaultValue: 'harness', description: 'Callback body 의 deploymentEnvironmentId'),
    ]),
])

// sandbox 승인 실측(검토 C5) — Tier 2 가 쓰는 4 시그니처가 이 Jenkins 에서 허용되는지 **실제 호출**로 확인한다. 거부는 RejectedAccessException 으로
//   잡혀 false 가 되고, 결과는 harness_control.json 의 approvals 에 남는다(verdict 가 PARTIAL/승인 판정에 쓴다). FlowNode 는 직렬화되지 않으므로 @NonCPS 안에서만 만진다.
@NonCPS
Map seHarnessProbeNode(Object node) {
    Map r = [getEnclosingBlocks: false, getId: false, errors: [:]]
    try {
        def blocks = node.getEnclosingBlocks()
        r.getEnclosingBlocks = true
        try { blocks[0].getId(); r.getId = true } catch (Exception e2) { r.errors.getId = e2.getClass().name }
    } catch (Exception e) {
        r.errors.getEnclosingBlocks = e.getClass().name
    }
    return r
}

@NonCPS
Map seHarnessProbeCauses(Object fie) {
    Map r = [getCauses: false, getNodeId: false, errors: [:]]
    try {
        def causes = fie.getCauses()
        r.getCauses = true
        try {
            for (Object c in causes) { c.getNodeId(); r.getNodeId = true }
        } catch (Exception e2) { r.errors.getNodeId = e2.getClass().name }
    } catch (Exception e) {
        r.errors.getCauses = e.getClass().name
    }
    return r
}

// Runner 시스템 python3 는 3.9 — Harness 도구는 venv(3.12, PyYAML)에서 돈다. venv 선택은 scripts/activate_ansible_venv.sh 한 곳.
String PY = '. "$WORKSPACE/scripts/activate_ansible_venv.sh" >/dev/null 2>&1 || true; python3'
String PRESERVE_FILES = 'gather_output.json,gather_manifest.json,gather_rc.txt,gather_checkpoint.jsonl,gather_final.jsonl,gather_finalize_report.json'

timeout(time: 45, unit: 'MINUTES') {
    node('linux') {
        deleteDir()
        String scenario = params.SCENARIO.trim()
        Map control = [scenario: scenario, rethrown: null, sink_reachable: null, functions_source: params.FUNCTIONS_SRC, preserve_rethrown: false]

        // ── ① 소스 — main checkout (Job SCM = */main). MAIN_SHA 가 주어지면 같은 후보인지 확인한다.
        def scmVars = checkout scm
        String checkoutSha = (scmVars?.GIT_COMMIT ?: '').toString()
        if (!checkoutSha) { checkoutSha = sh(returnStdout: true, script: 'git rev-parse HEAD').trim() }
        if (params.MAIN_SHA?.trim() && params.MAIN_SHA.trim() != checkoutSha) {
            error "[Harness] MAIN_SHA ${params.MAIN_SHA} != checkout ${checkoutSha} — 검증 중인 후보와 다른 코드다"
        }
        control.checkout_sha = checkoutSha
        currentBuild.description = "${scenario} @${checkoutSha.take(10)} ${params.FUNCTIONS_SRC}"

        def scenarios = readJSON(file: 'tests/jenkins/harness/scenarios.json', returnPojo: true).scenarios
        def sc = scenarios[scenario]
        if (sc == null) { error "[Harness] unknown scenario '${scenario}' — scenarios.json 참조" }
        boolean bounded = params.BOUNDED || (sc.bounded ?: false)
        boolean holdOnly = (((sc.hold_seconds ?: 0) as int) > 0)
        control.bounded = bounded
        control.expected_jenkins_result = (sc.jenkins_result ?: 'SUCCESS')

        // gather_ws = 운영 함수가 보는 WORKSPACE(수집 workspace 의 축소판): 입력 파일 + Layer A 가 쓰는 scripts/ · common/vars/.
        //   deleteDir() 이 Harness 파일을 지우지 않도록 하위 디렉터리로 분리한다. 생성 tree 모드에서는 그 tree 자체다.
        String srcFile = 'Jenkinsfile_portal'
        Map trusted = [:]
        sh 'rm -rf gather_ws prodtree_src && mkdir -p gather_ws'
        if (params.FUNCTIONS_SRC == 'artifact') {
            String base = params.ARTIFACT_BASE_URL.trim().replaceAll('/+$', '')
            if (!base) { error '[Harness] FUNCTIONS_SRC=artifact 에는 ARTIFACT_BASE_URL 이 필요하다' }
            // ignoreSslErrors: lab Jenkins 의 자체 서명 인증서를 agent JVM 이 신뢰하지 않는다(Harness #40 PKIX). 내용은 아래 sha256(CI 가 넘긴 값)으로 대조한다.
            httpRequest(url: "${base}/prodtree.tar.gz", authentication: 'se-jenkins-lint', ignoreSslErrors: true, validResponseCodes: '200', outputFile: 'prodtree.tar.gz')
            sh 'mkdir -p prodtree_src && tar -xzf prodtree.tar.gz -C prodtree_src && cp -a prodtree_src/. gather_ws/'
            srcFile = 'prodtree_src/Jenkinsfile_portal'
            String got = sh(returnStdout: true, script: "sha256sum ${srcFile} | cut -d' ' -f1").trim()
            if (params.EXPECTED_SHA256?.trim() && got != params.EXPECTED_SHA256.trim()) {
                error "[Harness] 생성 tree 함수 원본 해시 불일치 got=${got} expected=${params.EXPECTED_SHA256}"
            }
            control.artifact_base = base
            control.source_sha256 = got
            if (fileExists('prodtree_src/.production-provenance.json')) {
                control.provenance = readJSON(file: 'prodtree_src/.production-provenance.json', returnPojo: true)
            }
            // finalizer 의 readTrusted 는 Job SCM(main)이 아니라 **이 생성 tree** 의 파일을 돌려줘야 한다 → 내용을 미리 읽어 둔다
            for (String path in ['scripts/jenkins/se_finalize.groovy', 'common/vars/failure_reasons.yml', 'common/vars/supported_sections.yml']) {
                if (fileExists("prodtree_src/${path}")) { trusted[path] = readFile(file: "prodtree_src/${path}", encoding: 'UTF-8') }
            }
        } else {
            // Layer A 가 읽는 정본: common/vars/*.yml + common/tasks/normalize/{init_fragments,build_meta,build_correlation}.yml (Harness #6: normalize 누락 → exit 3)
            sh 'mkdir -p gather_ws/scripts gather_ws/common/tasks && cp -a scripts/finalize_gather_output.py scripts/activate_ansible_venv.sh gather_ws/scripts/ && cp -a common/vars gather_ws/common/ && cp -a common/tasks/normalize gather_ws/common/tasks/'
        }

        // ── ② wrapper 를 붙인 함수 스크립트 (원본 글자 불변 — 해시 기록)
        sh "${PY} tests/jenkins/harness/build_functions.py --source ${srcFile} --scenario ${scenario} --out harness_functions.groovy --meta harness_functions_meta.json"
        def meta = readJSON(file: 'harness_functions_meta.json', returnPojo: true)
        control.functions_sha256 = meta.functions_sha256
        control.source_sha256 = control.source_sha256 ?: meta.source_sha256
        echo "[Harness] scenario=${scenario} functions_sha256=${meta.functions_sha256} source_sha256=${meta.source_sha256} defs=${meta.defs}"

        // ── ③ Callback sink — **controller 의 loopback** 에서 띄운다. finalizer 의 httpRequest 는 node('built-in') 안에서 실행되므로 요청은 controller 에서
        //      나간다(http_request 1.25 는 node 컨텍스트의 노드에서 실행). Harness #6 에서 agent 에 띄운 sink 는 agent 의 healthz 만 통과하고
        //      controller 발 POST 는 NoRouteToHost(Runner 인바운드 거부)였다. 도달성 확인도 같은 node('built-in') 안에서 한다.
        String sinkPort = params.SINK_PORT.trim()
        String sinkUrl = "http://127.0.0.1:${sinkPort}"
        Map sinkCfg = (sc.sink ?: [status: '200'])
        String sinkSrc = readFile(file: 'tests/jenkins/harness/callback_sink.py', encoding: 'UTF-8')
        sh 'mkdir -p sink && rm -f sink/record.jsonl sink/sink.log sink/pid'
        // sink 파일은 finalizer 가 쓰는 controller workspace 의 **형제 디렉터리**(…@sink)에 둔다 — finalizer 의 deleteDir() 가 열린 파일을 지우려다
        // NFS silly-rename(.nfs* "Device or resource busy") 으로 실패했다(Harness #17).
        String sinkWs = ''
        node('built-in') {
          ws("${pwd()}@sink") {
            sinkWs = pwd()
            writeFile(file: 'callback_sink.py', text: sinkSrc, encoding: 'UTF-8')
            sh """mkdir -p sink
                  if [ -f sink/pid ]; then kill "\$(cat sink/pid)" 2>/dev/null || true; sleep 1; fi
                  # 중단된 이전 빌드의 sink 가 같은 포트를 쥐고 있으면(열린 파일 = NFS .nfs* busy, Harness #25) 이 사용자 소유의 그 프로세스만 끝낸다.
                  # TERM 뒤에도 남아 있으면(종전 sink 는 non-daemon timer 로 lingering — Harness #26) KILL. 같은 사용자 · 같은 스크립트 · 같은 포트만.
                  command -v pkill >/dev/null 2>&1 || echo "[Harness] pkill 없음 — 이전 sink 정리를 건너뛴다"
                  PAT="callback_sink.py --bind 127.0.0.1 --port ${sinkPort} "
                  if pkill -TERM -u "\$(id -un)" -f "\$PAT" 2>/dev/null; then sleep 2; fi
                  if pkill -KILL -u "\$(id -un)" -f "\$PAT" 2>/dev/null; then echo "[Harness] 이전 sink 를 KILL 로 정리"; sleep 1; fi
                  rm -f sink/record.jsonl sink/sink.log sink/pid
                  PYBIN="\$(command -v python3 || command -v /usr/libexec/platform-python || true)"
                  echo "[Harness] controller python=\${PYBIN:-absent} \$( [ -n "\$PYBIN" ] && "\$PYBIN" --version 2>&1 )"
                  if [ -n "\$PYBIN" ]; then
                      JENKINS_NODE_COOKIE=dontKillMe nohup "\$PYBIN" callback_sink.py --bind 127.0.0.1 --port ${sinkPort} --record "\$PWD/sink/record.jsonl" \\
                          --status '${sinkCfg.status ?: '200'}' --mode '${sinkCfg.mode ?: 'respond'}' --delay '${sinkCfg.delay ?: 0}' --pidfile "\$PWD/sink/pid" --max-seconds 2400 \\
                          > sink/sink.log 2>&1 &
                      sleep 2
                  fi"""
            try {
                httpRequest(url: "${sinkUrl}/healthz", validResponseCodes: '200', timeout: 10)
                control.sink_reachable = true
                echo "[Harness] sink ${sinkUrl} — controller(built-in) 에서 도달 (GET /healthz 는 도달성 확인일 뿐 Callback 증거가 아니다)"
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                throw fie
            } catch (Exception e) {
                control.sink_reachable = false
                echo "[Harness] controller 에서 sink(${sinkUrl}) 에 닿지 못함: ${e.message} — Callback 검증은 PARTIAL"
            }
          }
        }
        control.sink_workspace = sinkWs

        // ── ③' 승인 실측 (Tier 2 시나리오 · sandbox_probe) — 결과만 기록한다
        if (sc.probe_approvals) {
            Map approvals = [:]
            try {
                def n = getContext(org.jenkinsci.plugins.workflow.graph.FlowNode)
                approvals.putAll(seHarnessProbeNode(n))
                n = null
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                throw fie
            } catch (Exception e) {
                approvals.getEnclosingBlocks = false
                approvals.probe_error = e.getClass().name
            }
            try {
                timeout(time: 1, unit: 'SECONDS') { sleep(time: 5, unit: 'SECONDS') }
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                approvals.putAll(seHarnessProbeCauses(fie))
            }
            control.approvals = approvals
            echo "[Harness] sandbox approvals: ${approvals}"
        }

        // ── ③'' sink_hold — 판정 없이 sink 만 hold_seconds 동안 유지한다 (main Job 이 callbackUrl=http://127.0.0.1:${sinkPort} 로 보낸 POST 가 record 에 남는다)
        if (holdOnly) {
            echo "[Harness] sink_hold: ${sinkUrl} 를 ${sc.hold_seconds}s 유지 — main Job T2 트리거는 이 사이에 한다"
            sleep(time: (sc.hold_seconds as int), unit: 'SECONDS')
        }

        // ── ④ fixture — corpus case 입력 + **현재 빌드**의 manifest
        String eventUuid = "harness-${env.BUILD_TAG}"
        def lib = null
        Map preserve = [:]
        control.rethrown = false
        if (!holdOnly) {
        sh """${PY} tests/jenkins/harness/fixture.py --scenarios tests/jenkins/harness/scenarios.json --scenario ${scenario} \\
                --corpus tests/fixtures/finalize_corpus --workspace "\$PWD/gather_ws" --job '${env.JOB_NAME}' --number '${env.BUILD_NUMBER}' --url '${env.BUILD_URL}' \\
                --loc '${params.LOC}' --deployment-env '${params.DEPLOYMENT_ENV}' --event-uuid '${eventUuid}' --callback-url '${sinkUrl}' --out fixture_state.json"""
        def fx = readJSON(file: 'fixture_state.json', returnPojo: true)
        env.SE_MANIFEST_JSON = fx.manifest_json
        env.SE_GATHER_OUTCOME = fx.outcome
        env.SE_BUILD_START_EPOCH = "${(long) (System.currentTimeMillis() / 1000L)}"
        env.SE_FINALIZER_BOUNDED = bounded ? 'true' : 'false'
        for (String k in ['SE_PRESERVE_LAYER_A', 'SE_PRESERVE_ARCHIVED', 'SE_PRESERVE_STASHED', 'SE_PRESERVE_MANIFEST', 'SE_PRESERVE_HASRESULT']) { env."${k}" = '' }

        // ── ⑤ load + init (바깥 스크립트 = 실제 step)
        lib = load 'harness_functions.groovy'
        lib.seHarnessInit(this, [params  : [loc: params.LOC, deploymentEnvironmentId: params.DEPLOYMENT_ENV, eventUuid: eventUuid,
                                            callbackUrl: sinkUrl, target_type: fx.channel],
                                 trusted : trusted, slowSeconds: (sc.slow_seconds ?: 45)])
        if (lib.params.callbackUrl != sinkUrl) { error '[Harness] params 그림자가 동작하지 않는다 — getParams() 해석 확인' }

        // ── ⑥ 보존 — Gather post 가 하는 일을 gather_ws 에서 실제 step 으로 (Layer A · archive · stash). 주입은 wrapper 가 한다.
        dir('gather_ws') {
            withEnv(["WORKSPACE=${pwd()}"]) {
                if (fx.run_preserve) {
                    try {
                        lib.sePreserveGatherOutput()
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        // Tier 2 보존 상한(archive·stash PRESERVE_STEP) 시나리오: 승인 4 시그니처가 없으면 seBounded 가 설계대로 재전파한다 —
                        // 기록하고 finalizer 는 건너뛴다(verdict PARTIAL/승인). bounded 가 아니면 진짜 중단이라 그대로 전파한다.
                        if (!bounded) { throw fie }
                        control.rethrown = true
                        control.preserve_rethrown = true
                        control.interruption_class = fie.getClass().name
                        echo "[Harness] 보존 단계에서 interruption 이 전파됐다 (bounded — 승인 없으면 설계): ${fie.getClass().name}"
                    }
                    preserve = [layerA: env.SE_PRESERVE_LAYER_A, archived: env.SE_PRESERVE_ARCHIVED == 'true', stashed: env.SE_PRESERVE_STASHED == 'true',
                                manifestOk: env.SE_PRESERVE_MANIFEST == 'true', hasResult: env.SE_PRESERVE_HASRESULT == 'true']
                } else if (sc.layer_a_direct) {
                    // Layer A 를 직접 돌린 뒤 변형(예: report 손상)을 적용하고 Harness 가 stash — "손상된 Layer A 결과" 입력
                    sh "${PY} scripts/finalize_gather_output.py --workspace \"\$PWD\" --repo-root \"\$PWD\" --outcome ${fx.outcome} || true"
                    sh """${PY} ../tests/jenkins/harness/fixture.py --scenarios ../tests/jenkins/harness/scenarios.json --scenario ${scenario} --corpus ../tests/fixtures/finalize_corpus \\
                            --workspace "\$PWD" --job x --number 0 --url x --callback-url x --out ../fixture_post.json --post-layer-a"""
                    stash(name: 'gather-output', includes: PRESERVE_FILES, allowEmpty: true)
                } else {
                    stash(name: 'gather-output', includes: PRESERVE_FILES, allowEmpty: true)
                }
            }
        }
        preserve.deleted = !fileExists('gather_ws/gather_manifest.json')
        writeFile(file: 'preserve_state.json', text: groovy.json.JsonOutput.toJson(preserve), encoding: 'UTF-8')
        echo "[Harness] preserve=${preserve}"

        // ── ⑦ finalizer — 실제 timeout(720){ node('built-in') {…} }. outer_timeout 은 Harness 가 짧은 외곽 timeout 으로 감싼다.
        //    set_result(aborted_outcome_finalize): ABORTED 빌드의 사후 finalize — seCallback 의 aborted 분기(1회 시도)를 실제로 탄다.
        //    self_abort_after(user_abort): 느린 unstash 중에 Harness 가 자기 빌드에 POST /stop — 사용자 중단과 같은 interruption 이 finalizer 로 들어간다.
        //    expect_interruption 시나리오만 interruption 을 기록 뒤 삼킨다(우리가 만든 것) — 그 외는 진짜 중단이라 그대로 전파한다.
        // bounded(Tier 2) 시나리오도 포함: 승인 4 시그니처가 없으면 finalizer 가 설계대로 재전파하므로 Harness 가 받아 기록하고 verdict 가 PARTIAL/승인 으로 둔다
        //   (CI #10 Harness #105/#106: 전파를 그대로 두면 빌드가 ABORTED 로 끝나 판정 artifact 가 남지 않았다).
        boolean expectInterruption = (sc.expect_interruption ?: false) || (sc.outer_timeout_seconds ?: 0) > 0 || bounded
        if (sc.set_result) {
            currentBuild.result = sc.set_result.toString()
            echo "[Harness] currentBuild.result=${currentBuild.result} (시나리오 ${scenario})"
        }
        if (control.preserve_rethrown) {
            echo "[Harness] 보존 단계가 재전파됐으므로 finalizer 를 실행하지 않는다 (판정은 PARTIAL/승인)"
        } else {
        try {
            if (sc.self_abort_after) {
                int after = sc.self_abort_after as int
                String stopUrl = "${env.BUILD_URL}stop"
                parallel(
                    finalize: { lib.seFinalizeAndCallback() },
                    stopper: {
                        sleep(time: after, unit: 'SECONDS')
                        echo "[Harness] user_abort: POST ${stopUrl} (자기 빌드 중단 — 사용자 Abort 와 같은 경로)"
                        httpRequest(url: stopUrl, httpMode: 'POST', authentication: 'se-jenkins-lint', ignoreSslErrors: true, validResponseCodes: '100:599', timeout: 30)
                    },
                    failFast: false
                )
            } else if (sc.outer_timeout_seconds) {
                timeout(time: (sc.outer_timeout_seconds as int), unit: 'SECONDS') { lib.seFinalizeAndCallback() }
            } else {
                lib.seFinalizeAndCallback()
            }
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            control.rethrown = true
            control.interruption_class = fie.getClass().name
            echo "[Harness] interruption 이 finalizer 밖으로 전파됐다 (기대: 삼키지 않는다): ${fie.getClass().name}"
            if (!expectInterruption) { throw fie }   // 우리가 만든 interruption 이 아니면 진짜 중단이다 — 그대로 전파
        }
        }   // !preserve_rethrown
        if (sc.self_abort_after && control.rethrown) {
            currentBuild.result = 'ABORTED'          // 사용자 중단이 만든 결과를 Harness 가 되돌리지 않는다 (시나리오 기대 jenkins_result=ABORTED)
        }
        }   // !holdOnly

        // ── ⑧ 관측 수집 — finalizer 가 archive 한 요약·body 를 되가져오고, 호출 기록·제어 정보를 남긴다
        // List 인자는 JsonOutput.toJson(Object) 로 해석돼 sandbox 가 거부한다(Harness #6) — writeJSON step 은 List/Map 모두 받는다
        writeJSON(file: 'harness_calls.json', json: (lib != null ? lib.seHarnessCalls() : []))
        sh 'mkdir -p observed'
        try {
            unarchive mapping: ['finalize_summary.json': 'observed/finalize_summary.json', 'callback_body.json': 'observed/callback_body.json']
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            throw fie
        } catch (Exception e) {
            echo "[Harness] 요약/body unarchive 실패(finalizer 가 archive 전에 끝났을 수 있다): ${e.message}"
        }
        if (!fileExists('preserve_state.json')) { writeFile(file: 'preserve_state.json', text: groovy.json.JsonOutput.toJson(preserve), encoding: 'UTF-8') }
        writeFile(file: 'harness_control.json', text: groovy.json.JsonOutput.toJson(control), encoding: 'UTF-8')
        // sink 종료 + 수신 기록을 controller workspace 에서 agent 로 가져온다(verdict · archive 는 agent 의 sink/ 를 읽는다)
        String sinkRecord = ''
        String sinkLog = ''
        node('built-in') {
          ws(sinkWs) {
            sh 'if [ -f sink/pid ]; then kill "$(cat sink/pid)" 2>/dev/null || true; fi; sleep 1; true'
            if (fileExists('sink/record.jsonl')) { sinkRecord = readFile(file: 'sink/record.jsonl', encoding: 'UTF-8') }
            if (fileExists('sink/sink.log')) { sinkLog = readFile(file: 'sink/sink.log', encoding: 'UTF-8') }
          }
        }
        writeFile(file: 'sink/record.jsonl', text: sinkRecord, encoding: 'UTF-8')
        writeFile(file: 'sink/sink.log', text: sinkLog, encoding: 'UTF-8')

        // ── ⑨ 판정 — 기대 불일치는 UNSTABLE(FAIL), 관측 부족은 UNSTABLE(PARTIAL), 도구 실패는 FAILURE
        int rc = sh(returnStatus: true, script: """${PY} tests/jenkins/harness/harness_verdict.py --scenarios tests/jenkins/harness/scenarios.json --scenario ${scenario} \\
                --summary observed/finalize_summary.json --body observed/callback_body.json --calls harness_calls.json --sink sink/record.jsonl \\
                --preserve preserve_state.json --control harness_control.json --meta harness_functions_meta.json --out harness_result.json""")
        archiveArtifacts(artifacts: 'harness_result.json,harness_functions.groovy,harness_functions_meta.json,harness_calls.json,harness_control.json,preserve_state.json,fixture_state.json,fixture_post.json,sink/record.jsonl,sink/sink.log,observed/*',
                         allowEmptyArchive: true, fingerprint: false)
        if (rc == 1) {
            unstable("[Harness] ${scenario}: FAIL — 기대와 다르다 (harness_result.json)")
        } else if (rc == 2) {
            unstable("[Harness] ${scenario}: PARTIAL — 관측 부족 (harness_result.json)")
        } else if (rc != 0) {
            error "[Harness] verdict 도구 실패 rc=${rc}"
        } else {
            echo "[Harness] ${scenario}: PASS"
        }
    }
}
