// tests/jenkins/harness/Jenkinsfile_harness — main 전용 실행 Harness (2026-10-04, Astra 3차 §5 · 4차 §2·§5). 운영 수집 Job 이 아니다.
//
//   Job: clovirone-cicd/clovirone-server-gather-harness — Pipeline from SCM(*/main) · Script Path 이 파일 · Lightweight checkout ·
//        **시나리오당 빌드 1개**(stash 이름 · artifact 이름 · currentBuild.result 가 빌드 단위라 한 빌드에 여러 시나리오를 섞지 않는다).
//   하는 일: Jenkinsfile_portal(main checkout 또는 CI 가 archive 한 생성 tree)의 최상위 함수를 build_functions.py 로 **글자 그대로** 잘라
//           wrapper(장애 주입 · params 그림자 · unstable 기록)와 함께 load → fixture.py 로 현재 빌드에 맞는 입력 준비 → callback_sink.py(POST 수신, controller loopback) →
//           sePreserveGatherOutput() / seFinalizeAndCallback() 을 **실제 Jenkins step 으로** 실행 → harness_verdict.py 가 PASS/FAIL/PARTIAL.
//   운영 코드에는 장애 주입 분기가 없다. 생성 tree 의 함수도 같은 Harness 로 검증한다(FUNCTIONS_SRC=artifact).
//   산출물: harness_result.json(판정) · harness_functions.groovy(+meta: 원본 해시) · harness_calls.json · harness_control.json ·
//           preserve_state.json · fixture_state.json · sink/record.jsonl · observed/{finalize_summary,callback_body}.json
//   2026-10-04 검토 C5: interruption 시나리오 — outer_timeout · foreign_timeout · user_abort(자기 빌드 /stop) ·
//           aborted_outcome_finalize(ABORTED 빌드의 사후 finalize) · sink_hold(main Job T2 의 Callback 수신 증거용 sink 유지)
//   2026-10-05 (8차): Tier 2(BOUNDED · SE_FINALIZER_BOUNDED) · Script Approval 실측을 없앴다 — 운영 함수에 안쪽 단계 상한이 없다(R3).
//   2026-10-06 (9차): gather_stage 시나리오(gather_limit_preserve · infra_resume · infra_wait_expired · resume_impossible · gather_wait_abort)는
//           운영 함수 seGatherStage 를 짧은 시험 상수로 그대로 실행한다. 수집은 실제 scripts/run_gather.sh 가 가짜 ansible-playbook(stub_ansible.py)으로
//           하고, 실행 기반(Runner 대기 · 연결 끊김 · 작업 폴더 사라짐 · 결과 처리 노드 대기)만 wrapper 가 흉내 낸다. 이 Harness 가 잡은 executor 안에서
//           돈다 — 운영 Runner 의 executor 를 더 잡지 않는다. 운영 Job 에 시험용 파라미터 · 분기는 없다.
//   2026-10-07 (10차): 결과 처리 재진입(finalize_reentry*) · 기록 파일 일시 읽기 실패 · 첫 준비 끊김 · 접수 목록 복원 · 확정 결과 사라짐 ·
//           마지막 보존 표식 · Add-on 결정 재사용 시나리오. 장애는 시나리오의 faults 로 wrapper 가 넣고(운영 코드 무변경), Add-on 시험은
//           fixture 가 만든 file:// 시험 저장소(commit A · B)를 ADDON_REPO_URL 로 넘긴다(이 시험 빌드의 withEnv 에만 — 전역 설정 무변경).
//   2026-10-08 (CI 실행시간 개선): CI 가 이 Job 의 빌드 둘을 동시에 돌린다(두 lane — 시나리오당 빌드 1개는 그대로). 그래서 빌드마다 격리한다:
//           수신기 포트는 SINK_PORT=0 이면 OS 가 정하고(callback_sink.py --ready-file 이 실제 포트 · pid 를 알린다) controller 폴더는 <ws>@sink/<빌드 번호>다.
//           남의 수신기를 pkill 하지 않고, 자기 수신기는 finally 에서 pid 의 명령줄(이 빌드의 ready 파일 경로)을 확인한 뒤 끝낸다. 판정은 수신 기록의
//           eventUuid 가 이 빌드의 것인지 본다. MAIN_SHA 가 있으면 그 commit 을 받고(CI 도중 main 이 움직여도 같은 후보) readTrusted 3개 파일도 받은 사본에서
//           읽는다. 이 Pipeline 정의는 Job branch 끝에서 와 revision 이 남지 않으므로, 후보 뒤에 이 파일을 바꾼 commit 이 없는지 git 이력으로 확인한다.
//           부모 CI 는 빌드 변수(SE_HARNESS_SHA · _FUNCTIONS_SHA256 · _SOURCE_SHA256 · _ARCHIVE_SHA256 · _TREE_HASH)로 후보 · 생성물과 대조한다.

properties([
    // disableConcurrentBuilds 는 두지 않는다(2026-10-08) — CI 의 두 lane 이 이 Job 의 빌드 둘을 동시에 돌린다. 격리는 빌드 안에서 한다(수신기 · 폴더 · 작업 폴더)
    buildDiscarder(logRotator(numToKeepStr: '200')),
    parameters([
        string(name: 'SCENARIO', defaultValue: 'normal_success', description: 'tests/jenkins/harness/scenarios.json 의 시나리오 이름'),
        string(name: 'MAIN_SHA', defaultValue: '', description: '검증 중인 개발 main SHA X(40자) — 주면 그 commit 을 받는다(받은 commit 이 다르면 중단). 비우면 Job branch 최신(수동 실행 — 후보 고정 없음)'),
        choice(name: 'FUNCTIONS_SRC', choices: ['checkout', 'artifact'], description: 'checkout = main 의 Jenkinsfile_portal · artifact = CI 빌드가 archive 한 생성 tree(prodtree.tar.gz)'),
        string(name: 'ARTIFACT_BASE_URL', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: CI 빌드 artifact 기준 URL (…/artifact)'),
        string(name: 'EXPECTED_SHA256', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: 생성 tree Jenkinsfile_portal 의 SHA-256 (CI 가 넘긴 값, 불일치면 중단)'),
        string(name: 'EXPECTED_ARCHIVE_SHA256', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: prodtree.tar.gz 전체의 SHA-256 (CI 가 넘긴 값, 불일치면 풀지 않고 중단)'),
        string(name: 'EXPECTED_TREE_HASH', defaultValue: '', description: 'FUNCTIONS_SRC=artifact: 생성 tree 의 tree_hash(prodgen build · provenance — CI 가 넘긴 값, 불일치면 중단)'),
        string(name: 'SINK_PORT', defaultValue: '18080', description: 'callback_sink.py 포트 — controller(built-in) 의 127.0.0.1. 0 = OS 가 배정(동시 빌드 · CI 가 넘긴다), 숫자 = 고정(수동 · main E2E sink_hold)'),
        string(name: 'LOC', defaultValue: 'git', description: 'Callback body 의 loc'),
        string(name: 'DEPLOYMENT_ENV', defaultValue: 'harness', description: 'Callback body 의 deploymentEnvironmentId'),
    ]),
])

// Runner 시스템 python3 는 3.9 — Harness 도구는 venv(3.12, PyYAML)에서 돈다. venv 선택은 scripts/activate_ansible_venv.sh 한 곳.
String PY = '. "$WORKSPACE/scripts/activate_ansible_venv.sh" >/dev/null 2>&1 || true; python3'
String PRESERVE_FILES = 'gather_output.json,gather_manifest.json,gather_rc.txt,gather_checkpoint.jsonl,gather_final.jsonl,gather_finalize_report.json'
// readTrusted 가 돌려줄 정본 — Harness 가 실행하는 Jenkinsfile_portal 함수가 읽는 파일 전부. 두 모드 모두 받은 후보에서 미리 읽는다(2026-10-08)
List TRUSTED_PATHS = ['scripts/jenkins/se_finalize.groovy', 'common/vars/failure_reasons.yml', 'common/vars/supported_sections.yml']

timeout(time: 45, unit: 'MINUTES') {
    node('linux') {
        deleteDir()
        String scenario = params.SCENARIO.trim()
        Map control = [scenario: scenario, rethrown: null, sink_reachable: null, functions_source: params.FUNCTIONS_SRC]

        // ── ① 소스 — MAIN_SHA 가 주어지면 **그 commit** 을 받는다(CI 가 도는 동안 main 이 움직여도 같은 후보 — CI #31). 받은 commit 과 비교는 그대로 한다.
        //      Job SCM 의 원격 · 자격 · 확장은 그대로 쓰고 branch 자리만 후보 commit 으로 바꾼다. 비우면(수동 실행) Job branch 최신.
        String want = (params.MAIN_SHA ?: '').trim()
        if (want && !(want ==~ /[0-9a-f]{40}/)) { error "[Harness] MAIN_SHA 는 40자 commit 이어야 한다: ${want}" }
        def scmVars = want ? checkout(changelog: false, poll: false,
                                      scm: [$class: 'GitSCM', branches: [[name: want]], userRemoteConfigs: scm.userRemoteConfigs, extensions: scm.extensions])
                           : checkout(scm)
        String checkoutSha = (scmVars?.GIT_COMMIT ?: '').toString()
        if (!checkoutSha) { checkoutSha = sh(returnStdout: true, script: 'git rev-parse HEAD').trim() }
        if (want && want != checkoutSha) {
            error "[Harness] MAIN_SHA ${want} != checkout ${checkoutSha} — 검증 중인 후보와 다른 코드다"
        }
        env.SE_HARNESS_SHA = checkoutSha               // 부모 CI 가 빌드 변수로 읽어 후보와 대조한다(자식 빌드 번호 ↔ 후보 SHA)
        control.checkout_sha = checkoutSha
        control.checkout_pinned = (want != '')
        currentBuild.description = "${scenario} @${checkoutSha.take(10)} ${params.FUNCTIONS_SRC}"

        // ①' 이 Pipeline 정의(이 파일)는 Job branch 끝에서 왔고(lightweight) Jenkins 는 그 revision 을 남기지 않는다. 후보 뒤에 그 branch 에서 이 파일을
        //     바꾼 commit 이 없으면 정의는 후보의 것과 같다(force push 금지 전제). 있으면 다른 정의로 돈 것이라 멈춘다 — CI 를 다시 실행한다.
        if (want) {
            String branchName = scm.branches[0].name.replaceAll(/^\*\//, '').replaceAll(/^refs\/heads\//, '').replaceAll(/^origin\//, '')
            String defRef = "refs/remotes/origin/${branchName}"
            List defOut = sh(returnStdout: true, label: 'harness: Pipeline 정의 revision', script: """
                if ! git rev-parse -q --verify '${defRef}^{commit}' >/dev/null; then echo NO_REF; exit 0; fi
                if ! git merge-base --is-ancestor '${want}' '${defRef}'; then echo NOT_ANCESTOR; exit 0; fi
                echo "TIP \$(git rev-parse '${defRef}')"
                git log --format=%H '${want}..${defRef}' -- tests/jenkins/harness/Jenkinsfile_harness
            """).trim().split('\n').collect { it.trim() }.findAll { it }
            String head = defOut ? defOut[0] : ''
            List changed = []
            for (int i = 1; i < defOut.size(); i++) { changed << defOut[i] }
            control.definition = [ref: defRef, check: head, changed_after_candidate: changed]
            if (!head.startsWith('TIP ') || changed) {
                error "[Harness] 이 Pipeline 정의가 후보(${want.take(10)})의 것인지 확인하지 못했다 — ${defRef}: ${head ?: '-'}${changed ? ', 후보 뒤 이 파일을 바꾼 commit ' + changed : ''} (CI 를 다시 실행한다)"
            }
            echo "[Harness] Pipeline 정의 = 후보의 것 (${defRef} 끝 ${head.substring(4).take(10)}, 후보 뒤 Jenkinsfile_harness 변경 0)"
        } else {
            control.definition = [check: 'unpinned']
        }

        def scenarios = readJSON(file: 'tests/jenkins/harness/scenarios.json', returnPojo: true).scenarios
        def sc = scenarios[scenario]
        if (sc == null) { error "[Harness] unknown scenario '${scenario}' — scenarios.json 참조" }
        boolean holdOnly = (((sc.hold_seconds ?: 0) as int) > 0)
        control.expected_jenkins_result = (sc.jenkins_result ?: 'SUCCESS')

        // gather_ws = 운영 함수가 보는 WORKSPACE(수집 workspace 의 축소판): 입력 파일 + Layer A 가 쓰는 scripts/ · common/vars/.
        //   deleteDir() 이 Harness 파일을 지우지 않도록 하위 디렉터리로 분리한다. 생성 tree 모드에서는 그 tree 자체다.
        String srcFile = 'Jenkinsfile_portal'
        Map trusted = [:]
        String trustedRoot = ''
        control.load_runner_start = sh(returnStdout: true, script: 'rm -rf gather_ws prodtree_src && mkdir -p gather_ws && echo "$(cat /proc/loadavg) nproc=$(nproc)"').trim()
        if (params.FUNCTIONS_SRC == 'artifact') {
            String base = params.ARTIFACT_BASE_URL.trim().replaceAll('/+$', '')
            if (!base) { error '[Harness] FUNCTIONS_SRC=artifact 에는 ARTIFACT_BASE_URL 이 필요하다' }
            // ignoreSslErrors: lab Jenkins 의 자체 서명 인증서를 agent JVM 이 신뢰하지 않는다(Harness #40 PKIX). 내용은 아래 sha256(CI 가 넘긴 값)으로 대조한다.
            httpRequest(url: "${base}/prodtree.tar.gz", authentication: 'se-jenkins-lint', ignoreSslErrors: true, validResponseCodes: '200', outputFile: 'prodtree.tar.gz')
            // 생성물 전체(압축 파일)가 이 CI 빌드가 만든 그것인가 — 풀기 전에 대조한다(2026-10-08)
            String gotArchive = sh(returnStdout: true, script: "sha256sum prodtree.tar.gz | cut -d' ' -f1").trim()
            if (params.EXPECTED_ARCHIVE_SHA256?.trim() && gotArchive != params.EXPECTED_ARCHIVE_SHA256.trim()) {
                error "[Harness] 생성물 압축 파일 해시 불일치 got=${gotArchive} expected=${params.EXPECTED_ARCHIVE_SHA256}"
            }
            control.archive_sha256 = gotArchive
            env.SE_HARNESS_ARCHIVE_SHA256 = gotArchive
            sh 'mkdir -p prodtree_src && tar -xzf prodtree.tar.gz -C prodtree_src && cp -a prodtree_src/. gather_ws/'
            srcFile = 'prodtree_src/Jenkinsfile_portal'
            String got = sh(returnStdout: true, script: "sha256sum ${srcFile} | cut -d' ' -f1").trim()
            if (params.EXPECTED_SHA256?.trim() && got != params.EXPECTED_SHA256.trim()) {
                error "[Harness] 생성 tree 함수 원본 해시 불일치 got=${got} expected=${params.EXPECTED_SHA256}"
            }
            control.artifact_base = base
            control.source_sha256 = got
            if (fileExists('prodtree_src/.production-provenance.json')) {
                control.provenance = readJSON(file: 'prodtree_src/.production-provenance.json', returnPojo: true)
            }
            String treeHash = (control.provenance?.tree_hash ?: '').toString()
            if (params.EXPECTED_TREE_HASH?.trim() && treeHash != params.EXPECTED_TREE_HASH.trim()) {
                error "[Harness] 생성 tree 의 tree_hash 불일치 got=${treeHash ?: '-'} expected=${params.EXPECTED_TREE_HASH}"
            }
            env.SE_HARNESS_TREE_HASH = treeHash
            trustedRoot = 'prodtree_src/'
        } else {
            // Layer A 가 읽는 정본: common/vars/*.yml + common/tasks/normalize/{init_fragments,build_meta,build_correlation}.yml (Harness #6: normalize 누락 → exit 3)
            // 8차 · 9차: 보존이 부르는 오래된 작업 폴더 정리(workspace_cleanup.py)와 gather_stage 가 실행하는 run_gather.sh · env_guard.sh · gather_state.py 도
            //   같은 위치에 둔다(생성 tree 모드와 같은 배치). gather_stage 의 시도는 이 사본을 저장소 대신 받는다(wrapper checkout)
            sh 'mkdir -p gather_ws/scripts gather_ws/common/tasks && cp -a scripts/finalize_gather_output.py scripts/activate_ansible_venv.sh scripts/workspace_cleanup.py scripts/addon_checkout.sh scripts/addon_askpass.sh scripts/run_gather.sh scripts/env_guard.sh scripts/gather_state.py gather_ws/scripts/ && cp -a common/vars gather_ws/common/ && cp -a common/tasks/normalize gather_ws/common/tasks/'
        }
        // finalizer 의 readTrusted 가 돌려줄 내용 — 받은 후보의 파일(checkout 모드 = MAIN_SHA 로 받은 이 사본, 생성 tree 모드 = 그 tree). 실제 readTrusted 는
        //   Job SCM(branch 최신)을 읽어 후보와 다른 revision 이 섞일 수 있다 — wrapper 는 여기 없는 경로를 실패시킨다(2026-10-08)
        for (String path in TRUSTED_PATHS) {
            if (fileExists("${trustedRoot}${path}")) { trusted[path] = readFile(file: "${trustedRoot}${path}", encoding: 'UTF-8') }
        }

        // ── ② wrapper 를 붙인 함수 스크립트 (원본 글자 불변 — 해시 기록)
        sh "${PY} tests/jenkins/harness/build_functions.py --source ${srcFile} --scenario ${scenario} --out harness_functions.groovy --meta harness_functions_meta.json"
        def meta = readJSON(file: 'harness_functions_meta.json', returnPojo: true)
        control.functions_sha256 = meta.functions_sha256
        control.source_sha256 = control.source_sha256 ?: meta.source_sha256
        env.SE_HARNESS_FUNCTIONS_SHA256 = (meta.functions_sha256 ?: '').toString()
        env.SE_HARNESS_SOURCE_SHA256 = (control.source_sha256 ?: '').toString()
        echo "[Harness] scenario=${scenario} functions_sha256=${meta.functions_sha256} source_sha256=${meta.source_sha256} defs=${meta.defs}"

        // ── ③ Callback sink — **controller 의 loopback** 에서 띄운다. finalizer 의 httpRequest 는 node('built-in') 안에서 실행되므로 요청은 controller 에서
        //      나간다(http_request 1.25 는 node 컨텍스트의 노드에서 실행). Harness #6 에서 agent 에 띄운 sink 는 agent 의 healthz 만 통과하고
        //      controller 발 POST 는 NoRouteToHost(Runner 인바운드 거부)였다. 도달성 확인도 같은 node('built-in') 안에서 한다.
        //      2026-10-08: 같은 Job 의 빌드가 동시에 돌므로 빌드마다 따로다 — 포트는 SINK_PORT=0 이면 OS 가 정하고, 폴더는 빌드 번호로 나눈다. 남의 프로세스는
        //      끝내지 않는다: 고정 포트가 이미 쓰이는 중이면 이 빌드의 수신기가 뜨지 않고(PARTIAL) Callback 은 닫힌 포트로 간다(남의 수신기로 보내지 않는다).
        String sinkMode = (params.SINK_PORT ?: '18080').trim()
        if (!(sinkMode ==~ /\d{1,5}/)) { error "[Harness] SINK_PORT 는 숫자여야 한다(0 = OS 배정): ${sinkMode}" }
        String sinkPort = ''
        String sinkPid = ''
        String sinkUrl = 'http://127.0.0.1:9'
        String sinkWs = ''
        Map sinkCfg = (sc.sink ?: [status: '200'])
        String sinkSrc = readFile(file: 'tests/jenkins/harness/callback_sink.py', encoding: 'UTF-8')
        sh 'mkdir -p sink && rm -f sink/record.jsonl sink/sink.log sink/pid'
        String eventUuid = "harness-${env.BUILD_TAG}"
        def lib = null
        Map preserve = [:]
        Map hs = [:]
        String sinkRecord = ''
        String sinkLog = ''
        control.rethrown = false
        try {
        node('built-in') {
            // 이 빌드 전용 폴더 — finalizer 가 쓰는 controller workspace 의 **형제 디렉터리**(…@sink) 아래. finalizer 의 deleteDir() 가 열린 파일을 지우려다
            //   NFS silly-rename(.nfs* "Device or resource busy") 으로 실패했다(Harness #17). 빌드 번호로 나누고 ws() 잠금 대신 절대 경로로 다시 찾아온다
            sinkWs = "${pwd()}@sink/${env.BUILD_NUMBER}"
            writeFile(file: "${sinkWs}/callback_sink.py", text: sinkSrc, encoding: 'UTF-8')
            sh """D='${sinkWs}'
                  cd "\$D" && rm -f record.jsonl sink.log pid ready.json
                  echo "\$(cat /proc/loadavg) nproc=\$(nproc)" > load_start.txt
                  PYBIN="\$(command -v python3 || command -v /usr/libexec/platform-python || true)"
                  echo "[Harness] controller python=\${PYBIN:-absent} \$( [ -n "\$PYBIN" ] && "\$PYBIN" --version 2>&1 )"
                  if [ -n "\$PYBIN" ]; then
                      JENKINS_NODE_COOKIE=dontKillMe nohup "\$PYBIN" "\$D/callback_sink.py" --bind 127.0.0.1 --port ${sinkMode} --record "\$D/record.jsonl" \\
                          --status '${sinkCfg.status ?: '200'}' --mode '${sinkCfg.mode ?: 'respond'}' --delay '${sinkCfg.delay ?: 0}' --pidfile "\$D/pid" \\
                          --ready-file "\$D/ready.json" --max-seconds 2400 > "\$D/sink.log" 2>&1 &
                      P=\$!
                      # 고정 대기 대신 준비 파일(bind 뒤 실제 포트 · pid)을 기다린다 — 0.1초 간격 최대 15초, 수신기가 먼저 끝나면(포트 사용 중 등) 멈춘다
                      i=0
                      while [ \$i -lt 150 ] && [ ! -s "\$D/ready.json" ] && kill -0 \$P 2>/dev/null; do sleep 0.1; i=\$((i+1)); done
                      if [ -s "\$D/ready.json" ]; then echo "[Harness] sink ready: \$(cat "\$D/ready.json")"; else echo "[Harness] sink 가 준비되지 않았다 — 최근 로그:"; tail -n 5 "\$D/sink.log" || true; fi
                  fi"""
            if (fileExists("${sinkWs}/load_start.txt")) { control.load_controller_start = readFile(file: "${sinkWs}/load_start.txt", encoding: 'UTF-8').trim() }
            if (fileExists("${sinkWs}/ready.json")) {
                Map rd = readJSON(file: "${sinkWs}/ready.json", returnPojo: true)
                sinkPort = rd.port.toString()
                sinkPid = rd.pid.toString()
                sinkUrl = "http://127.0.0.1:${sinkPort}"
                try {
                    httpRequest(url: "${sinkUrl}/healthz", validResponseCodes: '200', timeout: 10)
                    control.sink_reachable = true
                    echo "[Harness] sink ${sinkUrl} — controller(built-in) 에서 도달 (GET /healthz 는 도달성 확인일 뿐 Callback 증거가 아니다)"
                } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                    throw fie
                } catch (Exception e) {
                    control.sink_reachable = false
                    echo "[Harness] controller 에서 sink(${sinkUrl}) 에 닿지 못함: ${e.message} — Callback 검증은 PARTIAL"
                }
            } else {
                control.sink_reachable = false
                echo "[Harness] sink 가 뜨지 않았다(SINK_PORT=${sinkMode} — 고정 포트면 다른 수신기가 쓰는 중일 수 있다, 끝내지 않는다) — Callback 은 닫힌 포트로, 검증은 PARTIAL"
            }
        }
        control.sink_workspace = sinkWs
        control.sink_mode = sinkMode
        control.sink_port = sinkPort
        currentBuild.description = "${currentBuild.description} sink=127.0.0.1:${sinkPort ?: '-'}"

        // ── ③'' sink_hold — 판정 없이 sink 만 hold_seconds 동안 유지한다 (main Job 이 callbackUrl=http://127.0.0.1:<실제 포트> 로 보낸 POST 가 record 에 남는다)
        if (holdOnly) {
            echo "[Harness] sink_hold: ${sinkUrl} 를 ${sc.hold_seconds}s 유지 — main Job T2 트리거는 이 사이에 한다"
            sleep(time: (sc.hold_seconds as int), unit: 'SECONDS')
        }

        // ── ④ fixture — corpus case 입력 + **현재 빌드**의 manifest
        if (!holdOnly) {
        sh """${PY} tests/jenkins/harness/fixture.py --scenarios tests/jenkins/harness/scenarios.json --scenario ${scenario} \\
                --corpus tests/fixtures/finalize_corpus --workspace "\$PWD/gather_ws" --job '${env.JOB_NAME}' --number '${env.BUILD_NUMBER}' --url '${env.BUILD_URL}' \\
                --loc '${params.LOC}' --deployment-env '${params.DEPLOYMENT_ENV}' --event-uuid '${eventUuid}' --callback-url '${sinkUrl}' --out fixture_state.json"""
        def fx = readJSON(file: 'fixture_state.json', returnPojo: true)
        env.SE_MANIFEST_JSON = fx.manifest_json
        env.SE_BUILD_NONCE = (fx.build_nonce ?: '').toString()      // FL-F06: 입력 확인이 만드는 빌드 표식과 같은 자리(fixture 가 manifest 에도 넣었다)
        env.SE_GATHER_OUTCOME = fx.outcome
        env.SE_BUILD_START_EPOCH = "${(long) (System.currentTimeMillis() / 1000L)}"
        for (String k in ['SE_PRESERVE_LAYER_A', 'SE_PRESERVE_ARCHIVED', 'SE_PRESERVE_STASHED', 'SE_PRESERVE_MANIFEST', 'SE_PRESERVE_HASRESULT', 'SE_FINAL_STASHED']) { env."${k}" = '' }

        // ── ⑤ load + init (바깥 스크립트 = 실제 step)
        boolean expectInterruption = (sc.expect_interruption ?: false) || (sc.outer_timeout_seconds ?: 0) > 0
        lib = load 'harness_functions.groovy'
        Map gatherCfg = null
        if (fx.gather_stage) {
            gatherCfg = [attempts: (fx.gather_stage.attempts ?: []), finalize_delay: (fx.gather_stage.finalize_delay ?: 0),
                         deregistered: false, src: "${pwd()}/gather_ws".toString(), sha: checkoutSha,
                         node_steps: fx.gather_stage.node_steps, addon: fx.gather_stage.addon]
        }
        lib.seHarnessInit(this, [params  : [loc: params.LOC, deploymentEnvironmentId: params.DEPLOYMENT_ENV, eventUuid: eventUuid,
                                            callbackUrl: sinkUrl, target_type: fx.channel, verbosity: '0'],
                                 trusted : trusted, slowSeconds: (sc.slow_seconds ?: 45), gather: gatherCfg,
                                 faults  : (sc.faults ?: []), slow: (sc.slow ?: [:]), finalizeDelays: sc.finalize_delays])
        if (lib.params.callbackUrl != sinkUrl) { error '[Harness] params 그림자가 동작하지 않는다 — getParams() 해석 확인' }

        // ── ⑤' gather_stage (9차) — 운영 함수 seGatherStage 를 짧은 시험 상수로 그대로 실행한다. 시도마다 실제 scripts/run_gather.sh 가
        //      가짜 ansible-playbook(stub_ansible.py, 계획대로 결과를 쓰고 · 끊기고 · 남는다)을 남은 대상만 넘겨 실행하고, 마지막 시도가 보존한다.
        //      Runner 대기 · 연결 끊김 · 작업 폴더 사라짐 · 결과 처리 노드 대기만 wrapper 가 흉내 낸다(이 executor 안에서 — 추가 executor 없음).
        if (fx.gather_stage) {
            Map gsx = fx.gather_stage
            Map C = lib.seConstants() + (gsx.constants ?: [:])
            control.gather_constants = gsx.constants
            env.SE_AGENT_LABEL = 'harness-runner-label'
            env.SE_LOCATION = params.LOC
            env.SE_INFRA_JSON = ''
            String stopUrl = "${env.BUILD_URL}stop"
            try {
                withEnv(["ADDON_REPO_URL=${gsx.addon?.url ?: ''}", "ADDON_REPO_REF=", "SE_ANSIBLE_VENV=${gsx.venv}", "SE_HARNESS_STUB_DIR=${gsx.stub_dir}"]) {
                    if (sc.gather_abort_after) {
                        parallel(
                            gather: { lib.seGatherStage(C) },
                            stopper: {
                                sleep(time: (sc.gather_abort_after as int), unit: 'SECONDS')
                                echo "[Harness] gather_wait_abort: POST ${stopUrl} (실행 기반을 기다리는 중 자기 빌드 중단 — 사용자 Abort 와 같은 경로)"
                                httpRequest(url: stopUrl, httpMode: 'POST', authentication: 'se-jenkins-lint', ignoreSslErrors: true, validResponseCodes: '100:599', timeout: 30)
                            },
                            failFast: false
                        )
                    } else {
                        lib.seGatherStage(C)
                    }
                }
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                control.rethrown = true
                control.rethrown_in = 'gather'         // 판정기는 수집 단계의 재전파를 전송 실패로 보지 않는다(결과 확인이 뒤에서 한 번 보낸다)
                control.interruption_class = fie.getClass().name
                echo "[Harness] 수집 단계 밖으로 interruption 이 전파됐다: ${fie.getClass().name}"
                if (!expectInterruption) { throw fie }
                currentBuild.result = 'ABORTED'        // 선언형 파이프라인이 post 전에 남기는 결과와 같게
            }
            hs = lib.seHarnessState()
            sh "cp '${gsx.stub_dir}/received.jsonl' gather_received.jsonl 2>/dev/null || : > gather_received.jsonl"
            control.gather = [outcome: env.SE_GATHER_OUTCOME, limit_reason: env.SE_GATHER_LIMIT_REASON, ws_path: hs.ws_path,
                              node_calls: hs.node_calls, gather_calls: hs.gather_calls, ips: gsx.ips, addon: gsx.addon]
            preserve = [layerA: env.SE_PRESERVE_LAYER_A, archived: env.SE_PRESERVE_ARCHIVED == 'true', stashed: env.SE_PRESERVE_STASHED == 'true',
                        manifestOk: env.SE_PRESERVE_MANIFEST == 'true', hasResult: env.SE_PRESERVE_HASRESULT == 'true']
            preserve.deleted = hs.ws_path ? (sh(returnStatus: true, script: "test -e '${hs.ws_path}/gather_manifest.json'") != 0) : null
            echo "[Harness] gather_stage outcome=${env.SE_GATHER_OUTCOME} limit_reason=${env.SE_GATHER_LIMIT_REASON} ws=${hs.ws_path} node_calls=${hs.node_calls} gather_calls=${hs.gather_calls}"
        }

        // ── ⑥ 보존 — Gather post 가 하는 일을 gather_ws 에서 실제 step 으로 (Layer A · archive · stash). 주입은 wrapper 가 한다.
        //      gather_stage 는 운영 함수(마지막 시도)가 이미 보존했다.
        if (!fx.gather_stage) {
        dir('gather_ws') {
            withEnv(["WORKSPACE=${pwd()}"]) {
                if (fx.run_preserve) {
                    lib.sePreserveGatherOutput()
                    preserve = [layerA: env.SE_PRESERVE_LAYER_A, archived: env.SE_PRESERVE_ARCHIVED == 'true', stashed: env.SE_PRESERVE_STASHED == 'true',
                                manifestOk: env.SE_PRESERVE_MANIFEST == 'true', hasResult: env.SE_PRESERVE_HASRESULT == 'true']
                } else if (sc.layer_a_direct) {
                    // Layer A 를 직접 돌린 뒤 변형(예: report 손상)을 적용하고 Harness 가 stash — "손상된 Layer A 결과" 입력
                    sh "${PY} scripts/finalize_gather_output.py --workspace \"\$PWD\" --repo-root \"\$PWD\" --outcome ${fx.outcome} || true"
                    sh """${PY} ../tests/jenkins/harness/fixture.py --scenarios ../tests/jenkins/harness/scenarios.json --scenario ${scenario} --corpus ../tests/fixtures/finalize_corpus \\
                            --workspace "\$PWD" --job x --number 0 --url x --callback-url x --out ../fixture_post.json --post-layer-a"""
                    stash(name: 'gather-output', includes: PRESERVE_FILES, allowEmpty: true)
                    env.SE_FINAL_STASHED = 'true'      // C1: Harness 가 직접 넘긴 것이 마지막 보존의 전달이다(운영 sePreserveGatherOutput 과 같은 표식)
                } else {
                    stash(name: 'gather-output', includes: PRESERVE_FILES, allowEmpty: true)
                    env.SE_FINAL_STASHED = 'true'
                }
            }
        }
        preserve.deleted = !fileExists('gather_ws/gather_manifest.json')
        }   // !fx.gather_stage
        writeFile(file: 'preserve_state.json', text: groovy.json.JsonOutput.toJson(preserve), encoding: 'UTF-8')
        echo "[Harness] preserve=${preserve}"

        // ── ⑦ finalizer — 실제 timeout(720){ node('built-in') {…} }. outer_timeout 은 Harness 가 짧은 외곽 timeout 으로 감싼다.
        //    set_result(aborted_outcome_finalize): ABORTED 빌드의 사후 finalize — seCallback 의 aborted 분기(1회 시도)를 실제로 탄다.
        //    self_abort_after(user_abort): 느린 unstash 중에 Harness 가 자기 빌드에 POST /stop — 사용자 중단과 같은 interruption 이 finalizer 로 들어간다.
        //    expect_interruption 시나리오만 interruption 을 기록 뒤 삼킨다(우리가 만든 것) — 그 외는 진짜 중단이라 그대로 전파한다.
        //    gather_stage 시나리오는 이 호출이 pipeline post{always} 의 결과 확인 및 전송 자리다(수집 단계가 어떻게 끝났든 한 번).
        if (sc.set_result) {
            currentBuild.result = sc.set_result.toString()
            echo "[Harness] currentBuild.result=${currentBuild.result} (시나리오 ${scenario})"
        }
        // 10차 R1: 결과 처리 노드 대기 한도를 짧게 — 이 빌드의 실행 기반 대기 기록을 시험 한도로 시작한다(운영 72시간 대신)
        if (sc.infra_budget_sec && !fx.gather_stage) {
            env.SE_INFRA_JSON = groovy.json.JsonOutput.toJson([budget_sec: (sc.infra_budget_sec as long), used_sec: 0L, expired: false, episodes: []])
        }
        try {
            if (sc.self_abort_after) {
                int after = sc.self_abort_after as int
                String stopUrl = "${env.BUILD_URL}stop"
                parallel(
                    finalize: { control.finalize_result = lib.seFinalizeAndCallback() },
                    stopper: {
                        sleep(time: after, unit: 'SECONDS')
                        echo "[Harness] user_abort: POST ${stopUrl} (자기 빌드 중단 — 사용자 Abort 와 같은 경로)"
                        httpRequest(url: stopUrl, httpMode: 'POST', authentication: 'se-jenkins-lint', ignoreSslErrors: true, validResponseCodes: '100:599', timeout: 30)
                    },
                    failFast: false
                )
            } else if (sc.outer_timeout_seconds) {
                timeout(time: (sc.outer_timeout_seconds as int), unit: 'SECONDS') { control.finalize_result = lib.seFinalizeAndCallback() }
            } else {
                control.finalize_result = lib.seFinalizeAndCallback()
            }
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            control.rethrown = true
            control.rethrown_in = 'finalize'
            control.interruption_class = fie.getClass().name
            echo "[Harness] interruption 이 finalizer 밖으로 전파됐다 (기대: 삼키지 않는다): ${fie.getClass().name}"
            if (!expectInterruption) { throw fie }   // 우리가 만든 interruption 이 아니면 진짜 중단이다 — 그대로 전파
        }
        if (sc.self_abort_after && control.rethrown) {
            currentBuild.result = 'ABORTED'          // 사용자 중단이 만든 결과를 Harness 가 되돌리지 않는다 (시나리오 기대 jenkins_result=ABORTED)
        }
        }   // !holdOnly

        // ── ⑧ 관측 수집 — finalizer 가 archive 한 요약·body 를 되가져오고, 호출 기록·제어 정보를 남긴다
        // List 인자는 JsonOutput.toJson(Object) 로 해석돼 sandbox 가 거부한다(Harness #6) — writeJSON step 은 List/Map 모두 받는다
        writeJSON(file: 'harness_calls.json', json: (lib != null ? lib.seHarnessCalls() : []))
        control.load_runner_end = sh(returnStdout: true, script: 'mkdir -p observed && echo "$(cat /proc/loadavg) nproc=$(nproc)"').trim()
        try {
            unarchive mapping: ['finalize_summary.json': 'observed/finalize_summary.json', 'callback_body.json': 'observed/callback_body.json']
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            throw fie
        } catch (Exception e) {
            echo "[Harness] 요약/body unarchive 실패(finalizer 가 archive 전에 끝났을 수 있다): ${e.message}"
        }
        if (!fileExists('preserve_state.json')) { writeFile(file: 'preserve_state.json', text: groovy.json.JsonOutput.toJson(preserve), encoding: 'UTF-8') }
        } finally {
            // 수신기 종료 + 수신 기록 회수 — **이 빌드의 수신기만**: ready 파일의 pid 가 이 빌드의 ready 경로를 명령줄에 가진 프로세스일 때 TERM 을 보내고
            //   종료를 기다린다(고정 sleep 대신 최대 10초). 남으면 그 pid 만 KILL. 중단 · 오류로 끝나도 수신기를 남기지 않는다(2026-10-08)
            if (sinkWs) {
                node('built-in') {
                    sh """D='${sinkWs}'; PID='${sinkPid}'
                          echo "\$(cat /proc/loadavg) nproc=\$(nproc)" > "\$D/load_stop.txt" 2>/dev/null || true
                          if [ -n "\$PID" ] && [ -r "/proc/\$PID/cmdline" ] && tr '\\0' ' ' < "/proc/\$PID/cmdline" | grep -qF -- "--ready-file \$D/ready.json"; then
                              kill -TERM "\$PID" 2>/dev/null || true
                              i=0
                              while [ \$i -lt 100 ] && kill -0 "\$PID" 2>/dev/null; do sleep 0.1; i=\$((i+1)); done
                              if kill -0 "\$PID" 2>/dev/null; then kill -KILL "\$PID" 2>/dev/null || true; echo "[Harness] sink pid \$PID 를 KILL 로 정리"; else echo "[Harness] sink pid \$PID 종료 확인"; fi
                          elif [ -n "\$PID" ]; then
                              echo "[Harness] sink pid \$PID 는 이 빌드의 수신기가 아니다(이미 끝났거나 다른 프로세스) — 건드리지 않는다"
                          fi"""
                    if (fileExists("${sinkWs}/record.jsonl")) { sinkRecord = readFile(file: "${sinkWs}/record.jsonl", encoding: 'UTF-8') }
                    if (fileExists("${sinkWs}/sink.log")) { sinkLog = readFile(file: "${sinkWs}/sink.log", encoding: 'UTF-8') }
                    if (fileExists("${sinkWs}/load_stop.txt")) { control.load_controller_stop = readFile(file: "${sinkWs}/load_stop.txt", encoding: 'UTF-8').trim() }
                    sh "rm -rf '${sinkWs}' || true"
                }
            }
        }
        control.build_result = currentBuild.result
        writeFile(file: 'harness_control.json', text: groovy.json.JsonOutput.toJson(control), encoding: 'UTF-8')
        // 수신 기록을 controller 에서 agent 로 가져온다(verdict · archive 는 agent 의 sink/ 를 읽는다)
        writeFile(file: 'sink/record.jsonl', text: sinkRecord, encoding: 'UTF-8')
        writeFile(file: 'sink/sink.log', text: sinkLog, encoding: 'UTF-8')

        // ── ⑨ 판정 — 기대 불일치는 UNSTABLE(FAIL), 관측 부족은 UNSTABLE(PARTIAL), 도구 실패는 FAILURE
        int rc = sh(returnStatus: true, script: """${PY} tests/jenkins/harness/harness_verdict.py --scenarios tests/jenkins/harness/scenarios.json --scenario ${scenario} \\
                --summary observed/finalize_summary.json --body observed/callback_body.json --calls harness_calls.json --sink sink/record.jsonl \\
                --preserve preserve_state.json --control harness_control.json --meta harness_functions_meta.json --received gather_received.jsonl \\
                --fixture fixture_state.json --event-uuid '${eventUuid}' --out harness_result.json""")
        archiveArtifacts(artifacts: 'harness_result.json,harness_functions.groovy,harness_functions_meta.json,harness_calls.json,harness_control.json,preserve_state.json,fixture_state.json,fixture_post.json,gather_received.jsonl,sink/record.jsonl,sink/sink.log,observed/*',
                         allowEmptyArchive: true, fingerprint: false)
        // gather_stage 가 이 Runner 에 만든 시도 작업 폴더(<agent root>/<Job>-<번호>) — 보존을 마친 시도는 운영 함수가 지웠다. 남은 것(대기 한도 초과 ·
        //   재개 불가 · 취소)은 이 빌드의 것만 확인하고 지운다(운영 Runner 에 시험 폴더를 남기지 않는다)
        if (hs.ws_path && hs.ws_path.toString().endsWith("/${env.JOB_BASE_NAME}-${env.BUILD_NUMBER}")) {
            sh "rm -rf '${hs.ws_path}' '${hs.ws_path}@tmp'"
        }
        // 판정을 빌드 변수로 남긴다 — CI 가 Jenkins 결과만 보면 ABORTED 로 끝나는 시나리오의 판정 실패를 놓친다(2026-10-06 CI #27 · #29)
        env.SE_HARNESS_VERDICT = (rc == 0) ? 'PASS' : ((rc == 1) ? 'FAIL' : ((rc == 2) ? 'PARTIAL' : 'ERROR'))
        if (rc == 1) {
            unstable("[Harness] ${scenario}: FAIL — 기대와 다르다 (harness_result.json)")
        } else if (rc == 2) {
            unstable("[Harness] ${scenario}: PARTIAL — 관측 부족 (harness_result.json)")
        } else if (rc != 0) {
            error "[Harness] verdict 도구 실패 rc=${rc}"
        } else {
            echo "[Harness] ${scenario}: PASS"
        }
    }
}
