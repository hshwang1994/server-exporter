// 대기 구간이 끝났을 때의 첫 줄과 상세 줄(대상 · 사유)
@NonCPS
String seWaitDoneText(String reason, String target, String result) {
    String what = seWaitSubject(reason, target)
    String head
    if (result == 'acquired') {
        head = what ? "기다리던 ${what}를 확보했습니다.".toString() : '대기를 마쳤습니다.'
    } else if (result == 'expired') {
        head = '기다릴 수 있는 시간을 다 썼습니다.'
    } else if (result == 'interrupted') {
        head = '빌드가 중단돼 기다리기를 멈췄습니다.'
    } else if (result == 'paused') {
        head = '쉬는 시간을 마쳤습니다. 다시 시도합니다.'
    } else {
        head = "대기를 마쳤습니다(${result}).".toString()
    }
    List rows = []
    if (what && result != 'acquired') { rows << "기다린 것: ${what}".toString() }
    if (what) { rows << "대상: ${target}".toString() }
    if (!what && result != 'paused') { rows << "사유: ${sePauseReasonText(reason)}".toString() }
    return head + (rows ? ('\n  ' + rows.join('\n  ')) : '')
}

