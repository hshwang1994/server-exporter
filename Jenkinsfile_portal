    return (['os': 'OS', 'esxi': 'ESXi', 'redfish': 'Redfish'][t] ?: (t ?: '-')).toString()
}

@NonCPS
String seCallbackStartDetail(boolean first, String endpoint, boolean aborted, int done, int maxAttempts, long waitSec, long portalWait) {
    List rows = []
    if (first) {
        rows << "주소: ${endpoint}".toString()
        if (aborted) { rows << '취소된 빌드라 한 번만 보냅니다.' }
        if (done > 0) { rows << "앞선 결과 처리에서 ${done}번 시도했습니다. 남은 시도: ${Math.max(0, maxAttempts - done)}번".toString() }
    }
    if (waitSec < portalWait) { rows << "응답 대기: 최대 ${seDuration(waitSec)}".toString() }
    return rows ? ('\n  ' + rows.join('\n  ')) : ''
}

@NonCPS
String seLastTryText(List tries) {
    Map last = (tries && (tries[tries.size() - 1] instanceof Map)) ? (Map) tries[tries.size() - 1] : [:]
    if (last.outcome == 'interrupted') { return '마지막 시도: 응답을 받기 전에 중단됨' }
    if (last.http_code != null) {
        return ("${last.http_code}" == '408') ? '마지막 전송 도구 상태: 408' : "마지막 응답: HTTP ${last.http_code}".toString()
    }
    return last.error ? "마지막 오류: ${last.error}".toString() : '마지막 시도: 응답 없음'
}

@NonCPS
String seWaitSubject(String reason, String target) {
    String r = (reason ?: '').toString()
    if (target == '-') { return null }
    if (r.startsWith('결과 처리 노드')) { return '결과를 처리할 Jenkins 노드' }
    if (r.contains('복구 대기')) { return '수집을 이어서 실행할 Runner' }
    return '수집을 실행할 Runner'
}

@NonCPS
String sePauseReasonText(String why) {
    Map t = ['작업 폴더가 아직 사용 중': '작업 폴더를 아직 다른 실행이 쓰고 있습니다.',
             '진척 없이 Runner 측 장애가 반복돼 다시 시도하기 전': 'Runner 쪽 장애가 진척 없이 반복됐습니다.',
             '결과 처리 노드 장애가 진척 없이 반복돼 다시 시도하기 전': '결과 처리 노드의 장애가 진척 없이 반복됐습니다.']
    return (t[why] ?: (why ?: '-')).toString()
}

@NonCPS
String seWaitDoneText(String reason, String target, String result) {
    String what = seWaitSubject(reason, target)
    String head
    if (result == 'acquired') {
        head = what ? "기다리던 ${what}를 확보했습니다.".toString() : '대기를 마쳤습니다.'
    } else if (result == 'expired') {
        head = '기다릴 수 있는 시간을 다 썼습니다.'
    } else if (result == 'interrupted') {
        head = '빌드가 중단돼 기다리기를 멈췄습니다.'
    } else if (result == 'paused') {
        head = '쉬는 시간을 마쳤습니다. 다시 시도합니다.'
    } else {
        head = "대기를 마쳤습니다(${result}).".toString()
    }
    List rows = []
    if (what && result != 'acquired') { rows << "기다린 것: ${what}".toString() }
    if (what) { rows << "대상: ${target}".toString() }
    if (!what && result != 'paused') { rows << "사유: ${sePauseReasonText(reason)}".toString() }
    return head + (rows ? ('\n  ' + rows.join('\n  ')) : '')
}

@NonCPS
String seFinStepText(String mark) {
    Map t = ['recover': '결과 회수', 'assemble': '결과 조립', 'send': 'Portal 전송', 'summary': '실행 요약 작성', 'archive': '결과 파일 보관', 'done': '마무리']
    return (t[mark] ?: (mark ?: '-')).toString()
}

@NonCPS
String sePreserveText(boolean archived, boolean stashed, boolean manifestOk, boolean hasResult) {
    List rows = []
    String head
    if (archived && stashed) {
        head = '결과를 빌드에 저장하고 다음 단계로 전달했습니다.'
    } else if (stashed) {
        head = '결과 파일을 빌드 기록에 저장하지 못했습니다.'
        rows << '다음 단계에는 결과를 전달했습니다.'
        rows << '일부 원본 파일은 빌드 기록에서 확인할 수 없습니다.'
    } else if (archived) {
        head = '결과를 빌드에 저장했지만 다음 단계로 전달하지 못했습니다.'
        rows << '결과 확인 단계는 빌드에 저장된 파일에서 결과를 찾습니다.'
    } else {
        head = '결과를 빌드에 저장하지도 다음 단계로 전달하지도 못했습니다.'
        rows << '작업 폴더를 남기고, 결과 확인 단계는 접수 목록으로 실패 결과를 만듭니다.'
    }
    if (!manifestOk) { rows << '접수 목록: 없거나 다른 빌드의 것입니다.' }
    if (!hasResult) { rows << '결과 파일: 없습니다.' }
    return head + (rows ? ('\n  ' + rows.join('\n  ')) : '')
}

@NonCPS
String seAfterSendWarnText(List warnings, int filled, int checkpoint, String outcome) {
    if (warnings.contains('count_mismatch')) { return '보낼 결과가 없는 대상이 있습니다' }
    if (filled > 0 || checkpoint > 0) { return '수집을 마치지 못한 대상이 있습니다' }
    if (outcome != 'completed') { return "수집이 정상적으로 끝나지 않았습니다(${seOutcomeText(outcome)})".toString() }
    if (warnings.contains('layer_b_unavailable')) { return '결과 복구 모듈을 쓰지 못했습니다' }
    if (warnings.contains('body_not_saved')) { return '전송 본문을 파일로 저장하지 못했습니다' }
    return '확인할 내용이 있습니다'
}

@NonCPS
String seUnfinishedCause(String outcome, boolean started) {
    Map t = ['aborted': '사용자 취소로', 'timeout': '수집 실행 한계에 도달해', 'timeout_killed': '수집 실행 한계에 도달해',
             'infra_wait_expired': 'Runner가 대기 한도 안에 돌아오지 않아', 'resume_impossible': '같은 Runner에서 이어서 수집할 수 없어',
             'attempt_limit': '시도 하나의 실행 한계에 도달해', 'process_lost': '수집 프로세스가 끝 기록 없이 끝나',
             'failed_run': 'ansible-playbook이 비정상 종료해', 'prep_failed': '실행 준비에 실패해', 'config_error': '등록된 Runner가 없어',
             'completed': '수집 결과가 없어']
    if (t[outcome]) { return t[outcome].toString() }
