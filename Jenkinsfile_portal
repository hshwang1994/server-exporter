@NonCPS
Map seOutcomeFromState(String state, Object rc) {
    if (state == 'completed') { return [outcome: 'completed', limit_reason: ''] }
    if (state == 'gather_limit') { return [outcome: ("${rc}" == '137' ? 'timeout_killed' : 'timeout'), limit_reason: 'gather_limit'] }
    if (state in ['prep_failed', 'process_lost', 'aborted', 'failed_run', 'resume_impossible', 'attempt_limit']) {
        return [outcome: state, limit_reason: '']
    }
    return [outcome: 'interrupted_unknown', limit_reason: '']
}

// 결과 형태 최소 계약 (2026-10-05 F02) — Python Layer A(scripts/finalize_gather_output.py) shape_gate 와 같은 통과·거부 판정.
//   통과하면 null, 아니면 사유. 값 종류를 먼저 본다 — 목록·객체 값이 비교에 먼저 쓰여 예외가 나거나 엉뚱하게 통과하지 않게.
//   이 본문은 Jenkinsfile_portal 과 scripts/jenkins/se_finalize.groovy 에 글자까지 같게 둘 있다: 라이브러리를 못 읽은 경로에서도
//   전송 직전 검문이 같은 규칙으로 돌아야 하기 때문이다. tests/unit/test_envelope_gate_parity.py 가 두 본문을 비교한다.
@NonCPS
String seEnvelopeShapeReason(Object obj, String channel, Set accepted) {
    if (!(obj instanceof Map)) { return 'not an object' }
    Set keys13 = ['schema_version', 'target_type', 'collection_method', 'ip', 'hostname', 'vendor', 'status',
                  'sections', 'diagnosis', 'meta', 'correlation', 'errors', 'data'] as Set
    if ((obj.keySet() as Set) != keys13) { return 'keys != 13 envelope keys' }
    def sv = obj.schema_version
    if (!((sv instanceof String && sv == '1') || ((sv instanceof Integer || sv instanceof Long) && sv == 1))) { return 'schema_version' }
    if (!(obj.target_type instanceof String) || obj.target_type != channel) { return 'target_type' }
    if (!(obj.ip instanceof String) || !accepted.contains(obj.ip)) { return 'ip' }
    if (!(obj.status instanceof String) || !(obj.status in ['success', 'partial', 'failed'])) { return 'status' }
    def sections = obj.sections
    Set all11 = ['system', 'hardware', 'bmc', 'cpu', 'memory', 'storage', 'network', 'firmware', 'users', 'power', 'thermal'] as Set
    if (!(sections instanceof Map) || (sections.keySet() as Set) != all11) { return 'sections shape' }
    for (Object v in sections.values()) {
        if (!(v instanceof String) || !(v in ['success', 'failed', 'not_supported'])) { return 'sections shape' }
    }
    def diag = obj.diagnosis
    Set diag8 = ['reachable', 'port_open', 'protocol_supported', 'auth_success', 'failure_stage', 'failure_code',
                 'failure_reason', 'details'] as Set
    if (!(diag instanceof Map) || (diag.keySet() as Set) != diag8) { return 'diagnosis shape' }
    if (!(obj.errors instanceof List) || !(obj.data instanceof Map)) { return 'errors/data type' }
    if (!(obj.meta instanceof Map) || !(obj.correlation instanceof Map)) { return 'meta/correlation type' }
    for (String k in ['collection_method', 'hostname', 'vendor']) {
        if (obj[k] != null && !(obj[k] instanceof String)) { return "${k} type".toString() }
    }
    return null
}

// 유효 envelope 줄만 고른다 — Layer A 결과(gather_final.jsonl) · Layer B 결과 · raw fallback(라이브러리 없음) 모두 이 문을 지난다
//   (2026-10-03 Astra 3차 §6, 2026-10-05 F02 — Layer B 결과도 전송 직전에 같은 문을 지난다).
//   결과 형태 검문(seEnvelopeShapeReason)을 통과한 줄만 남기고(같은 ip 는 뒤 줄 우선), 접수 순서로 돌려준다.
//   잘린 파일·깨진 줄이 Callback body 를 깨뜨리거나 host 당 1개 계약을 거짓으로 채우지 않게 하는 마지막 검문이다.
//   순수 함수(@NonCPS) — 라이브러리(se_finalize.groovy)를 못 읽은 경로에서도 돌아야 하므로 Jenkinsfile 에 둔다. 파서는 sandbox 가 허용하는 JsonSlurper.
@NonCPS
Map seFilterEnvelopeLines(List rawLines, String manifestJson) {
    def slurper = new groovy.json.JsonSlurper()
    def manifest = slurper.parseText(manifestJson)
    String channel = manifest.channel?.toString()
    List ips = (manifest.ips ?: []).collect { it.toString() }
    Set accepted = ips as Set
    Map byIp = [:]
    Map statusByIp = [:]
    int dropped = 0
    for (Object raw in (rawLines ?: [])) {
        String line = raw?.toString()?.trim()
        if (!line) { continue }
        def obj = null
        try { obj = slurper.parseText(line) } catch (Exception e) { dropped++; continue }
        if (seEnvelopeShapeReason(obj, channel, accepted) != null) {
            dropped++; continue
        }
        byIp[obj.ip] = line
        statusByIp[obj.ip] = obj.status
    }
    List lines = []
    List missing = []
    Map counts = [success: 0, partial: 0, failed: 0]
    for (String ip in ips) {
        if (byIp.containsKey(ip)) {
            lines << byIp[ip]
            counts[statusByIp[ip]] = counts[statusByIp[ip]] + 1
        } else {
            missing << ip
        }
    }
    return [lines: lines, missing: missing, dropped: dropped, counts: counts]
}

// 접수 대상 결정 (2026-10-05 F03) — 각 채널 inventory.sh 와 **같은 규칙**으로 고른다. 위반이 하나라도 있으면 요청 전체를 거부한다
//   (inventory 가 같은 입력을 exit 1 로 거부하므로, 여기서 받아들인 대상 수 == inventory host 수). 종전 Validate 는 값을 문자열로 바꾸고
//   비어 있지 않은지만 봐서, 중복 IP 를 접수 manifest 에 두 번 넣고 inventory 는 같은 요청을 거부했다.
//   규칙: 배열 · 원소는 객체 · 값은 (주 필드 → ip) 중 처음 참인 값(공백뿐인 주 필드는 ip 로 넘어가지 않는다) · 문자열 ·
//   앞뒤 공백 제거(Python str.strip() 과 같은 문자 집합) · ASCII IPv4(0~255, 앞자리 0 없음) · 중복 금지.
//   반환 [ips: [...]] 또는 [error: '...']. 같은 사례 표(tests/fixtures/input_validation/cases.json)로 inventory 와 대조한다
//   (Python: tests/unit/test_input_acceptance_parity.py, Groovy: Jenkinsfile_ci 'Finalize Corpus').
@NonCPS
Map seAcceptTargets(Object hosts, String targetType) {
    if (!(hosts instanceof List)) { return [error: 'inventory_json 은 JSON 배열이어야 합니다'] }
    if (hosts.isEmpty()) { return [error: 'inventory_json 배열이 비어있습니다'] }
    String primaryKey = (targetType == 'redfish') ? 'bmc_ip' : 'service_ip'
    String ws = '[\\t\\n\\u000B\\f\\r\\u001C-\\u001F \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]'
    String octet = '(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])'
    String ipv4 = octet + '\\.' + octet + '\\.' + octet + '\\.' + octet
    List ips = []
    Set seen = [] as Set
    for (int idx = 0; idx < hosts.size(); idx++) {
        def host = hosts[idx]
        if (!(host instanceof Map)) { return [error: "inventory_json[${idx}] 은 객체여야 합니다".toString()] }
        def raw = host[primaryKey] ?: host['ip'] ?: ''
        if (!(raw instanceof String)) { return [error: "inventory_json[${idx}] 의 '${primaryKey}' 또는 'ip' 값은 문자열이어야 합니다".toString()] }
        String ip = raw.replaceAll('^' + ws + '+', '').replaceAll(ws + '+$', '')
        if (!ip) { return [error: "inventory_json[${idx}] '${primaryKey}' 또는 'ip' 필드 누락".toString()] }
        if (!(ip ==~ ipv4)) { return [error: "inventory_json[${idx}] 유효하지 않은 IPv4 형식: '${ip}'".toString()] }
        if (seen.contains(ip)) { return [error: "inventory_json[${idx}] IP 가 중복됩니다: '${ip}'".toString()] }
        seen << ip
        ips << ip
    }
    return [ips: ips]
}

// 수집 실행 기록(gather_run.json) — scripts/gather_state.py 가 시도마다 Runner 의 시계로 시작 · 끝 · 실제 수집 시간 · 종료 코드 · 판정을 남긴다.
