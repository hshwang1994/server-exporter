pipeline {

    agent none

    parameters {
        string(
            name        : 'loc',
            defaultValue: '',
            description : 'Agent 로케이션 (ic | chj | yi)'
        )
        choice(
            name        : 'target_type',
            choices     : ['os', 'esxi', 'redfish'],
            description : '수집 대상 종류'
        )
        text(
            name        : 'inventory_json',
            description : '호스트 JSON 배열 (os/esxi: service_ip, redfish: bmc_ip, fallback: ip)'
        )
        string(
            name        : 'deploymentEnvironmentId',
            defaultValue: '',
            description : '포털 개발환경 ID'
        )
        string(
            name        : 'eventUuid',
            defaultValue: '',
            description : '포털 이벤트 UUID (결과 Callback body 에 그대로 반환)'
        )
        string(
            name        : 'callbackUrl',
            defaultValue: '',
            description : '결과 전달 Callback URL (예: http://portal.example.com)'
        )
        choice(
            name        : 'verbosity',
            choices     : ['0', '1', '2', '3', '4'],
            description : 'Ansible verbosity (0=운영, 1~2=디버그, 3~4=깊은 진단)'
        )
        string(
            name        : 'addonRef',
            defaultValue: '',
            description : '(선택) 이 빌드에서만 쓸 Add-on 브랜치 · refs/tags/<태그> · 40자 커밋 — 비우면 전역 SE_ADDON_REF (기본 main). Add-on 은 전역 SE_ADDON_REPO 가 있을 때만 돈다'
        )
    }

    environment {
        INVENTORY_JSON          = "${params.inventory_json}"
        PYTHONDONTWRITEBYTECODE = '1'
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '100'))
    }

    stages {

        stage('Resolve Location') {
            agent { label 'built-in' }
            options { timeout(time: 2, unit: 'MINUTES') }
            steps {
                script {
                    def key = params.loc?.trim()
                    if (!key) {
                        error "[Resolve Location] 필수 파라미터 누락: loc"
                    }
                    def reg = readYaml file: 'common/vars/locations.yml'
                    def known = (reg?.locations ?: [:])
                    def entry = known[key]
                    if (!entry) {
                        error "[Resolve Location] 등록되지 않은 Location: '${key}' " +
                              "— 허용: ${known.keySet().sort()}. " +
                              "새 Location 은 common/vars/locations.yml 에 등록하세요."
                    }
                    if (!entry.agent_label?.trim()) {
                        error "[Resolve Location] Location '${key}' 에 agent_label 이 없습니다 " +
                              "— common/vars/locations.yml 을 확인하세요."
                    }
                    env.SE_LOCATION    = key
                    env.SE_AGENT_LABEL = entry.agent_label.trim()
                    echo "[Resolve Location] ${key} -> agent label '${env.SE_AGENT_LABEL}'"
                }
            }
            post { always { deleteDir() } }
        }

        stage('Validate') {
            agent {
                node {
                    label "${env.SE_AGENT_LABEL}"
                    customWorkspace "${env.JOB_BASE_NAME}-${env.BUILD_NUMBER}"
                }
            }
            options {
                timeout(time: 2, unit: 'MINUTES')
                skipDefaultCheckout(true)
            }
            steps {
                script {
                    if (!params.loc?.trim()) {
                        error "[Validate] 필수 파라미터 누락: loc"
                    }

                    def allowed = ['os', 'esxi', 'redfish']
                    if (!allowed.contains(params.target_type?.trim())) {
                        error "[Validate] target_type 값 오류: '${params.target_type}' -- 허용값: ${allowed}"
                    }

                    if (!params.inventory_json?.trim()) {
                        error "[Validate] inventory_json 이 비어있습니다"
                    }

                    def hosts
                    try {
                        hosts = new groovy.json.JsonSlurper().parseText(params.inventory_json)
                    } catch (Exception e) {
                        error "[Validate] inventory_json JSON 파싱 실패: ${e.message}"
                    }

                    if (!hosts || hosts.size() == 0) {
                        error "[Validate] inventory_json 배열이 비어있습니다"
                    }

                    def primaryKey = (params.target_type == 'redfish') ? 'bmc_ip' : 'service_ip'
                    for (int idx = 0; idx < hosts.size(); idx++) {
                        def host = hosts[idx]
                        def ipVal = host[primaryKey]?.trim() ?: host['ip']?.trim()
                        if (!ipVal) {
                            error "[Validate] inventory_json[${idx}] '${primaryKey}' 또는 'ip' 필드 누락"
                        }
                    }

                    if (!params.callbackUrl?.trim()) {
                        error "[Validate] 필수 파라미터 누락: callbackUrl"
                    }
                    def cbUrl = params.callbackUrl.trim()
                    if (!(cbUrl.startsWith('http://') || cbUrl.startsWith('https://'))) {
                        error "[Validate] callbackUrl 은 http:// 또는 https:// 로 시작해야 함: ${cbUrl}"
                    }
                    if (cbUrl.contains("'") || cbUrl.contains('"') || cbUrl.contains('`') || cbUrl.contains('\\') || cbUrl.replaceAll(/\s/, '') != cbUrl) {
                        error "[Validate] callbackUrl 에 허용되지 않는 문자(따옴표/백틱/역슬래시/공백) 포함 — 거부: ${cbUrl}"
                    }
                    if (!params.deploymentEnvironmentId?.trim()) {
                        error "[Validate] 필수 파라미터 누락: deploymentEnvironmentId"
                    }

                    // addonRef (선택) — scripts/addon_checkout.sh 에 그대로 넘기므로 브랜치 · refs/tags/<태그> · 40자 커밋 해시의 글자만 허용
                    def addonRef = (params.addonRef ?: '').trim()
                    if (addonRef && (!(addonRef ==~ /[A-Za-z0-9._\/-]+/) || addonRef.startsWith('-') || addonRef.contains('..'))) {
                        error "[Validate] addonRef 형식 오류: '${addonRef}' (브랜치 · refs/tags/<태그> · 40자 커밋 해시)"
                    }

                    echo "[Validate] OK -- target_type=${params.target_type}, hosts=${hosts.size()}, loc=${params.loc}"
                    echo "[Validate] callback=${params.callbackUrl}"
                }
            }
        }

        stage('Gather') {
            agent {
                node {
                    label "${env.SE_AGENT_LABEL}"
                    customWorkspace "${env.JOB_BASE_NAME}-${env.BUILD_NUMBER}"
                }
            }
            options { timeout(time: 60, unit: 'MINUTES') }
            environment {
                REPO_ROOT                = "${WORKSPACE}"
                ANSIBLE_CONFIG           = "${WORKSPACE}/ansible.cfg"
                ANSIBLE_JSON_OUTPUT_FILE = "${WORKSPACE}/gather_output.json"
                ANSIBLE_VERBOSITY        = "${params.verbosity}"
            }
            steps {
                script {
                    def playbookMap = [
                        'os'     : "${WORKSPACE}/os-gather/site.yml",
                        'esxi'   : "${WORKSPACE}/esxi-gather/site.yml",
                        'redfish': "${WORKSPACE}/redfish-gather/site.yml",
                    ]
                    def inventoryMap = [
                        'os'     : "${WORKSPACE}/os-gather/inventory.sh",
                        'esxi'   : "${WORKSPACE}/esxi-gather/inventory.sh",
                        'redfish': "${WORKSPACE}/redfish-gather/inventory.sh",
                    ]

                    def playbook  = playbookMap[params.target_type]
                    def inventory = inventoryMap[params.target_type]
                    echo "[Gather] playbook=${playbook}"

                    sh "rm -f \"${env.WORKSPACE}/gather_output.json\""

                    // ── Add-on (고객별 추가 수집) — Jenkins 전역 환경변수 SE_ADDON_REPO 가 있을 때만 켠다. 없으면 이 블록은
                    //    아무 것도 하지 않아 수집은 Add-on 도입 전과 같다. 저장소는 빌드마다 ${WORKSPACE}/addon 에 새로 받고
                    //    (Runner 사전 작업 · 노드 설정 없음), 그 경로를 아래 ansible 실행에만 SE_ADDON_DIR 로 넘긴다.
                    //    받지 못하거나 파일 검사에 실패하면 Add-on 없이 수집하고 빌드를 UNSTABLE 로 표시한다 —
                    //    저장소 문제는 서버 문제가 아니므로 host 별 errors[] 를 만들지 않는다.
                    //    전역 변수: SE_ADDON_REPO(필수) · SE_ADDON_REF(기본 main) · SE_ADDON_CREDENTIALS_ID(비공개 저장소) ·
                    //    SE_ADDON_SSL_VERIFY(기본 false — 인증서 검증 해제는 Add-on 을 받는 git 명령에만 적용).
                    def addonDir  = ''
                    def addonRepo = (env.SE_ADDON_REPO ?: '').trim()
                    if (addonRepo) {
                        def addonRef     = (params.addonRef ?: '').trim() ?: ((env.SE_ADDON_REF ?: '').trim() ?: 'main')
                        def addonCred    = (env.SE_ADDON_CREDENTIALS_ID ?: '').trim()
                        def addonTargets = ['os': 'linux,windows', 'esxi': 'esxi', 'redfish': 'redfish'][params.target_type]
                        def fetchAddon = { ->
                            sh """#!/bin/bash
                                set -eo pipefail
                                set +x
                                cd "\${WORKSPACE}"
                                bash scripts/addon_checkout.sh "${addonRepo}" "${addonRef}" "\${WORKSPACE}/addon"
                            """
                        }
                        def problem = ''
                        try {
                            retry(2) {
                                if (addonCred) {
                                    withCredentials([usernamePassword(credentialsId: addonCred,
                                                                      usernameVariable: 'SE_ADDON_USER',
                                                                      passwordVariable: 'SE_ADDON_PASSWORD')]) {
                                        withEnv(["GIT_ASKPASS=${env.WORKSPACE}/scripts/addon_askpass.sh"]) { fetchAddon() }
                                    }
                                } else {
                                    fetchAddon()
                                }
                            }
                        } catch (Exception e) {
                            problem = "저장소를 받지 못했습니다 (${addonRepo}@${addonRef}) — 위 [addon] unavailable 줄 참조"
                        }
                        if (!problem) {
                            // 파일 검사 + 이 빌드의 서버 종류에 실행할 collector 가 있는지 (venv 의 python3 — PyYAML)
                            def rc = sh(returnStatus: true, script: """#!/bin/bash
                                set -eo pipefail
                                set +x
                                cd "\${WORKSPACE}"
                                . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                                python3 addon/tools/check_layout.py addon --targets "${addonTargets}"
                            """)
                            if (rc == 0) {
                                addonDir = "${env.WORKSPACE}/addon"
                            } else if (rc == 3) {
                                echo "[addon] 실행할 기능 없음 (target_type=${params.target_type}) — Add-on 없이 수집"
                            } else {
                                problem = "Add-on 파일 검사 실패 (rc=${rc}) — 위 [addon] 검사 실패 줄 참조"
                            }
                        }
                        if (problem) {
                            echo "[addon] unavailable: ${problem}"
                            unstable("[addon] unavailable: ${problem}")
                        }
                    }

                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        withCredentials([
                            string(
                                credentialsId: 'server-gather-vault-password',
                                variable     : 'VAULT_PASSWORD',
                            ),
                        ]) {
                            // Ansible venv 는 scripts/activate_ansible_venv.sh 가 고른다
                            //   (SE_ANSIBLE_VENV → PATH 의 ansible-playbook → 알려진 설치 경로). 못 찾으면 이 stage 는 실패한다.
                            // SE_ADDON_DIR 은 이 ansible 실행에만 준다 (stage environment{} 에 두지 않는다 — 꺼진 빌드의 환경은 종전과 같다).
                            withEnv(addonDir ? ["SE_ADDON_DIR=${addonDir}"] : []) {
                                sh """#!/bin/bash
                                    set -eo pipefail
                                    set +x
                                    cd "\${WORKSPACE}"
                                    . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                                    chmod +x "${inventory}"
                                    VAULT_TMP="\$(mktemp)"
                                    trap 'rm -f "\$VAULT_TMP"' EXIT
                                    printf '%s' "\${VAULT_PASSWORD}" > "\$VAULT_TMP"
                                    chmod 600 "\$VAULT_TMP"
                                    ansible-playbook "${playbook}" -i "${inventory}" --vault-password-file="\$VAULT_TMP" -e se_location="${env.SE_LOCATION}"
                                """
                            }
                        }
                    }

                    def gatherOut = "${env.WORKSPACE}/gather_output.json"
                    if (!fileExists(gatherOut) || readFile(gatherOut).length() == 0) {
                        error "[Gather] gather_output.json 미생성/0바이트 — ansible-playbook 완전 실패 또는 출력 경로 오류"
                    }
                }

                stash(
                    name       : 'gather-output',
                    includes   : 'gather_output.json',
                    allowEmpty : false,
                )
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Validate Schema') {
            agent {
                node {
                    label "${env.SE_AGENT_LABEL}"
                    customWorkspace "${env.JOB_BASE_NAME}-${env.BUILD_NUMBER}"
                }
            }
            options { timeout(time: 2, unit: 'MINUTES') }
            steps {
                // venv 선택 규칙은 scripts/activate_ansible_venv.sh 한 곳 — 못 찾으면 시스템 python 으로 넘어가지 않고 실패한다.
                sh '''#!/bin/bash
                    set -eo pipefail
                    set +x
                    cd "${WORKSPACE}"
                    . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                    python3 tests/validate_field_dictionary.py
                '''
            }
            post {
                always {
                    deleteDir()
                }
            }
        }

        stage('Callback') {
            agent { label 'built-in' }
            options {
                skipDefaultCheckout(true)
                timeout(time: 15, unit: 'MINUTES')
            }
            steps {
                script {
                    unstash 'gather-output'

                    def baseUrl = params.callbackUrl.trim().replaceAll('/+$', '')
                    def callbackEndpoint = baseUrl + '/api/jenkins/gather/' + params.target_type.trim()
                    echo "[Callback] POST -> ${callbackEndpoint}"

                    def jsonContent = ""
                    try {
                        jsonContent = readFile("${WORKSPACE}/gather_output.json").trim()
                    } catch (Exception e) {
                        error "[Callback] gather_output.json 읽기 실패: ${e.message}"
                    }

                    if (!jsonContent) {
                        error "[Callback] gather_output.json 이 비어있습니다 — gather 결과 미생성"
                    }

                    def rawJsonLines = []
                    for (line in jsonContent.split('\n')) {
                        def t = line.trim()
                        if (t.length() > 0) {
                            rawJsonLines.add(t)
                        }
                    }

                    echo "[Callback] JSON 라인 ${rawJsonLines.size()}개"

                    if (rawJsonLines.isEmpty()) {
                        error "[Callback] gather_output.json 에 유효 JSON 라인 0개"
                    }

                    def gatherArray = rawJsonLines.join(',')

                    def callbackBody = '{'  +
                        '"loc":"'                        + params.loc.replaceAll('\\\\', '\\\\\\\\').replaceAll('"', '\\\\"').replaceAll('\n', '\\\\n').replaceAll('\r', '\\\\r').replaceAll('\t', '\\\\t')                        + '",' +
                        '"deploymentEnvironmentId":"'   + params.deploymentEnvironmentId.replaceAll('\\\\', '\\\\\\\\').replaceAll('"', '\\\\"').replaceAll('\n', '\\\\n').replaceAll('\r', '\\\\r').replaceAll('\t', '\\\\t')   + '",' +
                        '"eventUuid":"'                 + (params.eventUuid ?: '').replaceAll('\\\\', '\\\\\\\\').replaceAll('"', '\\\\"').replaceAll('\n', '\\\\n').replaceAll('\r', '\\\\r').replaceAll('\t', '\\\\t')   + '",' +
                        '"gatherInfoJson":['             + gatherArray                                               + ']'  +
                    '}'

                    echo "[Callback] body ${callbackBody.length()} bytes, hosts=${rawJsonLines.size()}"

                    def maxRetries = 3
                    def success = false
                    def lastError = ''

                    for (int attempt = 1; attempt <= maxRetries; attempt++) {
                        echo "[Callback] [${attempt}/${maxRetries}] 전송중..."
                        def httpCode = ''
                        def respBody = ''
                        try {
                            def resp = httpRequest(
                                url                    : callbackEndpoint,
                                httpMode               : 'POST',
                                contentType            : 'APPLICATION_JSON',
                                requestBody            : callbackBody,
                                timeout                : 300,
                                validResponseCodes     : '100:599',
                                consoleLogResponseBody : false,
                            )
                            httpCode = "${resp.status}"
                            respBody = resp.content ?: ''
                        } catch (Exception e) {
                            lastError = "httpRequest 예외 (연결 실패/timeout): ${e.message}"
                        }

                        if (httpCode ==~ /2\d\d/) {
                            echo "[Callback] [OK] HTTP ${httpCode} (${attempt}/${maxRetries})"
                            success = true
                            break
                        }
                        if (httpCode) {
                            def snippet = (respBody.length() > 500) ? respBody.substring(0, 500) : respBody
                            lastError = "HTTP ${httpCode}" + (snippet ? " -- ${snippet}" : "")
                        }
                        echo "[Callback] [FAIL] (${attempt}/${maxRetries}) ${lastError}"

                        if (attempt < maxRetries) {
                            def waitSec = attempt * 10
                            echo "[Callback] ${waitSec}초 후 재시도"
                            sleep(time: waitSec, unit: 'SECONDS')
                        }
                    }

                    if (!success) {
                        unstable "[Callback] ${maxRetries}회 재시도 실패 -- ${lastError} (수집 결과는 console log/artifact 확인)"
                    }
                }
            }
            post {
                always {
                    deleteDir()
                }
            }
        }
    }

    post {
        always {
            echo "[Post] ======================================================="
            echo "[Post] 결과: ${currentBuild.currentResult}"
            echo "[Post] 소요: ${currentBuild.durationString ?: '-'}"
            echo "[Post] type: ${params.target_type}"
            echo "[Post] ======================================================="
        }
        success {
            echo "[Post] [OK] Gather + Callback 완료"
        }
        unstable {
            echo "[Post] [WARN] 일부 단계 실패 -- 포털 확인 필요"
        }
        failure {
            echo "[Post] [FAIL] 파이프라인 실패 -- 콘솔 로그 확인"
        }
    }
}
