// 마지막 시도의 상태 — 요청 도구는 연결 실패 · 응답 시간 초과도 408 로 표시한다
@NonCPS
String seLastTryText(List tries) {
    Map last = (tries && (tries[tries.size() - 1] instanceof Map)) ? (Map) tries[tries.size() - 1] : [:]
    if (last.outcome == 'interrupted') { return '마지막 시도: 응답을 받기 전에 중단됨' }
    if (last.http_code != null) {
        return ("${last.http_code}" == '408') ? '마지막 전송 도구 상태: 408' : "마지막 응답: HTTP ${last.http_code}".toString()
    }
    return last.error ? "마지막 오류: ${last.error}".toString() : '마지막 시도: 응답 없음'
}

// 무엇을 기다리는지 — 기존 대기 사유(기록값)에서 고른다. 쉬는 구간(대상 '-')은 null
@NonCPS
String seWaitSubject(String reason, String target) {
    String r = (reason ?: '').toString()
    if (target == '-') { return null }
    if (r.startsWith('결과 처리 노드')) { return '결과를 처리할 Jenkins 노드' }
    if (r.contains('복구 대기')) { return '수집을 이어서 실행할 Runner' }
    return '수집을 실행할 Runner'
}

