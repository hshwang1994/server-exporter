// ─────────────────────────────────────────────────────────────────────────────
// 공용 helper — pipeline{} 밖의 Groovy 메서드 (script 블록과 post 에서 부른다).
//   2026-10-03 (Plan §6): 결과 보존 · 결과 확인 · Portal 전송을 **파이프라인 post{always}** 로 옮겼다.
//   어느 단계에서 멈추든(접수 뒤) 접수 목록(manifest)의 IP 마다 결과 하나를 Portal 에 보내려 시도한다.
// ─────────────────────────────────────────────────────────────────────────────

// 시간 한계 (초) — 2026-10-05 (8차 R3), 2026-10-06 (9차 — 실행 기반 대기 · 같은 Runner 재개).
//   사용자 요구: 기다리면 계속할 수 있는 작업을 먼저 포기하지 않는다. 한계는 실제 실행에만 걸고, 실행 기반(Runner · Jenkins Agent ·
//   결과 처리 노드)을 기다린 시간은 실행 시간에 넣지 않는다. 빌드 전체 · 서버 정보 수집 단계의 timeout 은 두지 않는다(72시간 대기를 막는다).
//     실행 기반 대기       : 이 빌드가 실행 기반을 기다린 시간의 합이 INFRA_WAIT(72시간)을 넘지 않는다 — Runner 배정 · 실행 중 연결 끊김 ·
//                            결과 처리 노드. 다시 시도하거나 이어서 수집해도 처음부터 다시 세지 않는다. Jenkins queue 로 기다리고 executor 를 잡지 않는다
//     실제 수집            : 누적 최대 GATHER_MAX(6시간) — 시도마다 scripts/run_gather.sh 가 (6시간 − 누적 실행 시간)을 timeout 으로 집행한다
//                            (누적은 scripts/gather_state.py). 동시에 수집한 Host 시간을 겹쳐 세지 않는다
//     시도 하나의 실행 한계 : node 를 얻은 뒤에만 센다 = GATHER_MAX + KILL_AFTER + ATTEMPT_MARGIN(준비 · 보존 몫). 멈춘 step 이 빌드를 붙잡지 않게 한다
//     결과 확인 및 전송     : 결과 처리 노드(built-in)를 얻은 뒤 FINALIZER(1시간)
//   입력 확인 · 실행 위치 확인은 controller 에서 각 5분(stage options.timeout)이다 — 실행 기반 대기가 아니라 입력 · 저장소 확인이다.
@NonCPS
Map seConstants() {
    return [
        INFRA_WAIT     : 259200,  // 실행 기반 대기 합 72시간
        GATHER_MAX     : 21600,   // 실제 수집 누적 최대 6시간 (scripts/run_gather.sh 인자, scripts/gather_state.py 가 누적을 뺀다)
        KILL_AFTER     : 90,      // timeout --kill-after
        ATTEMPT_MARGIN : 7200,    // 시도 하나의 준비(checkout · Add-on 받기) · 보존(결과 정리 · archive · stash) 몫
        FINALIZER      : 3600,    // 결과 확인 및 전송 — 결과 처리 노드를 얻은 뒤
        ABORT_NODE_WAIT: 300,     // 취소된 빌드는 결과 처리 노드를 이만큼만 기다린다(사용자가 취소하면 대기도 끝낸다)
        BACKOFF_MAX    : 3600,    // 진척 없이 Runner 측 장애가 반복될 때 다시 시도하기 전 쉬는 시간의 상한(5분부터 두 배씩)
        MAX_BUILD      : 295200,  // 작업 폴더 정리가 끝 기록 없는 폴더를 실행 중으로 보는 기간 = 72 + 6 + 1 + 여유 3 시간
        PORTAL_WAIT    : 600,     // Portal 응답 대기 — 시도 1번당. 요청 도구(http_request)는 연결과 응답 대기에 같은 값을 쓴다
        PORTAL_MIN     : 30,      // 남은 시간이 이보다 적으면 그 시도를 시작하지 않고 기록만 한다
        PORTAL_ATTEMPTS: 3,       // 취소된 빌드는 1번
        KEEP_DAYS      : 7,       // 보관을 확인한 결과 확인 폴더(fin-<빌드>)가 남았을 때 정리 대상으로 보는 기간
    ]
}

// 시각 (8차 R2) — 사람이 읽는 줄은 날짜 · 시각 · 시간대(이 controller 의 시간대, 예: 2026-10-05 21:10:03 +09:00),
//   기록(finalize_summary.json)은 UTC ISO 8601(예: 2026-10-05T12:10:03.123Z). sandbox 가 허용하는 Date.format 만 쓰고
//   Jenkins · OS 의 시간대 설정은 바꾸지 않는다.
@NonCPS
String seShowTime(long ms) {
    String s = new Date(ms).format('yyyy-MM-dd HH:mm:ss XXX')
    return s.endsWith('Z') ? s.substring(0, s.length() - 1) + '+00:00' : s
}

@NonCPS
String seIsoUtc(long ms) {
    return new Date(ms).format("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", TimeZone.getTimeZone('UTC'))
}

long seNowMs() { return System.currentTimeMillis() }

long seNowSec() { return (long) (System.currentTimeMillis() / 1000L) }

// 시간 길이를 사람이 읽는 말로 — 6시간 · 1시간 5분 · 3분 20초 · 45초
@NonCPS
String seDuration(long sec) {
    long v = Math.max(0L, sec)
    long h = (long) (v / 3600L)
    long m = (long) ((v % 3600L) / 60L)
    long s = v % 60L
    List parts = []
    if (h > 0L) { parts << "${h}시간".toString() }
    if (m > 0L) { parts << "${m}분".toString() }
    if (s > 0L || parts.isEmpty()) { parts << "${s}초".toString() }
    return parts.join(' ')
}

// 걸린 시간 — 1분 미만은 소수 첫째 자리까지(예: 0.8초), 그 이상은 seDuration
@NonCPS
String seElapsedText(long ms) {
    if (ms < 60000L) {
        long tenths = Math.round(Math.max(0L, ms) / 100.0d)
        return "${(long) (tenths / 10L)}.${tenths % 10L}초".toString()
    }
    return seDuration((long) (ms / 1000L))
}

// 업무 이벤트 줄 — 본문 앞에 시각을 붙인다. 콘솔의 줄 시각(Timestamper)이 없는 화면 · 내려받은 로그에서도 시각이 보이게 하려는 것이다.
def seLog(String line) {
    echo "[${seShowTime(seNowMs())}] ${line}"
}

// 콘솔 줄 시각 (8차 R2) — Timestamper 플러그인이 있으면 이 블록 안의 모든 콘솔 줄에 시각이 붙는다(이 Job 범위, 전역 설정은 바꾸지 않는다).
//   options { timestamps() } 는 플러그인이 없는 Jenkins 에서 파이프라인 해석 단계부터 실패하므로 쓰지 않는다. 대신 블록에 **들어가기 전**
//   `timestamps` step 이 없어서 나는 NoSuchMethodError 만 받아 본문을 그대로 실행한다(본문 안에서 난 같은 오류는 다시 던진다).
//   줄 시각의 표시 형식 · 시간대는 Jenkins 화면 설정을 따른다. 업무 이벤트 줄은 이와 별개로 seLog 가 본문에 시각을 적는다.
def seTimestamped(Closure body) {
    boolean entered = false
    try {
        timestamps {
            entered = true
            body()
        }
    } catch (NoSuchMethodError e) {
        if (entered) {
            throw e
        }
        body()
    }
}

// readTrusted 로 읽은 정본의 식별 (2026-10-04 최종 지시 §5 · Plan §0 ②) — 콘솔에 길이와 Java String.hashCode(32-bit) 를 남긴다.
//   sandbox 가 MessageDigest · CRC32 를 허용하지 않아 runtime 이 낼 수 있는 해시는 이것뿐이다. 후보 revision 의 같은 파일(`git show <sha>:<path>`)과
//   대조해 "이 빌드가 어느 내용을 읽었는지" 를 확인하는 용도(혼합 revision 탐지)이지 무결성 증명이 아니다. Jenkins 자체 기록 "Obtained <path> from <SCM>" 은
//   출처만 남기고 revision 은 남기지 않는다. 추가 checkout · 외부 도구 없음. 증거 대조는 scripts/ai/prodgen/evidence.py trusted_report().
String seTrusted(String path) {
    String text = readTrusted(path)
    echo "[Trusted] ${path} len=${text.length()} jhash=${text.hashCode()}"
    return text
}

// Layer B 순수 함수(seFallbackCanon · seJsonString · seReconcileRaw)의 정본은 scripts/jenkins/se_finalize.groovy 다 (2026-10-03, GP-11).
//   Jenkinsfile_ci 의 corpus self-test 가 같은 파일을 load 해 Python Layer A 와 동치를 확인한다 — 여기 사본을 두면 두 곳이 어긋난다.
//   readTrusted 는 Job 의 SCM(lightweight)에서 파일 하나만 읽고, load 는 workspace 가 있는 node 안에서만 된다 → finalizer node 안에서 부른다.
//   읽기/적재에 실패하면 null — 호출자는 Layer A 결과(gather_final.jsonl)가 있으면 그것을, 없으면 raw OUTPUT 줄만 보내고 UNSTABLE 로 남긴다.
def seLoadFinalizeLib() {
    try {
        writeFile(file: 'se_finalize.groovy', text: seTrusted('scripts/jenkins/se_finalize.groovy'), encoding: 'UTF-8')
        return load('se_finalize.groovy')
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (Exception e) {
        echo "[결과 확인] 결과 복구 모듈을 읽지 못했습니다. 확보된 수집 결과로 처리를 계속합니다.\n  파일: scripts/jenkins/se_finalize.groovy\n  오류: ${e.message}"
        return null
    }
}

// 정본 로딩 — readTrusted 는 Job 의 SCM(lightweight)에서 파일 하나씩 읽는다(workspace 불필요). 실패하면 복제 fallback(라이브러리 값).
def seLoadCanon(def lib) {
    Map canon = lib.seFallbackCanon()
    try {
        def fr = readYaml text: seTrusted('common/vars/failure_reasons.yml')
        def ss = readYaml text: seTrusted('common/vars/supported_sections.yml')
        if (fr?._fr_catalog?.output_build_failed?.default) { canon.reason = fr._fr_catalog.output_build_failed.default }
        if (fr?._fr_catalog?.infra_unavailable?.default) { canon.infraReason = fr._fr_catalog.infra_unavailable.default }
        if (ss?.channel_sections) { canon.sections = ss.channel_sections; canon.all = ss.all_sections ?: canon.all }
        canon.source = 'readTrusted'
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie      // 취소·timeout 은 정본 읽기 실패가 아니다 — 삼키지 않는다 (3차 §4-2)
    } catch (Exception e) {
        echo "[결과 확인] 오류 안내 파일을 읽지 못해 기본 메시지를 사용합니다.\n  파일: common/vars/failure_reasons.yml, common/vars/supported_sections.yml\n  오류: ${e.message}"
        canon.source = 'fallback'
    }
    return canon
}

// Portal 전송 (8차 R2 · R3) — 계약(2026-10-05 사용자 결정): 정해진 주소로 POST 해서 HTTP 2xx 를 받으면 전달 완료다.
//   2xx 는 Portal 이 요청을 받았다는 뜻이지 Portal 이 저장까지 마쳤다는 뜻이 아니다. 저장 · 반영 확인은 이 Job 의 역할이 아니어서
//   응답 본문은 읽지도 기록하지도 않는다(quiet: true). 시도는 최대 3번(취소된 빌드는 1번)이고, 시도마다 응답을 최대 PORTAL_WAIT(10분)
//   기다린다. 요청 도구는 연결과 응답 대기에 같은 값을 쓰며, 연결 자체는 OS 의 재전송 한도(Linux 기본 약 2분)에서 먼저 끝난다.
//   결정적 4xx(408 · 429 제외)는 다시 보내지 않는다. 남은 시간이 PORTAL_MIN 보다 적으면 그 시도를 시작하지 않는다.
//   기록(state — finalize_summary.json 의 callback): 전송 시작 · 끝, 시도마다 시작 · 끝 · 걸린 시간 · HTTP 상태 또는 오류, 재시도 대기.
//   실제로 시작한 시도만 남긴다 — 시작하지 않은 시도에는 시각을 만들지 않고, 중단된 시도에는 끝 · 응답 시각을 적지 않는다.
//   요청 본문 · 비밀값은 적지 않는다. state 는 호출자의 Map 이라 전송 중 중단돼도 그때까지의 기록이 남는다.
def seCallback(String body, long deadlineSec, Map C, Map state) {
    String endpoint = params.callbackUrl.trim().replaceAll('/+$', '') + '/api/jenkins/gather/' + params.target_type.trim()
    boolean aborted = (currentBuild.result == 'ABORTED')
    int maxAttempts = aborted ? 1 : (C.PORTAL_ATTEMPTS as int)
    // 10차 R1: 결과 확인이 실행 기반 오류로 다시 들어오면 앞 진입의 시도 기록을 이어받는다 — 시도 수를 처음부터 세지 않는다.
    //   이미 2xx 를 받은 전송은 호출자가 거른다(다시 보내지 않는다). 수신을 확인하지 못한 전송만 남은 횟수 안에서 다시 보낸다(본문 · eventUuid 같음).
    // 10차 마무리 4.1: Portal 이 확정 거부(408 · 429 제외 4xx)한 뒤에는 재진입해도 다시 POST 하지 않는다 — state.refused 를 진입 사이에 유지한다.
    if (!(state.tries instanceof List)) { state.tries = [] }
    int done = (state.tries as List).size()
    state.delivered = (state.delivered == true)
    state.refused = (state.refused == true)
    if (done == 0) {
        state.http_code = null
        state.reason = null
    }
    if (!state.started_at) { state.started_at = seIsoUtc(seNowMs()) }
    boolean resolved = (state.delivered == true) || (state.refused == true)   // 10차 마무리 4.1: 확정된 전송은 재진입해도 다시 보내지 않는다
    if (resolved) {
        seLog("[Portal 전송] 앞선 결과 처리에서 " + (state.delivered ? "HTTP ${state.http_code} 응답을 이미 받았습니다" : "Portal이 요청을 거부했습니다(HTTP ${state.http_code})") + ". 다시 보내지 않습니다.")
    } else if (done >= maxAttempts) {
        seLog("[Portal 전송] 앞선 결과 처리에서 이미 ${done}번 시도해 더 보내지 않습니다.")
    }
    for (int attempt = done + 1; !resolved && attempt <= maxAttempts; attempt++) {
        long left = deadlineSec - seNowSec()
        if (left < (C.PORTAL_MIN as long)) {
            if ((state.tries as List).isEmpty()) {
                seLog("[Portal 전송] Portal 전송을 시작하지 않았습니다.\n  처리 시간이 ${left}초밖에 남지 않았습니다. 전송에는 최소 ${C.PORTAL_MIN}초가 필요합니다.")
            } else {
                seLog("[Portal 전송] 처리 시간이 부족해 ${attempt}번째 전송은 시작하지 않았습니다.\n  남은 시간 ${left}초, 필요한 시간 최소 ${C.PORTAL_MIN}초")
            }
            if (state.reason == null) { state.reason = 'no_time' }
            break
        }
        int t = (int) Math.min((long) C.PORTAL_WAIT, left - 10L)
        long t0 = seNowMs()
        Map rec = [attempt: attempt, started_at: seIsoUtc(t0), timeout_sec: t]
        state.tries << rec
        seLog("[Portal 전송] ${attempt}번째 전송을 시작합니다.${seCallbackStartDetail(attempt == done + 1, endpoint, aborted, done, maxAttempts, (long) t, C.PORTAL_WAIT as long)}")
        Integer status = null
        String problem = null
        try {
            def resp = httpRequest(url: endpoint, httpMode: 'POST', contentType: 'APPLICATION_JSON', requestBody: body,
                                   timeout: t, validResponseCodes: '100:599', consoleLogResponseBody: false, quiet: true)
            status = resp.status
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            rec.outcome = 'interrupted'      // 응답을 받지 못한 채 중단됐다 — 끝 · 응답 시각을 적지 않는다
            throw fie
        } catch (Exception e) {
            problem = (e.message ?: e.getClass().simpleName).toString()
        }
        long t1 = seNowMs()
        rec.ended_at = seIsoUtc(t1)
        rec.elapsed_ms = t1 - t0
        String took = seElapsedText(t1 - t0)
        String code = (status != null) ? "${status}".toString() : ''
        if (status != null) {
            rec.http_code = status
            state.http_code = status
        }
        if (code ==~ /2\d\d/) {
            rec.outcome = 'delivered'
            state.delivered = true
            state.reason = null
            state.delivered_show = seShowTime(t1)
            seLog("[Portal 전송] HTTP ${code} 응답을 받았습니다. 소요 시간 ${took}.")
            break
        }
        if (code ==~ /4\d\d/ && !(code in ['408', '429'])) {
            rec.outcome = 'refused'
            state.reason = 'refused'
            state.refused = true          // 10차 마무리 4.1: 확정 거부 — 재진입해도 다시 보내지 않는다(408 · 429 는 재시도 대상이라 제외)
            seLog("[Portal 전송] Portal이 요청을 거부했습니다. HTTP ${code}.\n  다시 보내지 않습니다.\n  소요 시간: ${took}")
            break
        }
        rec.outcome = 'failed'
        state.reason = 'failed'
        if (code) {
            // http_request 는 연결 실패 · 응답 시간 초과도 408 로 돌려준다(quiet 라 도구의 설명 줄은 나오지 않는다) — 서버의 408 과 구분할 수 없어 도구 상태로 적는다
            String why = (code == '408') ? '연결하지 못했거나 응답을 받지 못했습니다.\n  전송 도구 상태: 408' : "HTTP ${code} 응답을 받았습니다."
            seLog("[Portal 전송] ${attempt}번째 전송에 실패했습니다.\n  ${why}\n  소요 시간: ${took}")
        } else {
            rec.error = problem.take(200)
            seLog("[Portal 전송] ${attempt}번째 전송에 실패했습니다.\n  연결하지 못했거나 응답을 받지 못했습니다.\n  오류: ${problem.take(200)}\n  소요 시간: ${took}")
        }
        if (attempt < maxAttempts) {
            long wait = Math.max(0L, Math.min(10L * attempt, deadlineSec - seNowSec() - (C.PORTAL_MIN as long)))
            if (wait > 0L) {
                rec.retry_wait = [started_at: seIsoUtc(seNowMs()), sec: wait]
                seLog("[Portal 전송] ${wait}초 후 ${attempt + 1}번째 전송을 시도합니다.")
                sleep(time: wait, unit: 'SECONDS')
            }
        }
    }
    state.attempts = state.tries.size()
    state.attempted = (state.attempts > 0)
    state.ended_at = seIsoUtc(seNowMs())
    if (!state.delivered && state.reason == null) { state.reason = state.attempted ? 'failed' : 'no_time' }
    // 수신 여부 (9차 W08 · 10차 마무리 4.2): 2xx → delivered. 응답을 확인하지 못한 시도 — 연결 실패 · 408(요청 도구는 연결 실패 · 응답 시간 초과를
    //   408 로 돌려준다) · 응답 확인 전 중단(interrupted) — 이 하나라도 있으면 Portal 이 받았는지 알 수 없다 → uncertain. 2xx 아닌 응답만 받았으면
    //   not_delivered. 중단은 보낸 뒤 응답을 못 받은 것이라, 그 뒤 재진입에서 확정 거부(4xx)를 받아도 앞 전송이 전달됐을 수 있어 uncertain 이다.
    boolean unknownReceipt = false
    for (Map t in state.tries) {
        if (t.outcome == 'interrupted' || (t.outcome == 'failed' && (t.http_code == null || "${t.http_code}" == '408'))) { unknownReceipt = true }
    }
    state.receipt = state.delivered ? 'delivered' : (!state.attempted ? 'not_attempted' : (unknownReceipt ? 'uncertain' : 'not_delivered'))
    // 마지막 상태 문구는 기록(delivered · refused · 시도 기록)으로 고른다 — 거부는 위 줄이 이미 알렸다. 상태는 마지막 시도의 기록에서 읽는다
    if (!state.delivered && state.attempted && !state.refused) {
        seLog("[Portal 전송] 전송을 확인하지 못했습니다. 총 ${state.attempts}번 시도했습니다.\n  ${seLastTryText(state.tries as List)}")
    }
    return state
}

