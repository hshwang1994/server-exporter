@NonCPS
String seShowTime(long ms) {
    String s = new Date(ms).format('yyyy-MM-dd HH:mm:ss XXX')
    return s.endsWith('Z') ? s.substring(0, s.length() - 1) + '+00:00' : s
}

@NonCPS
String seIsoUtc(long ms) {
    return new Date(ms).format("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", TimeZone.getTimeZone('UTC'))
}

long seNowMs() { return System.currentTimeMillis() }

long seNowSec() { return (long) (System.currentTimeMillis() / 1000L) }

@NonCPS
String seDuration(long sec) {
    long v = Math.max(0L, sec)
    long h = (long) (v / 3600L)
    long m = (long) ((v % 3600L) / 60L)
    long s = v % 60L
    List parts = []
    if (h > 0L) { parts << "${h}시간".toString() }
    if (m > 0L) { parts << "${m}분".toString() }
    if (s > 0L || parts.isEmpty()) { parts << "${s}초".toString() }
    return parts.join(' ')
}

@NonCPS
String seElapsedText(long ms) {
    if (ms < 60000L) {
        long tenths = Math.round(Math.max(0L, ms) / 100.0d)
        return "${(long) (tenths / 10L)}.${tenths % 10L}초".toString()
    }
    return seDuration((long) (ms / 1000L))
}

def seLog(String line) {
    echo "[${seShowTime(seNowMs())}] ${line}"
}

def seTimestamped(Closure body) {
    boolean entered = false
    try {
        timestamps {
            entered = true
            body()
        }
    } catch (NoSuchMethodError e) {
        if (entered) {
            throw e
        }
        body()
    }
}

String seTrusted(String path) {
    String text = readTrusted(path)
    echo "[Trusted] ${path} len=${text.length()} jhash=${text.hashCode()}"
    return text
}

def seLoadFinalizeLib() {
    try {
        writeFile(file: 'se_finalize.groovy', text: seTrusted('scripts/jenkins/se_finalize.groovy'), encoding: 'UTF-8')
        return load('se_finalize.groovy')
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (Exception e) {
        echo "[결과 확인] 결과 복구 모듈을 읽지 못했습니다. 확보된 수집 결과로 처리를 계속합니다.\n  파일: scripts/jenkins/se_finalize.groovy\n  오류: ${e.message}"
        return null
    }
}

def seLoadCanon(def lib) {
    Map canon = lib.seFallbackCanon()
    try {
        def fr = readYaml text: seTrusted('common/vars/failure_reasons.yml')
        def ss = readYaml text: seTrusted('common/vars/supported_sections.yml')
        if (fr?._fr_catalog?.output_build_failed?.default) { canon.reason = fr._fr_catalog.output_build_failed.default }
        if (fr?._fr_catalog?.infra_unavailable?.default) { canon.infraReason = fr._fr_catalog.infra_unavailable.default }
        if (ss?.channel_sections) { canon.sections = ss.channel_sections; canon.all = ss.all_sections ?: canon.all }
        canon.source = 'readTrusted'
    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
        throw fie
    } catch (Exception e) {
        echo "[결과 확인] 오류 안내 파일을 읽지 못해 기본 메시지를 사용합니다.\n  파일: common/vars/failure_reasons.yml, common/vars/supported_sections.yml\n  오류: ${e.message}"
        canon.source = 'fallback'
    }
    return canon
}

def seCallback(String body, long deadlineSec, Map C, Map state) {
    String endpoint = params.callbackUrl.trim().replaceAll('/+$', '') + '/api/jenkins/gather/' + params.target_type.trim()
    boolean aborted = (currentBuild.result == 'ABORTED')
    int maxAttempts = aborted ? 1 : (C.PORTAL_ATTEMPTS as int)
    if (!(state.tries instanceof List)) { state.tries = [] }
    int done = (state.tries as List).size()
    state.delivered = (state.delivered == true)
    state.refused = (state.refused == true)
    if (done == 0) {
        state.http_code = null
        state.reason = null
    }
    if (!state.started_at) { state.started_at = seIsoUtc(seNowMs()) }
    boolean resolved = (state.delivered == true) || (state.refused == true)
    if (resolved) {
        seLog("[Portal 전송] 앞선 결과 처리에서 " + (state.delivered ? "HTTP ${state.http_code} 응답을 이미 받았습니다" : "Portal이 요청을 거부했습니다(HTTP ${state.http_code})") + ". 다시 보내지 않습니다.")
    } else if (done >= maxAttempts) {
        seLog("[Portal 전송] 앞선 결과 처리에서 이미 ${done}번 시도해 더 보내지 않습니다.")
    }
    for (int attempt = done + 1; !resolved && attempt <= maxAttempts; attempt++) {
        long left = deadlineSec - seNowSec()
        if (left < (C.PORTAL_MIN as long)) {
            if ((state.tries as List).isEmpty()) {
                seLog("[Portal 전송] Portal 전송을 시작하지 않았습니다.\n  처리 시간이 ${left}초밖에 남지 않았습니다. 전송에는 최소 ${C.PORTAL_MIN}초가 필요합니다.")
            } else {
                seLog("[Portal 전송] 처리 시간이 부족해 ${attempt}번째 전송은 시작하지 않았습니다.\n  남은 시간 ${left}초, 필요한 시간 최소 ${C.PORTAL_MIN}초")
            }
            if (state.reason == null) { state.reason = 'no_time' }
            break
        }
        int t = (int) Math.min((long) C.PORTAL_WAIT, left - 10L)
        long t0 = seNowMs()
        Map rec = [attempt: attempt, started_at: seIsoUtc(t0), timeout_sec: t]
        state.tries << rec
        seLog("[Portal 전송] ${attempt}번째 전송을 시작합니다.${seCallbackStartDetail(attempt == done + 1, endpoint, aborted, done, maxAttempts, (long) t, C.PORTAL_WAIT as long)}")
        Integer status = null
        String problem = null
        try {
            def resp = httpRequest(url: endpoint, httpMode: 'POST', contentType: 'APPLICATION_JSON', requestBody: body,
                                   timeout: t, validResponseCodes: '100:599', consoleLogResponseBody: false, quiet: true)
            status = resp.status
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            rec.outcome = 'interrupted'
            throw fie
        } catch (Exception e) {
            problem = (e.message ?: e.getClass().simpleName).toString()
        }
        long t1 = seNowMs()
        rec.ended_at = seIsoUtc(t1)
        rec.elapsed_ms = t1 - t0
        String took = seElapsedText(t1 - t0)
        String code = (status != null) ? "${status}".toString() : ''
        if (status != null) {
            rec.http_code = status
            state.http_code = status
        }
        if (code ==~ /2\d\d/) {
            rec.outcome = 'delivered'
            state.delivered = true
            state.reason = null
            state.delivered_show = seShowTime(t1)
            seLog("[Portal 전송] HTTP ${code} 응답을 받았습니다. 소요 시간 ${took}.")
            break
        }
        if (code ==~ /4\d\d/ && !(code in ['408', '429'])) {
            rec.outcome = 'refused'
            state.reason = 'refused'
            state.refused = true
            seLog("[Portal 전송] Portal이 요청을 거부했습니다. HTTP ${code}.\n  다시 보내지 않습니다.\n  소요 시간: ${took}")
            break
        }
        rec.outcome = 'failed'
        state.reason = 'failed'
        if (code) {
            String why = (code == '408') ? '연결하지 못했거나 응답을 받지 못했습니다.\n  전송 도구 상태: 408' : "HTTP ${code} 응답을 받았습니다."
            seLog("[Portal 전송] ${attempt}번째 전송에 실패했습니다.\n  ${why}\n  소요 시간: ${took}")
        } else {
            rec.error = problem.take(200)
            seLog("[Portal 전송] ${attempt}번째 전송에 실패했습니다.\n  연결하지 못했거나 응답을 받지 못했습니다.\n  오류: ${problem.take(200)}\n  소요 시간: ${took}")
        }
        if (attempt < maxAttempts) {
            long wait = Math.max(0L, Math.min(10L * attempt, deadlineSec - seNowSec() - (C.PORTAL_MIN as long)))
            if (wait > 0L) {
                rec.retry_wait = [started_at: seIsoUtc(seNowMs()), sec: wait]
                seLog("[Portal 전송] ${wait}초 후 ${attempt + 1}번째 전송을 시도합니다.")
                sleep(time: wait, unit: 'SECONDS')
            }
        }
    }
    state.attempts = state.tries.size()
    state.attempted = (state.attempts > 0)
    state.ended_at = seIsoUtc(seNowMs())
    if (!state.delivered && state.reason == null) { state.reason = state.attempted ? 'failed' : 'no_time' }
    boolean unknownReceipt = false
    for (Map t in state.tries) {
        if (t.outcome == 'interrupted' || (t.outcome == 'failed' && (t.http_code == null || "${t.http_code}" == '408'))) { unknownReceipt = true }
    }
    state.receipt = state.delivered ? 'delivered' : (!state.attempted ? 'not_attempted' : (unknownReceipt ? 'uncertain' : 'not_delivered'))
    if (!state.delivered && state.attempted && !state.refused) {
        seLog("[Portal 전송] 전송을 확인하지 못했습니다. 총 ${state.attempts}번 시도했습니다.\n  ${seLastTryText(state.tries as List)}")
    }
    return state
}

