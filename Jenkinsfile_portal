@NonCPS
String seCallbackStartDetail(boolean first, String endpoint, boolean aborted, int done, int maxAttempts, long waitSec, long portalWait) {
    List rows = []
    if (first) {
        rows << "주소: ${endpoint}".toString()
        if (aborted) { rows << '취소된 빌드라 한 번만 보냅니다.' }
