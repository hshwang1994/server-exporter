                                  text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, functions_src: 'checkout', bounded: true, results: bres]))
                        env.CI_STAGE_HARNESS_BOUNDED = bres.every { it.ok } ? 'PASS' : 'PARTIAL'
                        echo "[Harness/bounded] ${env.CI_STAGE_HARNESS_BOUNDED} — ${bres.collect { it.scenario + '=' + it.result }} (승인 없으면 PARTIAL/승인 — harness_result.json 의 partial 참조)"
                    } else {
                        env.CI_STAGE_HARNESS_BOUNDED = 'PARTIAL'
                    }
                }
            }
        }

        stage('Prodgen Build') {
            steps {
                script {
