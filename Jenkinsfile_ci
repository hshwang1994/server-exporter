        stage('Prodgen Verify') {
            when { expression { env.CI_STAGE_PRODGEN_BUILD == 'PASS' } }
            steps {
                script {
                    // G13(Jenkins 린터) 토큰과 G19(vault) 암호는 **이 stage 안에서만** 바인딩한다. 둘 다 mktemp 0600 파일로 넘기고 trap 으로 지운다.
                    //   어느 쪽 credential 이 없으면 그 gate 는 SKIP → verdict PARTIAL(통과 아님) 로 남는다 — 거부가 아니라 사실 그대로다.
                    boolean haveLint = true
                    boolean haveVault = true
                    def verifyBody = { String netrcArg, String vaultArg ->
                        return sh(returnStatus: true, label: 'prodgen verify', script: """#!/bin/bash
                            set -o pipefail
                            set +x
                            cd "\${WORKSPACE}"
                            . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                            eval "\$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                            NETRC_TMP=""; VAULT_TMP=""
                            trap 'rm -f "\$NETRC_TMP" "\$VAULT_TMP"' EXIT
                            ARGS=()
                            if [ "${netrcArg}" = "yes" ]; then
                                NETRC_TMP="\$(mktemp)"; chmod 600 "\$NETRC_TMP"
                                printf 'machine %s login %s password %s\\n' "\$(echo "\${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "\${LINT_USER}" "\${LINT_TOKEN}" > "\$NETRC_TMP"
                                ARGS+=(--netrc "\$NETRC_TMP")
                            fi
                            if [ "${vaultArg}" = "yes" ]; then
                                VAULT_TMP="\$(mktemp)"; chmod 600 "\$VAULT_TMP"
                                printf '%s' "\${VAULT_PASSWORD}" > "\$VAULT_TMP"
                                ARGS+=(--vault-password-file "\$VAULT_TMP")
                            fi
                            if [ -n "\${BOOTSTRAP_BASELINE:-}" ]; then ARGS+=(--bootstrap-baseline "\${BOOTSTRAP_BASELINE}"); fi
                            python3 -m scripts.ai.prodgen --json verify --tree "\${WORKSPACE}/prodtree" --remote origin --jenkins-url "\${JENKINS_URL%/}" \\
                                --report-out prodgen_verify_report.json --source-build-url "\${BUILD_URL}" "\${ARGS[@]}" > prodgen_verify_stdout.json
