                        unstable('[Prodgen Verify] PARTIAL: 필수 검사 중 실행하지 못한 것이 있습니다.\n  기록: prodgen_verify_report.json의 mandatory_missing')
                    } else {
                        env.CI_STAGE_PRODGEN_VERIFY = 'FAIL'
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { error "[Prodgen Verify] FAIL rc=${rc}: production 파일 검사에 실패했습니다.\n  기록: prodgen_verify_report.json" }
                    }
                }
            }
        }

