                        writeFile(file: 'harness_tree_results.json', encoding: 'UTF-8',
                                  text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, functions_src: 'artifact', expected_sha256: env.PRODTREE_PORTAL_SHA256, results: results]))
                        List notPass = results.findAll { it.result != 'SUCCESS' }
                        env.CI_STAGE_HARNESS_TREE = notPass ? 'FAIL' : 'PASS'
