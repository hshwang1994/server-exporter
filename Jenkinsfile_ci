                        echo "[Corpus/Groovy] ${problems ? '[FAIL]' : '[OK]'} ${caseName}: lines=${res.lines.size()} by_origin=${res.report.by_origin} dropped=${res.report.dropped.size()} conflicts=${res.report.conflicts.size()} problems=${problems.size()}"
                        summary << [case: caseName, lines: res.lines.size(), by_origin: res.report.by_origin, problems: problems]
                        allProblems += problems
                    }
                    writeFile(file: 'finalize_corpus_groovy.json', encoding: 'UTF-8',
                              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, cases: summary.size(), mismatches: allProblems.size(), results: summary]))
                    if (allProblems) {
                        corpusOk = false
                        allProblems.each { echo "[Corpus/Groovy] [FAIL] ${it}" }
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Corpus/Groovy] FAIL: 결과 복구(Groovy)가 정답지와 다른 곳이 ${allProblems.size()}건 있습니다.\n  기록: finalize_corpus_groovy.json"
                        }
                    } else {
                        echo "[Corpus/Groovy] [OK] 사례 ${summary.size()}개 모두 결과 복구(Groovy)가 정답지와 같습니다."
                    }
                    // ③ 접수 대상 규칙 (F03) — Jenkinsfile_portal 의 seAcceptTargets 를 떼어 실제 sandbox 에서 사례 표와 대조한다
                    String portalText = readFile(file: 'Jenkinsfile_portal', encoding: 'UTF-8')
                    int fnStart = portalText.indexOf('@NonCPS\nMap seAcceptTargets(')
                    int fnEnd = (fnStart >= 0) ? portalText.indexOf('\n}\n', fnStart) : -1
                    List acceptProblems = []
                    int acceptCases = 0
                    if (fnStart < 0 || fnEnd < 0) {
                        acceptProblems << 'Jenkinsfile_portal 에 seAcceptTargets 가 없다'
                    } else {
                        writeFile(file: 'accept_targets.groovy', encoding: 'UTF-8',
                                  text: 'import com.cloudbees.groovy.cps.NonCPS\n' + portalText.substring(fnStart, fnEnd + 3) + '\nreturn this\n')
                        def acc = load 'accept_targets.groovy'
                        def table = readJSON(file: 'tests/fixtures/input_validation/cases.json', returnPojo: true)
                        acceptCases = table.cases.size()
                        acceptProblems = seAcceptCompare(acc, table.cases)
                    }
                    writeFile(file: 'input_acceptance_groovy.json', encoding: 'UTF-8',
                              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, cases: acceptCases, channels: 3, mismatches: acceptProblems.size(),
                                                                   problems: acceptProblems]))
                    if (acceptProblems) {
                        corpusOk = false
                        acceptProblems.each { echo "[Corpus/Accept] [FAIL] ${it}" }
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Corpus/Accept] FAIL: 입력 접수 규칙이 사례 표와 다른 곳이 ${acceptProblems.size()}건 있습니다.\n  기록: input_acceptance_groovy.json"
                        }
                    } else {
                        echo "[Corpus/Accept] [OK] 사례 ${acceptCases}개를 3개 채널에서 확인했습니다. 입력 접수 규칙이 사례 표와 같습니다."
                    }
                    env.CI_STAGE_CORPUS = corpusOk ? 'PASS' : 'FAIL'
                }
            }
        }

        stage('Time Limits Self-test') {
