        }

        stage('Finalize Corpus') {
            steps {
                script {
                    // ① Python 쪽 — Layer A(scripts/finalize_gather_output.py) 를 corpus 위에서 실제로 실행해 정답지와 대조
                    def rcPy = sh(returnStatus: true, label: 'corpus python', script: '''#!/bin/bash
                        set -o pipefail
                        cd "${WORKSPACE}"
                        . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                        python3 tests/scripts/finalize_corpus_check.py --report-json finalize_corpus_python.json
                    ''')
                    boolean corpusOk = (rcPy == 0)
                    if (rcPy != 0) {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Corpus/Python] finalize_corpus_check.py exit=${rcPy}"
                        }
                    }
                    // ② Groovy 쪽 — Jenkinsfile_portal 이 load 하는 Layer B 함수를 같은 입력 · 같은 정답지로 대조
                    def lib = load 'scripts/jenkins/se_finalize.groovy'
                    def manifests = findFiles(glob: 'tests/fixtures/finalize_corpus/*/gather_manifest.json')
                    if (manifests.length == 0) {
                        error '[Corpus/Groovy] corpus 가 없다 (tests/fixtures/finalize_corpus/*/gather_manifest.json)'
                    }
                    List summary = []
                    List allProblems = []
                    for (int c = 0; c < manifests.length; c++) {
                        String manifestPath = manifests[c].path
                        String caseDir = manifestPath.substring(0, manifestPath.lastIndexOf('/'))
                        String caseName = caseDir.substring(caseDir.lastIndexOf('/') + 1)
                        String manifestJson = readFile(file: manifestPath, encoding: 'UTF-8')
                        String outText = fileExists("${caseDir}/gather_output.json") ? readFile(file: "${caseDir}/gather_output.json", encoding: 'UTF-8') : ''
                        String cpText  = fileExists("${caseDir}/gather_checkpoint.jsonl") ? readFile(file: "${caseDir}/gather_checkpoint.jsonl", encoding: 'UTF-8') : ''
                        String outcome = readFile(file: "${caseDir}/outcome.txt", encoding: 'UTF-8').trim()
                        Map canon = lib.seFallbackCanon()
                        Map res = lib.seReconcileRaw(manifestJson, outText, cpText, canon, outcome)
                        List problems = seCorpusCompare(caseName, res,
                                                        readFile(file: "${caseDir}/expected_final.jsonl", encoding: 'UTF-8'),
                                                        readFile(file: "${caseDir}/expected_report.json", encoding: 'UTF-8'),
                                                        readFile(file: "${caseDir}/expected_origins.json", encoding: 'UTF-8'),
                                                        canon)
                        echo "[Corpus/Groovy] ${problems ? '[FAIL]' : '[OK]'} ${caseName}: lines=${res.lines.size()} by_origin=${res.report.by_origin} dropped=${res.report.dropped.size()} conflicts=${res.report.conflicts.size()} problems=${problems.size()}"
                        summary << [case: caseName, lines: res.lines.size(), by_origin: res.report.by_origin, problems: problems]
                        allProblems += problems
                    }
                    writeFile(file: 'finalize_corpus_groovy.json', encoding: 'UTF-8',
                              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, cases: summary.size(), mismatches: allProblems.size(), results: summary]))
                    if (allProblems) {
                        corpusOk = false
                        allProblems.each { echo "[Corpus/Groovy] [FAIL] ${it}" }
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Corpus/Groovy] Layer B 와 Layer A 정답지가 다르다: ${allProblems.size()}건 (finalize_corpus_groovy.json 참조)"
                        }
                    } else {
                        echo "[Corpus/Groovy] [OK] ${summary.size()} cases — Layer B == Layer A 정답지 (origin 규칙 기준)"
                    }
                    // ③ 접수 대상 규칙 (F03) — Jenkinsfile_portal 의 seAcceptTargets 를 떼어 실제 sandbox 에서 사례 표와 대조한다
                    String portalText = readFile(file: 'Jenkinsfile_portal', encoding: 'UTF-8')
                    int fnStart = portalText.indexOf('@NonCPS\nMap seAcceptTargets(')
                    int fnEnd = (fnStart >= 0) ? portalText.indexOf('\n}\n', fnStart) : -1
                    List acceptProblems = []
                    int acceptCases = 0
                    if (fnStart < 0 || fnEnd < 0) {
                        acceptProblems << 'Jenkinsfile_portal 에 seAcceptTargets 가 없다'
                    } else {
                        writeFile(file: 'accept_targets.groovy', encoding: 'UTF-8',
                                  text: 'import com.cloudbees.groovy.cps.NonCPS\n' + portalText.substring(fnStart, fnEnd + 3) + '\nreturn this\n')
                        def acc = load 'accept_targets.groovy'
                        def table = readJSON(file: 'tests/fixtures/input_validation/cases.json', returnPojo: true)
                        acceptCases = table.cases.size()
                        acceptProblems = seAcceptCompare(acc, table.cases)
                    }
                    writeFile(file: 'input_acceptance_groovy.json', encoding: 'UTF-8',
                              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, cases: acceptCases, channels: 3, mismatches: acceptProblems.size(),
                                                                   problems: acceptProblems]))
                    if (acceptProblems) {
                        corpusOk = false
                        acceptProblems.each { echo "[Corpus/Accept] [FAIL] ${it}" }
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Corpus/Accept] Validate 접수 규칙이 사례 표와 다르다: ${acceptProblems.size()}건 (input_acceptance_groovy.json 참조)"
                        }
                    } else {
                        echo "[Corpus/Accept] [OK] ${acceptCases} cases × 3 channels — Validate 접수 규칙 == inventory 사례 표"
                    }
                    env.CI_STAGE_CORPUS = corpusOk ? 'PASS' : 'FAIL'
                }
            }
        }

        stage('Budget Self-test') {
            steps {
                script {
                    def rc = sh(returnStatus: true, label: 'budget', script: '''#!/bin/bash
                        set -eo pipefail
                        cd "${WORKSPACE}"
                        . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                        # 공식의 단위 테스트(상수 · forks · waves · 남은 시간 절단 · 강제값 · 메모리 보호 · 입력 불량)
                        python3 -m pytest tests/unit/test_gather_budget.py -q -p no:cacheprovider
                        # 이 Runner 의 vCPU · MemAvailable 로 대표 입력 3건을 실제 스크립트에 넣어 결과 JSON 을 남긴다 — 빌드 시작 직후 가정이라 start=true 여야 한다
                        : > budget_selftest.jsonl
                        now="$(date +%s)"
                        for spec in "os 3" "esxi 50" "redfish 200"; do
                            set -- $spec
                            out="$(SE_NOW_EPOCH="$now" SE_BUILD_START_EPOCH="$now" SE_STAGE_START_EPOCH="$now" SE_CHANNEL="$1" SE_HOSTS="$2" SE_VCPU="$(nproc 2>/dev/null || echo 2)" bash scripts/gather_budget.sh)"
                            echo "$out" | tee -a budget_selftest.jsonl
                            echo "$out" | grep -q '"start":true' || { echo "[Budget] start=false for channel=$1 hosts=$2"; exit 1; }
                        done
                    ''')
                    env.CI_STAGE_BUDGET = (rc == 0) ? 'PASS' : 'FAIL'
                    if (rc != 0) {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { error "[Budget] self-test rc=${rc}" }
                    }
                }
            }
        }

        stage('Harness Driver') {
