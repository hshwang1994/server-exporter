// corpus 대조 규칙 — Layer B(seReconcileRaw) 결과를 Layer A 정답지와 origin 별로 비교한다 (Python 쪽은 tests/scripts/finalize_corpus_check.py).
//   output     : 줄 원문이 같다 (두 Layer 모두 OUTPUT 줄을 재직렬화하지 않는다)
//   checkpoint : errors 를 뺀 12 필드가 같고 기존 errors 도 같다. 덧붙인 마지막 1건만 Layer 별 사유다 (Layer B 는 section gather + canon.emitFailed)
//   synthetic  : 뼈대(schema_version…data 11 필드)가 같다. 진단은 Layer A 가 progress 로 세분하므로(§6-4) Layer A 도
//                OUTPUT_BUILD_FAILED 일 때만 failure_reason · errors[0].section 까지 대조한다
//   report     : by_origin · kept · filled 같음. dropped 는 file:line 집합(Layer A 의 corrupt_lines · truncated_tail 포함), conflicts 는 ip:chosen 집합
//   JSON 은 양쪽 모두 groovy.json.JsonSlurper 로 읽어 비교한다(Classic 변형 생성자는 sandbox 거부 — 2026-10-03 실측) — Groovy JsonOutput 의
//   \\uXXXX escaping 과 Python 의 ensure_ascii=False 는 값이 같다.
@NonCPS
List seCorpusCompare(String caseName, Map res, String expectedFinal, String expectedReport, String expectedOrigins, Map canon) {
    def slurper = new groovy.json.JsonSlurper()
    List problems = []
    List expLines = expectedFinal.split('\n').findAll { it.trim() }.collect { it.trim() }
    List origins = slurper.parseText(expectedOrigins)
    Map expRep = slurper.parseText(expectedReport)
    List gotLines = res.lines
    Map gotRep = res.report
    int accepted = (expRep.accepted ?: 0) as int
    if (gotLines.size() != accepted || expLines.size() != accepted || origins.size() != accepted) {
        problems << "${caseName}: cardinality got=${gotLines.size()} expected=${expLines.size()} origins=${origins.size()} accepted=${accepted}".toString()
        return problems
    }
    List skeleton = ['schema_version', 'target_type', 'collection_method', 'ip', 'hostname', 'vendor', 'status', 'sections', 'meta', 'correlation', 'data']
    for (int i = 0; i < accepted; i++) {
        String tag = "${caseName}[${i}]".toString()
        String origin = origins[i]
        def got = slurper.parseText(gotLines[i])
        def exp = slurper.parseText(expLines[i])
        if (got.ip != exp.ip) { problems << "${tag}: ip ${got.ip} != ${exp.ip}".toString(); continue }
        if ((got.keySet() as List) != (exp.keySet() as List)) { problems << "${tag}: envelope key order ${got.keySet()}".toString() }
        if (origin == 'output') {
            if (gotLines[i] != expLines[i]) { problems << "${tag}: OUTPUT line is not verbatim".toString() }
        } else if (origin == 'checkpoint') {
            for (String k in skeleton) { if (got[k] != exp[k]) { problems << "${tag}: checkpoint field ${k} differs".toString() } }
            if (got.diagnosis != exp.diagnosis) { problems << "${tag}: checkpoint diagnosis differs".toString() }
            List ge = (got.errors instanceof List) ? got.errors : []
            List ee = (exp.errors instanceof List) ? exp.errors : []
            if (ge.size() != ee.size() || ge.isEmpty()) {
                problems << "${tag}: errors size ${ge.size()} != ${ee.size()}".toString()
            } else {
                for (int j = 0; j < ge.size() - 1; j++) { if (ge[j] != ee[j]) { problems << "${tag}: errors[${j}] differs".toString() } }
                def last = ge[ge.size() - 1]
                if (last.section != 'gather' || last.message != canon.emitFailed) { problems << "${tag}: Layer B appended error is not gather/emitFailed".toString() }
                if (!(ee[ee.size() - 1].section in ['gather', 'addon'])) { problems << "${tag}: Layer A appended error section ${ee[ee.size() - 1].section}".toString() }
            }
        } else if (origin == 'synthetic') {
            for (String k in skeleton) { if (got[k] != exp[k]) { problems << "${tag}: synthetic field ${k} differs".toString() } }
            if ((got.sections.keySet() as List) != (exp.sections.keySet() as List)) { problems << "${tag}: sections order".toString() }
            def gd = got.diagnosis
            def ed = exp.diagnosis
            if (gd.details?.finalizer != 'layer_b' || gd.failure_stage != 'fallback' || gd.failure_code != 'OUTPUT_BUILD_FAILED') {
                problems << "${tag}: Layer B diagnosis ${gd.failure_stage}/${gd.failure_code}/${gd.details?.finalizer}".toString()
            }
            if (ed.details?.finalizer != 'layer_a') { problems << "${tag}: expected line is not a Layer A synthetic envelope".toString() }
            if (!(got.errors instanceof List) || got.errors.size() != 1 || got.errors[0].message != gd.failure_reason) {
                problems << "${tag}: Layer B errors[] must be one entry echoing failure_reason".toString()
            }
            if (ed.failure_code == 'OUTPUT_BUILD_FAILED') {
                if (gd.failure_reason != ed.failure_reason) { problems << "${tag}: failure_reason differs (fallback catalog drift)".toString() }
                if (got.errors[0].section != exp.errors[0].section) { problems << "${tag}: errors[0].section ${got.errors[0].section} != ${exp.errors[0].section}".toString() }
            }
        } else {
            problems << "${tag}: unknown origin '${origin}'".toString()
        }
    }
    if (gotRep.by_origin != expRep.by_origin) { problems << "${caseName}: by_origin ${gotRep.by_origin} != ${expRep.by_origin}".toString() }
    if ((gotRep.kept as int) != (expRep.kept as int) || (gotRep.filled as int) != (expRep.filled as int)) {
        problems << "${caseName}: kept/filled ${gotRep.kept}/${gotRep.filled} != ${expRep.kept}/${expRep.filled}".toString()
    }
    Set gotDropped = gotRep.dropped.collect { "${it.file}:${it.line}".toString() } as Set
    List expDroppedAll = (expRep.dropped ?: []) + (expRep.corrupt_lines ?: []) + (expRep.truncated_tail ?: [])
    Set expDropped = expDroppedAll.findAll { it.file in ['output', 'checkpoint'] }.collect { "${it.file}:${it.line}".toString() } as Set
    if (gotDropped != expDropped) { problems << "${caseName}: dropped ${gotDropped} != ${expDropped}".toString() }
    Set gotConf = gotRep.conflicts.collect { "${it.ip}:${it.chosen}".toString() } as Set
    Set expConf = (expRep.conflicts ?: []).collect { "${it.ip}:${it.chosen}".toString() } as Set
    if (gotConf != expConf) { problems << "${caseName}: conflicts ${gotConf} != ${expConf}".toString() }
    return problems
}

// 접수 대상 규칙 대조 (2026-10-05 F03) — Jenkinsfile_portal 의 seAcceptTargets 를 사례 표(tests/fixtures/input_validation/cases.json)로 돌린다.
//   같은 표로 inventory.sh 3종(Python)은 Gate 의 pytest(tests/unit/test_input_acceptance_parity.py)가 돌린다 — 두 쪽 결과가 표와 같으면
//   Validate 와 inventory 가 같은 요청을 같은 규칙으로 받아들이거나 거부한다. 'PRIMARY' · 'OTHER' 키는 채널별 주 필드로 바꿔 넣는다.
@NonCPS
List seAcceptCompare(def acc, List cases) {
    Map primary = [os: 'service_ip', esxi: 'service_ip', redfish: 'bmc_ip']
    Map other = [os: 'bmc_ip', esxi: 'bmc_ip', redfish: 'service_ip']
    List problems = []
    for (String ch in ['os', 'esxi', 'redfish']) {
        for (Object c in cases) {
            def inv = c.inventory
            if (inv instanceof List) {
                List renamed = []
                for (Object h in inv) {
                    if (h instanceof Map) {
                        Map m = [:]
                        for (Object k in h.keySet()) { m[(k == 'PRIMARY' ? primary[ch] : (k == 'OTHER' ? other[ch] : k))] = h[k] }
                        renamed << m
                    } else {
                        renamed << h
                    }
                }
                inv = renamed
            } else if (inv instanceof Map) {
                Map m = [:]
                for (Object k in inv.keySet()) { m[(k == 'PRIMARY' ? primary[ch] : (k == 'OTHER' ? other[ch] : k))] = inv[k] }
                inv = m
            }
            Map res = acc.seAcceptTargets(inv, ch)
            boolean ok = c.containsKey('accept') ? (res.ips == c.accept && !res.error) : (res.error && res.ips == null)
            if (!ok) { problems << "${ch}/${c.name}: got ${res} expected ${c.containsKey('accept') ? c.accept : 'reject ' + c.reject}".toString() }
        }
    }
    return problems
}

// Harness Job 을 시나리오별로 돌리고 결과 목록을 돌려준다 (별도 Job → disableConcurrentBuilds 아래에서도 교착 없음, 시나리오당 빌드 1개 = 격리).
//   기대 Jenkins 결과는 scenarios.json 의 jenkins_result(기본 SUCCESS) — user_abort 는 ABORTED 로 끝나는 것이 정상이다 (검토 C1·C5).
def seRunHarness(String functionsSrc, List scenarios, Map extra) {
    def defs = readJSON(file: 'tests/jenkins/harness/scenarios.json', returnPojo: true).scenarios
    List results = []
    for (String s in scenarios) {
        List ps = [string(name: 'SCENARIO', value: s), string(name: 'MAIN_SHA', value: env.MAIN_SHA), string(name: 'FUNCTIONS_SRC', value: functionsSrc)]
        extra.each { k, v -> ps << (k == 'BOUNDED' ? booleanParam(name: k, value: (v.toString() == 'true')) : string(name: k, value: v.toString())) }
        String expected = (defs[s]?.jenkins_result ?: 'SUCCESS').toString()
        def b = build(job: 'clovirone-cicd/clovirone-server-gather-harness', wait: true, propagate: false, parameters: ps)
        boolean ok = (b.result == expected)
        results << [scenario: s, number: b.number, result: b.result, expected: expected, ok: ok, url: b.absoluteUrl, functions_src: functionsSrc,
                    bounded: (extra.BOUNDED?.toString() == 'true')]
        echo "[Harness/${functionsSrc}${extra.BOUNDED ? '/bounded' : ''}] ${s}: #${b.number} ${b.result} (expected ${expected}) ${b.absoluteUrl}"
    }
    return results
}

// stage 결과 파일 — post 가 마지막에 쓰고, Promote 는 prodgen promote 를 부르기 **전**에 한 번 더 써서 --ci-stage-results 로 넘긴다 (검토 C4)
def seWriteStageResults() {
    Map stages = [:]
    for (String k in ['GATE', 'CORPUS', 'BUDGET', 'HARNESS_MAIN', 'HARNESS_BOUNDED', 'PRODGEN_BUILD', 'HARNESS_TREE', 'PRODGEN_DRIFT', 'PRODGEN_VERIFY', 'VAULT_DECRYPT', 'EVIDENCE', 'PROMOTE']) {
        stages[k] = env."CI_STAGE_${k}" ?: 'not_run'
    }
    writeFile(file: 'ci_stage_results.json', encoding: 'UTF-8',
              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, build_url: env.BUILD_URL, result: currentBuild.currentResult, stages: stages]))
    return stages
}

pipeline {

    agent { label 'linux' }

    options {
        disableConcurrentBuilds()
        timeout(time: 150, unit: 'MINUTES')
        skipDefaultCheckout(true)              // Checkout stage 가 한 번만 받고 GIT_COMMIT 을 MAIN_SHA 로 고정한다
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    parameters {
        booleanParam(name: 'PROMOTE', defaultValue: false, description: 'true 이면 Prodgen Promote stage 가 승격 집행 조건(6항)을 확인한다 — 기본 false')
        string(name: 'PROMOTE_SHA', defaultValue: '', description: '승격 요청 SHA — env.MAIN_SHA · 보고서 binding.main_sha · rev-parse HEAD 와 모두 같아야 한다')
        booleanParam(name: 'PROMOTE_DRY_RUN', defaultValue: true, description: 'true 이면 원격을 바꾸지 않는다(기본). 실 승격은 false + 양 원격 credential 준비')
        string(name: 'BOOTSTRAP_BASELINE', defaultValue: '', description: '최초 승격(legacy production) 의 baseline SHA — drift-check/verify/promote 가 같은 값을 쓴다. 정상 승격은 비운다')
        string(name: 'HARNESS_SCENARIOS', defaultValue: 'normal_success,archive_fail,stash_fail,both_fail,truncate_jsonl,checkpoint_only_a,checkpoint_only_b,layer_a_fail,raw_fallback,report_corrupt,sink_5xx,outer_timeout,recover_slow,foreign_timeout_interruption,user_abort,aborted_outcome_finalize,archive_slow,layer_a_read_slow',
               description: 'Harness Driver 가 main checkout 의 함수로 순서대로 돌릴 시나리오(쉼표). 비우면 건너뛴다(PARTIAL)')
        string(name: 'HARNESS_BOUNDED_SCENARIOS', defaultValue: 'inner_recover_timeout,inner_assemble_timeout,inner_archive_timeout,inner_stash_timeout,inner_layer_a_read_timeout',
               description: 'Tier 2(SE_FINALIZER_BOUNDED=true) 시나리오 — BOUNDED=true 로 돌린다. 승인 4 시그니처가 없으면 PARTIAL/승인 으로 남고 승격 조건이 아니다')
        string(name: 'HARNESS_TREE_SCENARIOS', defaultValue: 'normal_success,archive_fail,stash_fail,both_fail,truncate_jsonl,checkpoint_only_a,checkpoint_only_b,layer_a_fail,raw_fallback,report_corrupt',
               description: '생성 tree(prodtree.tar.gz)의 함수로 돌릴 시나리오(쉼표) — 2026-10-04 최종 지시 §6-1: 보존 실패 경로(archive_fail · stash_fail · truncate_jsonl · checkpoint_only_a/b · layer_a_fail)도 생성 tree 에서. 비우면 건너뛴다(PARTIAL)')
        string(name: 'E2E_MAIN_ENTRIES', defaultValue: '', description: 'main Job 시나리오 증거 — SCENARIO=job/path:build[:EXPECTED] 를 쉼표로 (예: S1=clovirone-cicd/clovirone-server-gather-main:7,T6=clovirone-cicd/clovirone-server-gather-main:9:UNSTABLE)')
        booleanParam(name: 'REQUIRE_BOUNDED', defaultValue: true,
                     description: '사내 Jenkins 는 2026-10-05 부터 SE_FINALIZER_BOUNDED=true(Script Approval 4 서명 승인 · bounded Harness 5/5 PASS 뒤) — Tier 2 Harness(HARNESS_BOUNDED) 를 승격 조건으로 요구하고 prodgen promote 에 --require-bounded 를 넘긴다. 그 모드를 끈 배포면 false')
        text(name: 'E2E_TIP_OBSERVATIONS_JSON', defaultValue: '',
             description: '2026-10-04 최종 지시 §5 — fail-closed 빌드(E2E-A2)의 직접 revision 증거: 트리거 측이 빌드 전후에 읽은 Job SCM tip. JSON {"observations":[{"job","build","sha_before","sha_after","before_epoch","after_epoch","remote","method"}]}. 비우면 이웃 빌드 추정만 남고 그 시나리오는 승격 증거로 인정되지 않는다')
    }

    environment {
        PYTHONDONTWRITEBYTECODE       = '1'
        PYTHONUTF8                    = '1'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        GIT_TERMINAL_PROMPT           = '0'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    def scmVars = checkout scm
                    env.MAIN_SHA = (scmVars?.GIT_COMMIT ?: '').toString()
                    if (!env.MAIN_SHA) {
                        env.MAIN_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    }
                    env.MAIN_BRANCH = (scmVars?.GIT_BRANCH ?: '').toString()
                    currentBuild.description = "main@${env.MAIN_SHA.length() >= 10 ? env.MAIN_SHA.substring(0, 10) : env.MAIN_SHA}"
                    echo "[Checkout] MAIN_SHA=${env.MAIN_SHA} branch=${env.MAIN_BRANCH ?: '-'} (Job 의 Branch Specifier 가 */main 이어야 한다 — main 전용 CI)"
                }
            }
        }

        stage('Toolchain') {
            steps {
                sh(label: 'toolchain', script: '''#!/bin/bash
                    set -eo pipefail
                    cd "${WORKSPACE}"
                    {
                        echo "MAIN_SHA=${MAIN_SHA:-}"
                        echo "node=$(hostname) nproc=$(nproc 2>/dev/null || echo '?') kernel=$(uname -r)"
                        # venv 선택은 scripts/activate_ansible_venv.sh 한 곳 — 실패하면 set -e 로 여기서 멈춘다 (시스템 python 으로 조용히 진행하지 않는다)
                        . "${WORKSPACE}/scripts/activate_ansible_venv.sh"
                        echo "venv=${VIRTUAL_ENV:-}"
                        echo "python3=$(command -v python3) $(python3 --version 2>&1)"
                        python3 -c 'import yaml; print("pyyaml=" + yaml.__version__)'
                        python3 -m pytest --version 2>&1 | head -1 || echo "pytest=absent (ci_gate 가 PARTIAL 로 보고한다)"
                        ansible-playbook --version 2>/dev/null | head -1 || echo "ansible-playbook=absent (ci_gate 가 syntax-check 를 건너뛴다)"
                        # GP-4: esxi 라벨 전제 — 이 venv 에서 pyVmomi 와 community.vmware 가 import 되는지 (보고만 한다, 라벨은 붙이지 않는다)
                        python3 -c 'import pyVmomi; print("pyvmomi=" + getattr(pyVmomi, "__version__", "present"))' 2>/dev/null || echo "pyvmomi=absent (esxi 라벨 전제 미충족)"
                        ansible-galaxy collection list 2>/dev/null | grep -E '^community[.]vmware ' | sed 's/^/collection=/' || echo "community.vmware=absent"
                        echo "bash=${BASH_VERSION}"
                        echo "git=$(git --version)"
                        # pwsh: prodgen 의 PowerShell 주석 검증에 필요(GP-16). 없으면 사용자 권한으로 $HOME/.local/powershell 에 준비한다 — 시스템 변경 없음.
                        eval "$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                        if command -v pwsh >/dev/null 2>&1; then
                            echo "pwsh=$(pwsh -NoLogo -NoProfile -NonInteractive -Command '$PSVersionTable.PSVersion.ToString()' 2>/dev/null || echo present) ($(command -v pwsh))"
                        else
                            echo "pwsh=absent (bootstrap failed — Prodgen Build 는 PowerShell 주석을 class B 로 보고하고 FAIL 한다)"
                        fi
                        echo "groovy=$(command -v groovy >/dev/null 2>&1 && groovy --version 2>&1 | head -1 || echo absent)"
                    } 2>&1 | tee toolchain.txt
                ''')
