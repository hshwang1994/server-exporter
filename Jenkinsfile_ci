                            rc = verifyBody('no', 'no')
                        }
                    }
                    String vrc = fileExists('vault_decrypt_rc.txt') ? readFile(file: 'vault_decrypt_rc.txt', encoding: 'UTF-8').trim() : '3'
                    env.CI_STAGE_VAULT_DECRYPT = (vrc == '0') ? 'PASS' : ((vrc == '3') ? 'PARTIAL' : 'FAIL')
                    if (vrc == '0') {
