        stage('Prodgen Drift') {
            steps {
                script {
                    def rc = sh(returnStatus: true, label: 'prodgen drift', script: '''#!/bin/bash
                        set -o pipefail
                        cd "${WORKSPACE}"
                        . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                        eval "$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                        git fetch -q origin "+refs/heads/production:refs/remotes/origin/production" || { echo '{"ok": false, "error": "fetch origin production failed"}' > prodgen_drift.json; exit 3; }
                        # CI checkout 에는 로컬 production ref 가 없다 — G20/promote 는 "로컬 == 양 원격" 을 본다(CI #3: local absent). 원격 값으로 만든다(이 workspace 한정).
                        git update-ref refs/heads/production "$(git rev-parse refs/remotes/origin/production)"
                        BOOT=()
                        if [ -n "${BOOTSTRAP_BASELINE:-}" ]; then BOOT=(--bootstrap-baseline "${BOOTSTRAP_BASELINE}"); fi
                        python3 -m scripts.ai.prodgen --json drift-check --production refs/remotes/origin/production "${BOOT[@]}" > prodgen_drift.json
                    ''')
                    env.CI_STAGE_PRODGEN_DRIFT = (rc == 0) ? 'PASS' : 'FAIL'
                    if (rc != 0) {
                        def mode = ''
                        try { mode = readJSON(file: 'prodgen_drift.json', returnPojo: true).mode ?: '' } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) { throw fie } catch (Exception e) { mode = '?' }
                        unstable("[Prodgen Drift] 현재 origin/production 상태 ${mode} 는 승격 가능 상태가 아니다 (LEGACY 는 BOOTSTRAP_BASELINE=<그 sha> 로만) — prodgen_drift.json")
                    }
                }
            }
        }

        stage('Prodgen Verify') {
            when { expression { env.CI_STAGE_PRODGEN_BUILD == 'PASS' } }
            steps {
                script {
                    // G13(Jenkins 린터) 토큰과 G19(vault) 암호는 **이 stage 안에서만** 바인딩한다. 둘 다 mktemp 0600 파일로 넘기고 trap 으로 지운다.
                    //   어느 쪽 credential 이 없으면 그 gate 는 SKIP → verdict PARTIAL(통과 아님) 로 남는다 — 거부가 아니라 사실 그대로다.
                    boolean haveLint = true
                    boolean haveVault = true
                    def verifyBody = { String netrcArg, String vaultArg ->
                        return sh(returnStatus: true, label: 'prodgen verify', script: """#!/bin/bash
                            set -o pipefail
                            set +x
                            cd "\${WORKSPACE}"
                            . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                            eval "\$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                            NETRC_TMP=""; VAULT_TMP=""
                            trap 'rm -f "\$NETRC_TMP" "\$VAULT_TMP"' EXIT
                            ARGS=()
                            if [ "${netrcArg}" = "yes" ]; then
                                NETRC_TMP="\$(mktemp)"; chmod 600 "\$NETRC_TMP"
                                printf 'machine %s login %s password %s\\n' "\$(echo "\${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "\${LINT_USER}" "\${LINT_TOKEN}" > "\$NETRC_TMP"
                                ARGS+=(--netrc "\$NETRC_TMP")
                            fi
                            if [ "${vaultArg}" = "yes" ]; then
                                VAULT_TMP="\$(mktemp)"; chmod 600 "\$VAULT_TMP"
                                printf '%s' "\${VAULT_PASSWORD}" > "\$VAULT_TMP"
                                ARGS+=(--vault-password-file "\$VAULT_TMP")
                            fi
                            if [ -n "\${BOOTSTRAP_BASELINE:-}" ]; then ARGS+=(--bootstrap-baseline "\${BOOTSTRAP_BASELINE}"); fi
                            python3 -m scripts.ai.prodgen --json verify --tree "\${WORKSPACE}/prodtree" --remote origin --jenkins-url "\${JENKINS_URL%/}" \\
                                --report-out prodgen_verify_report.json --source-build-url "\${BUILD_URL}" "\${ARGS[@]}" > prodgen_verify_stdout.json
                            rc=\$?
                            # 검토 C6: 같은 정식 바인딩으로 vault 전 파일(ic·cj·yi·git)을 실제 복호화하고 accounts 구조를 검사한다 — 평문·username 미출력(도구 계약).
                            #   G19 의 TEST-NET 실행은 precheck 에서 끝나 credential 을 열지 않으므로 복호화 증거가 아니다. 이 검사가 그 증거다.
                            if [ "${vaultArg}" = "yes" ]; then
                                python3 scripts/ai/vault_decrypt_check.py --password-file "\$VAULT_TMP" > vault_decrypt_check.txt 2>&1
                                echo "\$?" > vault_decrypt_rc.txt
                            else
                                echo "skipped: vault credential not bound" > vault_decrypt_check.txt; echo 3 > vault_decrypt_rc.txt
                            fi
                            exit "\$rc"
                        """)
                    }
                    int rc = -1
                    try {
                        withCredentials([usernamePassword(credentialsId: 'se-jenkins-lint', usernameVariable: 'LINT_USER', passwordVariable: 'LINT_TOKEN'),
                                         string(credentialsId: 'server-gather-vault-password', variable: 'VAULT_PASSWORD')]) {
                            rc = verifyBody('yes', 'yes')
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (Exception e) {
                        // credential 부재(CredentialNotFoundException 등) — 린터 토큰 없이 vault 만으로 다시 시도한다 (G13 SKIP → PARTIAL)
                        haveLint = false
                        echo "[Prodgen Verify] 린터 credential(se-jenkins-lint) 바인딩 실패 — G13 없이 실행 (PARTIAL 로 남는다): ${e.getClass().simpleName}"
                        try {
                            withCredentials([string(credentialsId: 'server-gather-vault-password', variable: 'VAULT_PASSWORD')]) {
                                rc = verifyBody('no', 'yes')
                            }
                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie2) {
                            throw fie2
                        } catch (Exception e2) {
                            haveVault = false
                            echo "[Prodgen Verify] vault credential 바인딩 실패 — G19 없이 실행 (PARTIAL): ${e2.getClass().simpleName}"
                            rc = verifyBody('no', 'no')
                        }
                    }
                    String vrc = fileExists('vault_decrypt_rc.txt') ? readFile(file: 'vault_decrypt_rc.txt', encoding: 'UTF-8').trim() : '3'
                    env.CI_STAGE_VAULT_DECRYPT = (vrc == '0') ? 'PASS' : ((vrc == '3') ? 'PARTIAL' : 'FAIL')
                    if (vrc == '0') {
                        echo "[Vault] 복호화·구조 검증 PASS — vault_decrypt_check.txt (secret 미출력)"
                    } else if (vrc == '3') {
                        echo '[Vault] 복호화 검증 미실행 — vault credential 바인딩 없음 (PARTIAL)'
                    } else {
                        unstable("[Vault] 복호화 또는 구조 검증 FAIL (rc=${vrc}) — vault_decrypt_check.txt")
                    }
                    writeFile(file: 'prodgen_verify_env.json', encoding: 'UTF-8', text: groovy.json.JsonOutput.toJson([lint_credential: haveLint, vault_credential: haveVault, rc: rc, vault_decrypt_rc: vrc]))
                    if (rc == 0) {
                        env.CI_STAGE_PRODGEN_VERIFY = 'PASS'
                        echo '[Prodgen Verify] COMPLETE_PASS'
                    } else if (rc == 2) {
                        env.CI_STAGE_PRODGEN_VERIFY = 'PARTIAL'
                        unstable('[Prodgen Verify] PARTIAL — 필수 gate 가 빠졌거나 SKIP (prodgen_verify_report.json 의 mandatory_missing)')
                    } else {
                        env.CI_STAGE_PRODGEN_VERIFY = 'FAIL'
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { error "[Prodgen Verify] FAIL rc=${rc} — prodgen_verify_report.json" }
                    }
                }
            }
        }

        stage('Evidence Aggregate') {
            when { expression { env.CI_STAGE_PRODGEN_VERIFY in ['PASS', 'PARTIAL'] } }
            steps {
                script {
                    // 이 빌드의 Harness 결과 + 파라미터로 받은 main Job 시나리오 빌드를 구조화 증거로 모아 보고서에 붙인다(digest 재계산).
                    //   Jenkins 조회에는 린터 토큰(읽기)을 쓴다 — 없으면 집계를 건너뛰고 PARTIAL 로 남긴다.
                    List entries = []
                    for (String f in ['harness_main_results.json', 'harness_tree_results.json', 'harness_bounded_results.json']) {
                        if (fileExists(f)) {
                            def r = readJSON(file: f, returnPojo: true)
                            for (def hr in (r.results ?: [])) { entries << "${hr.scenario}=clovirone-cicd/clovirone-server-gather-harness:${hr.number}".toString() }
                        }
                    }
                    for (String ent in params.E2E_MAIN_ENTRIES.split(',').collect { it.trim() }.findAll { it }) { entries << ent }
                    if (!entries) {
                        env.CI_STAGE_EVIDENCE = 'PARTIAL'
                        unstable('[Evidence] 수집할 증거 항목이 없다 (Harness 결과 없음 · E2E_MAIN_ENTRIES 비어 있음)')
                    } else {
                        writeFile(file: 'e2e_entries.txt', encoding: 'UTF-8', text: entries.join('\n') + '\n')
                        if (params.E2E_TIP_OBSERVATIONS_JSON?.trim()) {
                            writeFile(file: 'e2e_tip_observations.json', encoding: 'UTF-8', text: params.E2E_TIP_OBSERVATIONS_JSON.trim() + '\n')
                        }
                        int rc = -1
                        try {
                            withCredentials([usernamePassword(credentialsId: 'se-jenkins-lint', usernameVariable: 'LINT_USER', passwordVariable: 'LINT_TOKEN')]) {
                                rc = sh(returnStatus: true, label: 'evidence', script: '''#!/bin/bash
                                    set -o pipefail
                                    set +x
                                    cd "${WORKSPACE}"
                                    . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                                    NETRC_TMP="$(mktemp)"; chmod 600 "$NETRC_TMP"
                                    trap 'rm -f "$NETRC_TMP"' EXIT
                                    printf 'machine %s login %s password %s\\n' "$(echo "${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "${LINT_USER}" "${LINT_TOKEN}" > "$NETRC_TMP"
                                    ARGS=()
                                    while IFS= read -r line; do [ -n "$line" ] && ARGS+=(--entry "$line"); done < e2e_entries.txt
                                    # §5: 트리거 측 tip 관측(있을 때만) — fail-closed 빌드의 직접 바인딩. [Trusted] 내용 대조는 이 workspace 의 git 객체로 한다.
                                    if [ -f e2e_tip_observations.json ]; then ARGS+=(--tip-observations e2e_tip_observations.json); fi
                                    python3 -m scripts.ai.prodgen --json e2e-evidence --jenkins-url "${JENKINS_URL%/}" --netrc "$NETRC_TMP" "${ARGS[@]}" --out e2e_evidence.json > e2e_evidence_stdout.json
                                    python3 -m scripts.ai.prodgen --json evidence-aggregate --report prodgen_verify_report.json --evidence e2e_evidence.json --out prodgen_verify_report.aggregated.json > evidence_aggregate_stdout.json
                                ''')
                            }
                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                            throw fie
                        } catch (Exception e) {
                            echo "[Evidence] Jenkins 읽기 credential(se-jenkins-lint) 없음 — 증거 집계 생략: ${e.getClass().simpleName}"
                        }
                        env.CI_STAGE_EVIDENCE = (rc == 0) ? 'PASS' : 'PARTIAL'
                        if (rc != 0) { unstable('[Evidence] 증거 집계 미완료 — Promote 는 집계된 보고서가 없으면 원격을 바꾸지 않는다') }
                    }
                }
            }
        }

        stage('Prodgen Promote') {
            when { expression { params.PROMOTE } }
            steps {
                script {
                    // 승격 집행 조건 6항 (Astra 3차 §8-2) — 하나라도 빠지면 원격 변경 0. `branch` 조건은 쓰지 않는다(일반 Pipeline).
                    List required = ['GATE', 'CORPUS', 'BUDGET', 'HARNESS_MAIN', 'PRODGEN_BUILD', 'HARNESS_TREE', 'PRODGEN_DRIFT', 'PRODGEN_VERIFY', 'EVIDENCE']
                    // 상한 모드를 켠 배포(사내 Jenkins, 2026-10-05~) — docs/operate/09 §3. 파라미터가 Job 에 등록되기 전 첫 빌드는 값이 null 이므로
                    //   선언한 기본값(true)으로 본다. stage 목록과 prodgen 플래그가 같은 값을 쓴다.
                    boolean requireBounded = (params.REQUIRE_BOUNDED != false)
                    echo "[Promote] require_bounded=${requireBounded}"
                    if (requireBounded) { required << 'HARNESS_BOUNDED' }
                    List bad = required.findAll { (env."CI_STAGE_${it}" ?: 'not_run') != 'PASS' }.collect { "${it}=${env."CI_STAGE_${it}" ?: 'not_run'}".toString() }
                    if (bad) { error "[Promote] 필수 stage 미통과 — 원격 변경 0: ${bad}" }
                    if (!fileExists('prodgen_verify_report.aggregated.json')) { error '[Promote] 집계된 검증 보고서가 없다 — 원격 변경 0' }
                    seWriteStageResults()          // prodgen promote 가 같은 stage 증거를 --ci-stage-results 로 다시 확인한다 (검토 C4)
                    def report = readJSON(file: 'prodgen_verify_report.aggregated.json', returnPojo: true)
                    String head = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String want = params.PROMOTE_SHA?.trim()
                    if (!(want && want == env.MAIN_SHA && env.MAIN_SHA == head && report.binding?.main_sha == head)) {
                        error "[Promote] SHA 4값 불일치 — PROMOTE_SHA=${want} MAIN_SHA=${env.MAIN_SHA} HEAD=${head} report=${report.binding?.main_sha} — 원격 변경 0"
                    }
                    if (report.verdict != 'COMPLETE_PASS') { error "[Promote] 보고서 verdict ${report.verdict} — COMPLETE_PASS 만 승격 — 원격 변경 0" }
                    // 양 원격 credential 이 모두 있어야 실 승격. GitLab 자격이 없으면 dry-run 으로만 (알려진 자격 부재로 GitHub 만 먼저 바꾸지 않는다 — §8-1)
                    boolean haveGitlab = true
                    try {
                        withCredentials([usernamePassword(credentialsId: 'se-gitlab-push', usernameVariable: 'PRODGEN_GIT_USER_GITLAB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITLAB')]) {
                            echo '[Promote] GitLab push credential 확인'
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (Exception e) {
                        haveGitlab = false
                        echo "[Promote] GitLab push credential(se-gitlab-push) 없음 — 실 승격 불가, dry-run 으로만 진행: ${e.getClass().simpleName}"
                    }
                    boolean dryRun = params.PROMOTE_DRY_RUN || !haveGitlab
                    String remotes = haveGitlab ? 'origin,internal' : 'origin'
                    // 린터 토큰(G13 · jenkins_version 포착) 과 vault 암호(G19) 도 Promote 에 바인딩한다 — 없으면 promote 가 환경을 "미확인" 으로 보고
                    //   환경 의존 gate 를 재실행하는데 자격이 없어 G13/G19 가 SKIP → PARTIAL 이 된다 (CI #10 dry-run 실측). 임시 파일은 mktemp 0600 + trap.
                    def promoteBody = { String credArg ->
                        return sh(returnStatus: true, label: 'prodgen promote', script: """#!/bin/bash
                            set -o pipefail
                            set +x
                            cd "\${WORKSPACE}"
                            . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                            eval "\$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                            export GIT_ASKPASS="\${WORKSPACE}/scripts/ai/prodgen/git_askpass.sh"
                            chmod +x "\$GIT_ASKPASS"
                            NETRC_TMP=""; VAULT_TMP=""
                            trap 'rm -f "\$NETRC_TMP" "\$VAULT_TMP"' EXIT
                            CRED_ARGS=()
                            if [ "${credArg}" = "yes" ]; then
                                NETRC_TMP="\$(mktemp)"; chmod 600 "\$NETRC_TMP"
                                printf 'machine %s login %s password %s\\n' "\$(echo "\${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "\${LINT_USER}" "\${LINT_TOKEN}" > "\$NETRC_TMP"
                                VAULT_TMP="\$(mktemp)"; chmod 600 "\$VAULT_TMP"
                                printf '%s' "\${VAULT_PASSWORD}" > "\$VAULT_TMP"
                                CRED_ARGS+=(--netrc "\$NETRC_TMP" --vault-password-file "\$VAULT_TMP" --jenkins-url "\${JENKINS_URL%/}")
                            fi
                            if [ "${haveGitlab}" = "true" ]; then
                                git remote get-url internal >/dev/null 2>&1 || git remote add internal https://10.100.64.156/root/server-expoter.git
                                git config "http.https://10.100.64.156/.sslVerify" false      # URL 범위 설정 — 전역 설정이 아니다
                            fi
                            ARGS=(--push-remote "${remotes}" --verify-report prodgen_verify_report.aggregated.json --e2e-evidence e2e_evidence.json \\
                                  --ci-stage-results ci_stage_results.json --ci-build "\${BUILD_URL}" --source-build-url "\${BUILD_URL}" "\${CRED_ARGS[@]}")
                            if [ -n "\${BOOTSTRAP_BASELINE:-}" ]; then ARGS+=(--bootstrap-baseline "\${BOOTSTRAP_BASELINE}"); fi
                            if [ "${dryRun}" = "true" ]; then ARGS+=(--dry-run); fi
                            if [ "${requireBounded}" = "true" ]; then ARGS+=(--require-bounded); fi
                            python3 -m scripts.ai.prodgen --json promote --sha "\${MAIN_SHA}" "\${ARGS[@]}" > prodgen_promote.json
                        """)
                    }
                    int rc = -1
                    def runPromote = { String credArg ->
                        withCredentials([usernamePassword(credentialsId: 'hshwang token', usernameVariable: 'PRODGEN_GIT_USER_GITHUB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITHUB')]) {
                            if (haveGitlab) {
                                withCredentials([usernamePassword(credentialsId: 'se-gitlab-push', usernameVariable: 'PRODGEN_GIT_USER_GITLAB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITLAB')]) {
                                    rc = promoteBody(credArg)
                                }
                            } else {
                                rc = promoteBody(credArg)
                            }
                        }
                    }
                    try {
                        withCredentials([usernamePassword(credentialsId: 'se-jenkins-lint', usernameVariable: 'LINT_USER', passwordVariable: 'LINT_TOKEN'),
                                         string(credentialsId: 'server-gather-vault-password', variable: 'VAULT_PASSWORD')]) {
                            runPromote('yes')
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (Exception e) {
                        echo "[Promote] 린터/vault credential 바인딩 실패 — 자격 없이 promote (환경 재확인 불가 → PARTIAL 가능): ${e.getClass().simpleName}"
                        runPromote('no')
                    }
                    env.CI_STAGE_PROMOTE = (rc == 0) ? (dryRun ? 'DRY_RUN' : 'PASS') : 'FAIL'
                    if (rc != 0) { error "[Promote] prodgen promote rc=${rc} — prodgen_promote.json (refused 사유)" }
                    echo "[Promote] ${dryRun ? 'dry-run 미리보기 — 원격 변경 0' : '실 승격 완료 — 양 원격 ls-remote 대조는 prodgen_promote.json 의 publish'}"
                }
            }
        }
    }

    post {
        always {
            script {
                Map stages = seWriteStageResults()
                echo "[Post] stages=${stages}"
            }
            archiveArtifacts(artifacts: 'toolchain.txt,ci_gate.log,finalize_corpus_python.json,finalize_corpus_groovy.json,input_acceptance_groovy.json,budget_selftest.jsonl,harness_main_results.json,harness_bounded_results.json,harness_tree_results.json,prodgen_drift.json,prodgen_verify_report.json,prodgen_verify_report.json.sha256,prodgen_verify_stdout.json,prodgen_verify_env.json,vault_decrypt_check.txt,vault_decrypt_rc.txt,e2e_entries.txt,e2e_tip_observations.json,e2e_evidence.json,prodgen_verify_report.aggregated.json,prodgen_promote.json,ci_stage_results.json',
                             allowEmptyArchive: true, fingerprint: false)
            echo "[Post] 결과: ${currentBuild.currentResult} MAIN_SHA=${env.MAIN_SHA ?: '-'} 소요: ${currentBuild.durationString ?: '-'}"
        }
        unstable {
            echo '[Post] [WARN] PARTIAL — 건너뛴·미확인 검증이 있다. 통과로 보고하지 않는다 (ci_stage_results.json · 각 stage 의 artifact 참조)'
        }
        failure {
            echo '[Post] [FAIL] 검증 실패 — 콘솔 로그와 artifact(ci_gate.log · finalize_corpus_*.json · prodgen_*.json) 확인'
        }
    }
}
