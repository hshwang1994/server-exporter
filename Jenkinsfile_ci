                        archiveArtifacts(artifacts: 'prodgen_build.json,prodtree.tar.gz,prodtree_portal.sha256', allowEmptyArchive: false, fingerprint: false)
                        echo "[Prodgen Build] OK — Jenkinsfile_portal sha256=${env.PRODTREE_PORTAL_SHA256}"
                    } else {
                        env.CI_STAGE_PRODGEN_BUILD = 'FAIL'
                        archiveArtifacts(artifacts: 'prodgen_build.json', allowEmptyArchive: true, fingerprint: false)
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            error "[Prodgen Build] FAIL rc=${rc} — class B 또는 분류 오류 (prodgen_build.json; pwsh 가 없으면 PowerShell 주석이 B 로 남는다 — toolchain.txt 의 pwsh= 줄)"
                        }
