                    } else {
                        unstable("[Vault] FAIL rc=${vrc}: Vault 파일을 복호화하지 못했거나 구조가 맞지 않습니다.\n  기록: vault_decrypt_check.txt")
                    }
                    writeFile(file: 'prodgen_verify_env.json', encoding: 'UTF-8', text: groovy.json.JsonOutput.toJson([lint_credential: haveLint, vault_credential: haveVault, rc: rc, vault_decrypt_rc: vrc]))
