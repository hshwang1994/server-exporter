                                                                       expected_sha256: env.PRODTREE_PORTAL_SHA256, expected_archive_sha256: env.PRODTREE_ARCHIVE_SHA256,
                                                                       tree_hash: env.PRODTREE_TREE_HASH, results: results, problems: g.problems]))
                        // main 단계와 같은 판정(2026-10-08 C5) — 기대 Jenkins 결과 · 내부 verdict · 후보/생성물 결속. Jenkins 결과가 SUCCESS 인지만 보면
                        //   기대 ABORTED 시나리오와 내부 판정 실패를 잘못 센다
                        List notPass = results.findAll { !it.ok }
                        env.CI_STAGE_HARNESS_TREE = (notPass || g.problems) ? 'FAIL' : 'PASS'
                        if (notPass || g.problems) {
                            unstable("[Harness/prodtree] " + (notPass ? "기대 결과와 다른 시나리오가 ${notPass.size()}개 있습니다." : '시나리오 결과를 모으는 중 문제가 있었습니다.') +
                                     (notPass ? "\n  시나리오: ${notPass.collect { it.scenario + '=' + it.result + '(expected ' + it.expected + ', verdict ' + (it.verdict ?: '-') + ')' }.join(', ')}" : '') +
                                     (g.problems ? "\n  집계 문제: ${g.problems}" : '') + '\n  기록: harness_tree_results.json')
                        }
                    }
                }
            }
        }

        stage('Evidence Aggregate') {
            when { expression { env.CI_STAGE_PRODGEN_VERIFY in ['PASS', 'PARTIAL'] && seFailedPrereqs().isEmpty() } }
            steps {
                script {
                    // 이 빌드의 Harness 결과 + 파라미터로 받은 main Job 시나리오 빌드를 구조화 증거로 모아 보고서에 붙인다(digest 재계산).
                    //   Jenkins 조회에는 린터 토큰(읽기)을 쓴다 — 없으면 집계를 건너뛰고 PARTIAL 로 남긴다.
                    List entries = []
                    for (String f in ['harness_main_results.json', 'harness_tree_results.json']) {
                        if (fileExists(f)) {
                            def r = readJSON(file: f, returnPojo: true)
                            for (def hr in (r.results ?: [])) { if (hr.number != null) { entries << "${hr.scenario}=${r.harness_job}:${hr.number}".toString() } }
                        }
                    }
                    for (String ent in params.E2E_MAIN_ENTRIES.split(',').collect { it.trim() }.findAll { it }) { entries << ent }
                    if (!entries) {
                        env.CI_STAGE_EVIDENCE = 'PARTIAL'
                        unstable('[Evidence] PARTIAL: 모을 증거가 없습니다. Harness 결과와 E2E_MAIN_ENTRIES가 모두 비어 있습니다.')
                    } else {
                        writeFile(file: 'e2e_entries.txt', encoding: 'UTF-8', text: entries.join('\n') + '\n')
                        if (params.E2E_TIP_OBSERVATIONS_JSON?.trim()) {
                            writeFile(file: 'e2e_tip_observations.json', encoding: 'UTF-8', text: params.E2E_TIP_OBSERVATIONS_JSON.trim() + '\n')
                        }
                        int rc = -1
                        try {
                            withCredentials([usernamePassword(credentialsId: 'se-jenkins-lint', usernameVariable: 'LINT_USER', passwordVariable: 'LINT_TOKEN')]) {
                                rc = sh(returnStatus: true, label: 'evidence', script: '''#!/bin/bash
                                    set -o pipefail
                                    set +x
                                    cd "${WORKSPACE}"
                                    . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                                    NETRC_TMP="$(mktemp)"; chmod 600 "$NETRC_TMP"
                                    trap 'rm -f "$NETRC_TMP"' EXIT
                                    printf 'machine %s login %s password %s\\n' "$(echo "${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "${LINT_USER}" "${LINT_TOKEN}" > "$NETRC_TMP"
                                    ARGS=()
                                    while IFS= read -r line; do [ -n "$line" ] && ARGS+=(--entry "$line"); done < e2e_entries.txt
                                    # §5: 트리거 측 tip 관측(있을 때만) — fail-closed 빌드의 직접 바인딩. [Trusted] 내용 대조는 이 workspace 의 git 객체로 한다.
                                    if [ -f e2e_tip_observations.json ]; then ARGS+=(--tip-observations e2e_tip_observations.json); fi
                                    python3 -m scripts.ai.prodgen --json e2e-evidence --jenkins-url "${JENKINS_URL%/}" --netrc "$NETRC_TMP" "${ARGS[@]}" --out e2e_evidence.json > e2e_evidence_stdout.json
                                    python3 -m scripts.ai.prodgen --json evidence-aggregate --report prodgen_verify_report.json --evidence e2e_evidence.json --out prodgen_verify_report.aggregated.json > evidence_aggregate_stdout.json
                                ''')
                            }
                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                            throw fie
                        } catch (Exception e) {
                            echo "[Evidence] Jenkins 읽기 자격증명(se-jenkins-lint)을 쓸 수 없어 증거를 모으지 않았습니다.\n  오류: ${e.getClass().simpleName}"
                        }
                        env.CI_STAGE_EVIDENCE = (rc == 0) ? 'PASS' : 'PARTIAL'
                        if (rc != 0) { unstable('[Evidence] PARTIAL: 증거를 모두 모으지 못했습니다. 이 빌드로는 승격할 수 없습니다.') }
                    }
                }
            }
        }

        stage('Prodgen Promote') {
            when { expression { params.PROMOTE } }
            steps {
                script {
                    // 승격 집행 조건 6항 (Astra 3차 §8-2) — 하나라도 빠지면 원격 변경 0. `branch` 조건은 쓰지 않는다(일반 Pipeline).
                    List required = ['GATE', 'CORPUS', 'BUDGET', 'HARNESS_MAIN', 'PRODGEN_BUILD', 'HARNESS_TREE', 'PRODGEN_DRIFT', 'PRODGEN_VERIFY', 'EVIDENCE']
                    List bad = required.findAll { (env."CI_STAGE_${it}" ?: 'not_run') != 'PASS' }.collect { "${it}=${env."CI_STAGE_${it}" ?: 'not_run'}".toString() }
                    if (bad) { error "[Promote] 통과하지 않은 필수 단계가 있어 승격하지 않습니다. 원격 변경 0\n  단계: ${bad}" }
                    if (!fileExists('prodgen_verify_report.aggregated.json')) { error '[Promote] 증거를 모은 검사 보고서가 없어 승격하지 않습니다. 원격 변경 0' }
                    seWriteStageResults()          // prodgen promote 가 같은 stage 증거를 --ci-stage-results 로 다시 확인한다 (검토 C4)
                    def report = readJSON(file: 'prodgen_verify_report.aggregated.json', returnPojo: true)
                    String head = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String want = params.PROMOTE_SHA?.trim()
                    if (!(want && want == env.MAIN_SHA && env.MAIN_SHA == head && report.binding?.main_sha == head)) {
                        error "[Promote] 승격할 SHA 값이 서로 다릅니다. 원격 변경 0\n  PROMOTE_SHA=${want} MAIN_SHA=${env.MAIN_SHA} HEAD=${head} report=${report.binding?.main_sha}"
                    }
                    if (report.verdict != 'COMPLETE_PASS') { error "[Promote] 검사 보고서 결과가 ${report.verdict}입니다. COMPLETE_PASS일 때만 승격합니다. 원격 변경 0" }
                    // 양 원격 credential 이 모두 있어야 실 승격. GitLab 자격이 없으면 dry-run 으로만 (알려진 자격 부재로 GitHub 만 먼저 바꾸지 않는다 — §8-1)
                    boolean haveGitlab = true
                    try {
                        withCredentials([usernamePassword(credentialsId: 'se-gitlab-push', usernameVariable: 'PRODGEN_GIT_USER_GITLAB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITLAB')]) {
                            echo '[Promote] GitLab push 자격증명을 확인했습니다.'
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (Exception e) {
                        haveGitlab = false
                        echo "[Promote] GitLab push 자격증명(se-gitlab-push)이 없어 실제 승격 없이 dry-run으로 진행합니다.\n  오류: ${e.getClass().simpleName}"
                    }
                    boolean dryRun = params.PROMOTE_DRY_RUN || !haveGitlab
                    String remotes = haveGitlab ? 'origin,internal' : 'origin'
                    // 린터 토큰(G13 · jenkins_version 포착) 과 vault 암호(G19) 도 Promote 에 바인딩한다 — 없으면 promote 가 환경을 "미확인" 으로 보고
                    //   환경 의존 gate 를 재실행하는데 자격이 없어 G13/G19 가 SKIP → PARTIAL 이 된다 (CI #10 dry-run 실측). 임시 파일은 mktemp 0600 + trap.
                    def promoteBody = { String credArg ->
                        return sh(returnStatus: true, label: 'prodgen promote', script: """#!/bin/bash
                            set -o pipefail
                            set +x
                            cd "\${WORKSPACE}"
                            . "\${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                            eval "\$(bash scripts/ai/prodgen/ci_pwsh_bootstrap.sh --env)"
                            export GIT_ASKPASS="\${WORKSPACE}/scripts/ai/prodgen/git_askpass.sh"
                            chmod +x "\$GIT_ASKPASS"
                            NETRC_TMP=""; VAULT_TMP=""
                            trap 'rm -f "\$NETRC_TMP" "\$VAULT_TMP"' EXIT
                            CRED_ARGS=()
                            if [ "${credArg}" = "yes" ]; then
                                NETRC_TMP="\$(mktemp)"; chmod 600 "\$NETRC_TMP"
                                printf 'machine %s login %s password %s\\n' "\$(echo "\${JENKINS_URL}" | sed -E 's#https?://([^/]+)/?.*#\\1#')" "\${LINT_USER}" "\${LINT_TOKEN}" > "\$NETRC_TMP"
                                VAULT_TMP="\$(mktemp)"; chmod 600 "\$VAULT_TMP"
                                printf '%s' "\${VAULT_PASSWORD}" > "\$VAULT_TMP"
                                CRED_ARGS+=(--netrc "\$NETRC_TMP" --vault-password-file "\$VAULT_TMP" --jenkins-url "\${JENKINS_URL%/}")
                            fi
                            if [ "${haveGitlab}" = "true" ]; then
                                git remote get-url internal >/dev/null 2>&1 || git remote add internal https://10.100.64.156/root/server-expoter.git
                                git config "http.https://10.100.64.156/.sslVerify" false      # URL 범위 설정 — 전역 설정이 아니다
                            fi
                            ARGS=(--push-remote "${remotes}" --verify-report prodgen_verify_report.aggregated.json --e2e-evidence e2e_evidence.json \\
                                  --ci-stage-results ci_stage_results.json --ci-build "\${BUILD_URL}" --source-build-url "\${BUILD_URL}" "\${CRED_ARGS[@]}")
                            if [ -n "\${BOOTSTRAP_BASELINE:-}" ]; then ARGS+=(--bootstrap-baseline "\${BOOTSTRAP_BASELINE}"); fi
                            if [ "${dryRun}" = "true" ]; then ARGS+=(--dry-run); fi
                            python3 -m scripts.ai.prodgen --json promote --sha "\${MAIN_SHA}" "\${ARGS[@]}" > prodgen_promote.json
                        """)
                    }
                    int rc = -1
                    def runPromote = { String credArg ->
                        withCredentials([usernamePassword(credentialsId: 'hshwang token', usernameVariable: 'PRODGEN_GIT_USER_GITHUB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITHUB')]) {
                            if (haveGitlab) {
                                withCredentials([usernamePassword(credentialsId: 'se-gitlab-push', usernameVariable: 'PRODGEN_GIT_USER_GITLAB', passwordVariable: 'PRODGEN_GIT_PASSWORD_GITLAB')]) {
                                    rc = promoteBody(credArg)
                                }
                            } else {
                                rc = promoteBody(credArg)
                            }
                        }
                    }
                    try {
                        withCredentials([usernamePassword(credentialsId: 'se-jenkins-lint', usernameVariable: 'LINT_USER', passwordVariable: 'LINT_TOKEN'),
                                         string(credentialsId: 'server-gather-vault-password', variable: 'VAULT_PASSWORD')]) {
                            runPromote('yes')
                        }
                    } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
                        throw fie
                    } catch (Exception e) {
                        echo "[Promote] Jenkins 읽기 자격증명과 Vault 자격증명을 쓸 수 없어 자격증명 없이 승격을 진행합니다. 환경을 다시 확인하지 못해 PARTIAL이 될 수 있습니다.\n  오류: ${e.getClass().simpleName}"
                        runPromote('no')
                    }
                    env.CI_STAGE_PROMOTE = (rc == 0) ? (dryRun ? 'DRY_RUN' : 'PASS') : 'FAIL'
                    if (rc != 0) { error "[Promote] FAIL rc=${rc}: 승격하지 못했습니다.\n  거부 사유: prodgen_promote.json" }
                    echo "[Promote] ${dryRun ? 'dry-run을 마쳤습니다. 원격 변경 0' : '승격을 마쳤습니다. 두 원격 반영 확인 결과는 prodgen_promote.json의 publish 항목에 있습니다.'}"
                }
            }
        }
    }

    post {
        always {
            script {
                Map stages = seWriteStageResults()
                echo "[Post] stages=${stages}"
            }
            archiveArtifacts(artifacts: 'toolchain.txt,ci_gate.log,finalize_corpus_python.json,finalize_corpus_groovy.json,input_acceptance_groovy.json,budget_selftest.jsonl,budget_pytest_evidence.json,harness_main_results.json,harness_tree_results.json,prodgen_drift.json,prodgen_verify_report.json,prodgen_verify_report.json.sha256,prodgen_verify_stdout.json,prodgen_verify_env.json,vault_decrypt_check.txt,vault_decrypt_rc.txt,e2e_entries.txt,e2e_tip_observations.json,e2e_evidence.json,prodgen_verify_report.aggregated.json,prodgen_promote.json,ci_stage_results.json',
                             allowEmptyArchive: true, fingerprint: false)
            echo "[Post] 결과: ${currentBuild.currentResult}, MAIN_SHA=${env.MAIN_SHA ?: '-'}, 소요 시간 ${seDuration((long) ((System.currentTimeMillis() - (long) currentBuild.startTimeInMillis) / 1000L))}"
        }
        unstable {
            echo '[Post] [WARN] PARTIAL: 건너뛰었거나 확인하지 못한 검사가 있어 통과로 보지 않습니다. 단계별 결과: ci_stage_results.json'
        }
        failure {
            echo '[Post] [FAIL] 실패한 검사가 있습니다. 단계별 결과: ci_stage_results.json'
        }
    }
}
