                        set -eo pipefail
                        cd "${WORKSPACE}"
                        . "${WORKSPACE}/scripts/activate_ansible_venv.sh" || exit 1
                        # 수집 실행 기록 · 재개 대상 · 보수적 누적 실행 시간(gather_state.py — 가짜 시계), 수집 실행(run_gather.sh — 축소한 한계로 도달 · 기록 ·
                        # 원격 연결 정리 · 취소 신호 · 남은 대상만 이어서 수집 · 잠금 대기, Linux 전용이라 이 Runner 에서 실제로 돈다), 빌드 환경 경계,
                        # 시간 상수가 파일마다 같은지, 오래된 작업 폴더 정리 (8차 R3 · R8, 9차). 이 5개 파일은 Gate(ci_gate.sh 의 tests/unit)가 같은 SHA ·
                        # 같은 Runner · 같은 venv 로 이미 실행했다 — 다시 돌리지 않고 그 실행 기록(JUnit)을 시험 ID 단위로 대조한다(2026-10-08).
                        # 지금 모이는 ID 가 전부 한 번씩 있고 통과여야 PASS, 건너뜀 · 기록 없음은 PARTIAL(2), 실패 · 누락 · 다른 빌드의 기록은 FAIL(1)
                        ev=0
                        python3 tests/scripts/junit_evidence_check.py --junit ci_gate_junit_unit.xml --not-before "${SE_CI_START_EPOCH}" --expect-sha "${MAIN_SHA}" --report budget_pytest_evidence.json tests/unit/test_gather_state.py tests/unit/test_run_gather.py tests/unit/test_env_guard.py tests/unit/test_time_limits.py tests/unit/test_workspace_cleanup.py || ev=$?
                        # 이 Runner 의 vCPU 로 대표 입력 3건을 실제 시작 계산(gather_state.py begin)에 넣는다 — 메모리를 보지 않으므로 이 Runner 의 가용 메모리가
                        # 얼마든 바로 시작해야 한다(이번 한계 6시간, 대상 전부). 9차 시험 3(메모리 0 · 측정 불가)의 실제 Runner 확인이다
                        : > budget_selftest.jsonl
                        for spec in "os 3" "esxi 50" "redfish 200"; do
                            set -- $spec
                            d="$(mktemp -d)"
                            python3 -c 'import json, sys; json.dump({"schema": 1, "channel": sys.argv[1], "ips": ["10.255.%d.%d" % (i // 250, i % 250 + 1) for i in range(int(sys.argv[2]))]}, open(sys.argv[3], "w"))' "$1" "$2" "$d/gather_manifest.json"
                            out="$(python3 scripts/gather_state.py begin --ws "$d" --pid $$ --gather-max 21600 --vcpu "$(nproc 2>/dev/null || echo 2)")"
                            rm -rf "$d"
                            echo "$out" | tee -a budget_selftest.jsonl
                            ok="$(echo "$out" | python3 -c 'import json, sys; p = json.load(sys.stdin); print("yes" if p["limit"] == 21600 and p["pending"] == int(sys.argv[1]) and p["state"] is None else "no")' "$2")"
                            [ "$ok" = yes ] || { echo "[시작 계산] FAIL: channel=$1 대상 $2대가 바로 시작하지 않았습니다."; exit 1; }
                        done
                        exit "$ev"
                    ''')
                    env.CI_STAGE_BUDGET = (rc == 0) ? 'PASS' : ((rc == 2) ? 'PARTIAL' : 'FAIL')
