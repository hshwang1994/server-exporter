// corpus 대조 규칙 — Layer B(seReconcileRaw) 결과를 Layer A 정답지와 origin 별로 비교한다 (Python 쪽은 tests/scripts/finalize_corpus_check.py).
//   output     : 줄 원문이 같다 (두 Layer 모두 OUTPUT 줄을 재직렬화하지 않는다)
//   checkpoint : errors 를 뺀 12 필드가 같고 기존 errors 도 같다. 덧붙인 마지막 1건만 Layer 별 사유다 (Layer B 는 section gather + canon.emitFailed)
//   synthetic  : 뼈대(schema_version…data 11 필드)가 같다. 진단은 Layer A 가 progress 로 세분하므로(§6-4) Layer A 도
//                OUTPUT_BUILD_FAILED 일 때만 failure_reason · errors[0].section 까지 대조한다
//   report     : by_origin · kept · filled 같음. dropped 는 file:line 집합(Layer A 의 corrupt_lines · truncated_tail 포함), conflicts 는 ip:chosen 집합
//   JSON 은 양쪽 모두 groovy.json.JsonSlurper 로 읽어 비교한다(Classic 변형 생성자는 sandbox 거부 — 2026-10-03 실측) — Groovy JsonOutput 의
//   \\uXXXX escaping 과 Python 의 ensure_ascii=False 는 값이 같다.
@NonCPS
List seCorpusCompare(String caseName, Map res, String expectedFinal, String expectedReport, String expectedOrigins, Map canon) {
    def slurper = new groovy.json.JsonSlurper()
    List problems = []
    List expLines = expectedFinal.split('\n').findAll { it.trim() }.collect { it.trim() }
    List origins = slurper.parseText(expectedOrigins)
    Map expRep = slurper.parseText(expectedReport)
    List gotLines = res.lines
    Map gotRep = res.report
    int accepted = (expRep.accepted ?: 0) as int
    if (gotLines.size() != accepted || expLines.size() != accepted || origins.size() != accepted) {
        problems << "${caseName}: cardinality got=${gotLines.size()} expected=${expLines.size()} origins=${origins.size()} accepted=${accepted}".toString()
        return problems
    }
    List skeleton = ['schema_version', 'target_type', 'collection_method', 'ip', 'hostname', 'vendor', 'status', 'sections', 'meta', 'correlation', 'data']
    for (int i = 0; i < accepted; i++) {
        String tag = "${caseName}[${i}]".toString()
        String origin = origins[i]
        def got = slurper.parseText(gotLines[i])
        def exp = slurper.parseText(expLines[i])
        if (got.ip != exp.ip) { problems << "${tag}: ip ${got.ip} != ${exp.ip}".toString(); continue }
        if ((got.keySet() as List) != (exp.keySet() as List)) { problems << "${tag}: envelope key order ${got.keySet()}".toString() }
        if (origin == 'output') {
            if (gotLines[i] != expLines[i]) { problems << "${tag}: OUTPUT line is not verbatim".toString() }
        } else if (origin == 'checkpoint') {
            for (String k in skeleton) { if (got[k] != exp[k]) { problems << "${tag}: checkpoint field ${k} differs".toString() } }
            if (got.diagnosis != exp.diagnosis) { problems << "${tag}: checkpoint diagnosis differs".toString() }
            List ge = (got.errors instanceof List) ? got.errors : []
            List ee = (exp.errors instanceof List) ? exp.errors : []
            if (ge.size() != ee.size() || ge.isEmpty()) {
                problems << "${tag}: errors size ${ge.size()} != ${ee.size()}".toString()
            } else {
                for (int j = 0; j < ge.size() - 1; j++) { if (ge[j] != ee[j]) { problems << "${tag}: errors[${j}] differs".toString() } }
                def last = ge[ge.size() - 1]
                if (last.section != 'gather' || last.message != canon.emitFailed) { problems << "${tag}: Layer B appended error is not gather/emitFailed".toString() }
                if (!(ee[ee.size() - 1].section in ['gather', 'addon'])) { problems << "${tag}: Layer A appended error section ${ee[ee.size() - 1].section}".toString() }
            }
        } else if (origin == 'synthetic') {
            for (String k in skeleton) { if (got[k] != exp[k]) { problems << "${tag}: synthetic field ${k} differs".toString() } }
            if ((got.sections.keySet() as List) != (exp.sections.keySet() as List)) { problems << "${tag}: sections order".toString() }
            def gd = got.diagnosis
            def ed = exp.diagnosis
            if (gd.details?.finalizer != 'layer_b' || gd.failure_stage != 'fallback' || gd.failure_code != 'OUTPUT_BUILD_FAILED') {
                problems << "${tag}: Layer B diagnosis ${gd.failure_stage}/${gd.failure_code}/${gd.details?.finalizer}".toString()
            }
            if (ed.details?.finalizer != 'layer_a') { problems << "${tag}: expected line is not a Layer A synthetic envelope".toString() }
            if (!(got.errors instanceof List) || got.errors.size() != 1 || got.errors[0].message != gd.failure_reason) {
                problems << "${tag}: Layer B errors[] must be one entry echoing failure_reason".toString()
            }
            if (ed.failure_code == 'OUTPUT_BUILD_FAILED') {
                if (gd.failure_reason != ed.failure_reason) { problems << "${tag}: failure_reason differs (fallback catalog drift)".toString() }
                if (got.errors[0].section != exp.errors[0].section) { problems << "${tag}: errors[0].section ${got.errors[0].section} != ${exp.errors[0].section}".toString() }
            }
        } else {
            problems << "${tag}: unknown origin '${origin}'".toString()
        }
    }
    if (gotRep.by_origin != expRep.by_origin) { problems << "${caseName}: by_origin ${gotRep.by_origin} != ${expRep.by_origin}".toString() }
    if ((gotRep.kept as int) != (expRep.kept as int) || (gotRep.filled as int) != (expRep.filled as int)) {
        problems << "${caseName}: kept/filled ${gotRep.kept}/${gotRep.filled} != ${expRep.kept}/${expRep.filled}".toString()
    }
    Set gotDropped = gotRep.dropped.collect { "${it.file}:${it.line}".toString() } as Set
    List expDroppedAll = (expRep.dropped ?: []) + (expRep.corrupt_lines ?: []) + (expRep.truncated_tail ?: [])
    Set expDropped = expDroppedAll.findAll { it.file in ['output', 'checkpoint'] }.collect { "${it.file}:${it.line}".toString() } as Set
    if (gotDropped != expDropped) { problems << "${caseName}: dropped ${gotDropped} != ${expDropped}".toString() }
    Set gotConf = gotRep.conflicts.collect { "${it.ip}:${it.chosen}".toString() } as Set
    Set expConf = (expRep.conflicts ?: []).collect { "${it.ip}:${it.chosen}".toString() } as Set
    if (gotConf != expConf) { problems << "${caseName}: conflicts ${gotConf} != ${expConf}".toString() }
    return problems
}

// 접수 대상 규칙 대조 (2026-10-05 F03) — Jenkinsfile_portal 의 seAcceptTargets 를 사례 표(tests/fixtures/input_validation/cases.json)로 돌린다.
//   같은 표로 inventory.sh 3종(Python)은 Gate 의 pytest(tests/unit/test_input_acceptance_parity.py)가 돌린다 — 두 쪽 결과가 표와 같으면
//   Validate 와 inventory 가 같은 요청을 같은 규칙으로 받아들이거나 거부한다. 'PRIMARY' · 'OTHER' 키는 채널별 주 필드로 바꿔 넣는다.
@NonCPS
List seAcceptCompare(def acc, List cases) {
    Map primary = [os: 'service_ip', esxi: 'service_ip', redfish: 'bmc_ip']
    Map other = [os: 'bmc_ip', esxi: 'bmc_ip', redfish: 'service_ip']
    List problems = []
    for (String ch in ['os', 'esxi', 'redfish']) {
        for (Object c in cases) {
            def inv = c.inventory
            if (inv instanceof List) {
                List renamed = []
                for (Object h in inv) {
                    if (h instanceof Map) {
                        Map m = [:]
                        for (Object k in h.keySet()) { m[(k == 'PRIMARY' ? primary[ch] : (k == 'OTHER' ? other[ch] : k))] = h[k] }
                        renamed << m
                    } else {
                        renamed << h
                    }
                }
                inv = renamed
            } else if (inv instanceof Map) {
                Map m = [:]
                for (Object k in inv.keySet()) { m[(k == 'PRIMARY' ? primary[ch] : (k == 'OTHER' ? other[ch] : k))] = inv[k] }
                inv = m
            }
            Map res = acc.seAcceptTargets(inv, ch)
            boolean ok = c.containsKey('accept') ? (res.ips == c.accept && !res.error) : (res.error && res.ips == null)
            if (!ok) { problems << "${ch}/${c.name}: got ${res} expected ${c.containsKey('accept') ? c.accept : 'reject ' + c.reject}".toString() }
        }
    }
    return problems
}

// Harness Job 을 시나리오별로 돌린다 — 시나리오당 빌드 1개(격리 단위: stash · archive · 빌드 결과가 빌드 단위). 한 lane 의 목록을 순서대로 부른다
//   (2026-10-08: 두 lane 은 seRunHarnessGroup 이 나눈다. 별도 Job 이라 CI 자신과 교착하지 않는다).
//   기대 Jenkins 결과는 scenarios.json 의 jenkins_result(기본 SUCCESS) — user_abort 는 ABORTED 로 끝나는 것이 정상이다 (검토 C1·C5).
//   quietPeriod: 0 — 이미 고정된 후보에 대한 시험이라 변경을 모아 기다릴 이유가 없다(전역 quiet period 5초는 그대로 둔다).
//   SINK_PORT=0 — 같은 Job 의 빌드가 동시에 돌므로 수신기 포트는 OS 가 빌드마다 정한다. 자식이 남긴 빌드 변수로 후보 · 생성물과 대조한다(seHarnessBinding).
def seRunHarness(String functionsSrc, List items, Map extra, String lane) {
    def defs = readJSON(file: 'tests/jenkins/harness/scenarios.json', returnPojo: true).scenarios
    String harnessJob = seHarnessJob()
    Map want = [main_sha: env.MAIN_SHA, source_sha256: extra.EXPECTED_SHA256, archive_sha256: extra.EXPECTED_ARCHIVE_SHA256, tree_hash: extra.EXPECTED_TREE_HASH]
    List results = []
    for (Map item in items) {
        String s = item.name
        List ps = [string(name: 'SCENARIO', value: s), string(name: 'MAIN_SHA', value: env.MAIN_SHA), string(name: 'FUNCTIONS_SRC', value: functionsSrc),
                   string(name: 'SINK_PORT', value: '0')]
        extra.each { k, v -> ps << string(name: k, value: (v ?: '').toString()) }
        String expected = (defs[s]?.jenkins_result ?: 'SUCCESS').toString()
        def b = build(job: harnessJob, wait: true, propagate: false, quietPeriod: 0, parameters: ps)
        // Jenkins 결과와 Harness 판정을 모두 본다 — ABORTED 로 끝나는 시나리오는 판정이 FAIL 이어도 결과가 기대와 같다(2026-10-06 CI #27 · #29)
        String verdict = ''
        Map bound = [ok: false, problems: ['빌드 변수를 읽지 못함']]
        try {
            verdict = ((b.buildVariables ?: [:]).SE_HARNESS_VERDICT ?: '').toString()
            bound = seHarnessBinding(functionsSrc, (b.buildVariables ?: [:]), want)
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException fie) {
            throw fie
        } catch (Exception e) {
            verdict = ''
        }
        boolean ok = seHarnessOk((b.result ?: '').toString(), expected, verdict, bound.ok == true)
        results << [idx: item.idx, lane: lane, scenario: s, number: b.number, result: b.result, expected: expected, verdict: verdict, ok: ok, url: b.absoluteUrl,
                    functions_src: functionsSrc, checkout_sha: bound.checkout_sha, functions_sha256: bound.functions_sha256, source_sha256: bound.source_sha256,
                    archive_sha256: bound.archive_sha256, tree_hash: bound.tree_hash, binding_problems: bound.problems]
        echo "[Harness/${functionsSrc}/${lane}] ${s}: #${b.number} ${b.result} (expected ${expected}) verdict=${verdict ?: '-'} binding=${bound.ok ? 'ok' : bound.problems} ${b.absoluteUrl}"
    }
    return results
}

// Harness Job — 기본은 공유 Job. 시험용 CI 사본(Job 이름이 다르다)은 공유 Harness Job 을 부르지 않는다: 격리 시험이 공유 Job 에 빌드 · 수신기를 남기지 않게(2026-10-08).
//   이름에 'harness' 가 있어야 한다 — prodgen e2e-evidence 가 Job 경로로 Harness 빌드를 가른다.
String seHarnessJob() {
    String shared = 'clovirone-cicd/clovirone-server-gather-harness'
    String job = (params.HARNESS_JOB ?: '').trim() ?: shared
    if (!job.contains('harness')) { error "[Harness] HARNESS_JOB에는 이름에 harness가 들어간 Harness Job을 지정하세요: ${job}" }
    if (job == shared && env.JOB_NAME != 'clovirone-cicd/clovirone-server-gather-ci') {
        error "[Harness] 시험용 CI(${env.JOB_NAME})에서는 공유 Harness Job을 쓰지 않습니다.\n  HARNESS_JOB에 시험용 Harness Job을 지정하세요."
    }
    return job
}

// 자식 빌드가 남긴 값(빌드 변수)이 이번 후보 · 이번 생성물과 같은가 — 후보 SHA · 함수 해시 · (생성 tree) Jenkinsfile_portal · 압축 파일 · tree_hash.
//   다른 SHA 의 결과나 다른 생성물로 돈 결과를 이 후보의 통과로 세지 않는다(2026-10-08).
@NonCPS
Map seHarnessBinding(String functionsSrc, Map vars, Map want) {
    Map got = [checkout_sha    : (vars.SE_HARNESS_SHA ?: '').toString(),
               functions_sha256: (vars.SE_HARNESS_FUNCTIONS_SHA256 ?: '').toString(),
               source_sha256   : (vars.SE_HARNESS_SOURCE_SHA256 ?: '').toString(),
               archive_sha256  : (vars.SE_HARNESS_ARCHIVE_SHA256 ?: '').toString(),
               tree_hash       : (vars.SE_HARNESS_TREE_HASH ?: '').toString()]
    List problems = []
    if (!got.checkout_sha || got.checkout_sha != want.main_sha) { problems << "checkout ${got.checkout_sha ?: '-'} != MAIN_SHA".toString() }
    if (!got.functions_sha256) { problems << 'functions_sha256 없음' }
    if (functionsSrc == 'artifact') {
        for (String k in ['source_sha256', 'archive_sha256', 'tree_hash']) {
            if (!got[k] || got[k] != want[k]) { problems << "${k} ${got[k] ?: '-'} != ${want[k] ?: '-'}".toString() }
        }
    }
    got.ok = problems.isEmpty()
    got.problems = problems
    return got
}

// 시나리오 하나의 통과 — 기대 Jenkins 결과 · 내부 verdict PASS · 결속이 모두 맞아야 한다. 두 Harness 단계가 같은 식을 쓴다(2026-10-08 C5).
@NonCPS
boolean seHarnessOk(String result, String expected, String verdict, boolean bound) {
    return result == expected && verdict == 'PASS' && bound
}

// 고정 lane 배정 — 요청 순서의 i 번째를 i % lanes 번 lane 에. 각 항목은 요청 순서(idx)를 들고 다닌다.
@NonCPS
List seLanePlan(List names, int lanes) {
    List plan = []
    for (int l = 0; l < lanes; l++) { plan << [] }
    for (int i = 0; i < names.size(); i++) { plan[i % lanes] << [idx: i, name: names[i].toString()] }
    return plan
}

// lane 결과를 요청 순서로 모은다. 시나리오마다 정확히 한 결과여야 하고(빠짐 · 두 번은 통과가 아니다), 통과 항목의 함수 해시는 하나여야 한다(섞인 소스 거부).
@NonCPS
Map seMergeLanes(List names, Map laneOut) {
    List all = []
    for (Object k in (laneOut.keySet() as List).sort()) { all.addAll((laneOut[k] ?: []) as List) }
    List ordered = []
    List problems = []
    for (int i = 0; i < names.size(); i++) {
        List hits = all.findAll { r -> r.idx == i }
        if (hits.size() == 1 && hits[0].scenario == names[i]) {
            ordered << hits[0]
        } else {
            ordered << [idx: i, lane: '-', scenario: names[i], number: null, result: 'MISSING', expected: '-', verdict: '', ok: false]
            problems << "${names[i]}: 결과 ${hits.size()}건".toString()
        }
    }
    if (all.size() != names.size()) { problems << "결과 ${all.size()}건 != 요청 ${names.size()}건".toString() }
    Set fns = (ordered.findAll { r -> r.ok }.collect { r -> r.functions_sha256 } as Set)
    if (fns.size() > 1) { problems << "통과 항목의 functions_sha256 이 ${fns.size()}가지 — 섞인 소스".toString() }
    return [results: ordered, problems: problems]
}

// 판정 · 집계 자체 시험 — 그룹을 시작하기 전에 이 Jenkins 에서 직접 돌린다(밀리초). 기대된 ABORTED + 내부 PASS 는 통과, Jenkins 가 SUCCESS 여도 내부 FAIL ·
//   판정 누락 · 결속 불일치는 불통과. 병렬 집계도 순서가 섞인 결과 · 누락 · 중복 · 섞인 함수 해시를 잡아야 한다(2026-10-08 C5).
@NonCPS
List seHarnessJudgeSelfTest() {
    List problems = []
    List cases = [['SUCCESS', 'SUCCESS', 'PASS', true, true], ['ABORTED', 'ABORTED', 'PASS', true, true],
                  ['SUCCESS', 'SUCCESS', 'FAIL', true, false], ['SUCCESS', 'SUCCESS', '', true, false], ['SUCCESS', 'SUCCESS', 'PARTIAL', true, false],
                  ['ABORTED', 'SUCCESS', 'PASS', true, false], ['SUCCESS', 'ABORTED', 'PASS', true, false], ['FAILURE', 'SUCCESS', '', true, false],
                  ['SUCCESS', 'SUCCESS', 'PASS', false, false]]
    for (List c in cases) {
        if (seHarnessOk(c[0], c[1], c[2], c[3]) != c[4]) { problems << "seHarnessOk${c}".toString() }
    }
    List names = ['a', 'b', 'c']
    Map inOrder = seMergeLanes(names, [lane2: [[idx: 1, scenario: 'b', ok: true, functions_sha256: 'f']],
                                       lane1: [[idx: 2, scenario: 'c', ok: true, functions_sha256: 'f'], [idx: 0, scenario: 'a', ok: true, functions_sha256: 'f']]])
    if (inOrder.problems || inOrder.results.collect { r -> r.scenario } != names) { problems << 'merge: 요청 순서'.toString() }
    Map missing = seMergeLanes(names, [lane1: [[idx: 0, scenario: 'a', ok: true, functions_sha256: 'f']], lane2: [[idx: 1, scenario: 'b', ok: true, functions_sha256: 'f']]])
    if (!missing.problems || missing.results[2].ok) { problems << 'merge: 누락' }
    Map twice = seMergeLanes(['a'], [lane1: [[idx: 0, scenario: 'a', ok: true, functions_sha256: 'f']], lane2: [[idx: 0, scenario: 'a', ok: true, functions_sha256: 'f']]])
    if (!twice.problems || twice.results[0].ok) { problems << 'merge: 중복' }
    Map mixed = seMergeLanes(['a', 'b'], [lane1: [[idx: 0, scenario: 'a', ok: true, functions_sha256: 'f']], lane2: [[idx: 1, scenario: 'b', ok: true, functions_sha256: 'g']]])
    if (!mixed.problems) { problems << 'merge: 섞인 함수 해시' }
    return problems
}

// 두 고정 lane 으로 나눠 동시에 돌리고 요청 순서로 모은다(2026-10-08). 각 lane 은 자기 목록만 받고 결과는 parallel 의 반환값으로만 돌아온다 —
//   여러 분기가 공유 List · env 를 고치지 않는다. failFast 없음 · 자식은 propagate: false — 한 시험의 FAILURE · ABORTED 가 다른 lane 을 멈추지 않는다.
//   이 CI 가 취소되면 Jenkins 가 이 CI 가 부른 자식만 멈추고, 각 자식이 자기 수신기를 정리한다(Jenkinsfile_harness finally).
//   동시 실행 수 2 는 Harness 시험 전용이다(운영 수집의 forks · 자원 판단과 무관). 경합으로 시간 · 안정성이 나빠지면 1 로 되돌린다.
Map seRunHarnessGroup(String functionsSrc, List names, Map extra) {
    List selfTest = seHarnessJudgeSelfTest()
    if (selfTest) { return [results: [], problems: ["판정 · 집계 자체 시험 실패: ${selfTest}".toString()]] }
    seHarnessJob()                      // 잘못된 HARNESS_JOB 은 분기를 만들기 전에 멈춘다
    List plan = seLanePlan(names, 2)
    Map branches = [:]
    for (int l = 0; l < plan.size(); l++) {
        List mine = plan[l]
        String lane = "lane${l + 1}".toString()
        branches[lane] = { -> seRunHarness(functionsSrc, mine, extra, lane) }
    }
    Map out = parallel(branches)
    return seMergeLanes(names, out)
}

// 확정된 선행 검사 실패 — 이 후보로 긴 Harness 를 시작하지 않는다(2026-10-08). Drift(원격 production 상태)와 PARTIAL(자격 부재 등)은 막지 않는다.
// 시간 길이를 사람이 읽는 말로 — 1시간 5분 · 3분 20초 · 45초 (Jenkinsfile_portal 의 seDuration 과 같은 본문)
@NonCPS
String seDuration(long sec) {
    long v = Math.max(0L, sec)
    long h = (long) (v / 3600L)
    long m = (long) ((v % 3600L) / 60L)
    long s = v % 60L
    List parts = []
    if (h > 0L) { parts << "${h}시간".toString() }
    if (m > 0L) { parts << "${m}분".toString() }
    if (s > 0L || parts.isEmpty()) { parts << "${s}초".toString() }
    return parts.join(' ')
}

List seFailedPrereqs() {
    return ['GATE', 'CORPUS', 'BUDGET', 'PRODGEN_BUILD', 'PRODGEN_VERIFY'].findAll { k -> env."CI_STAGE_${k}" == 'FAIL' }
}

// stage 결과 파일 — post 가 마지막에 쓰고, Promote 는 prodgen promote 를 부르기 **전**에 한 번 더 써서 --ci-stage-results 로 넘긴다 (검토 C4)
def seWriteStageResults() {
    Map stages = [:]
    List failedPrereqs = seFailedPrereqs()
    for (String k in ['GATE', 'CORPUS', 'BUDGET', 'HARNESS_MAIN', 'PRODGEN_BUILD', 'HARNESS_TREE', 'PRODGEN_DRIFT', 'PRODGEN_VERIFY', 'VAULT_DECRYPT', 'EVIDENCE', 'PROMOTE']) {
        String v = env."CI_STAGE_${k}" ?: 'not_run'
        // 선행 검사 실패로 건너뛴 단계 — 실행하지 않았다는 사실 그대로 남긴다(PASS 가 아니다, 2026-10-08)
        if (v == 'not_run' && failedPrereqs && k in ['HARNESS_MAIN', 'HARNESS_TREE', 'EVIDENCE']) { v = 'SKIPPED' }
        stages[k] = v
    }
    writeFile(file: 'ci_stage_results.json', encoding: 'UTF-8',
              text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, build_url: env.BUILD_URL, result: currentBuild.currentResult, stages: stages,
                                                   skipped_because: failedPrereqs]))
    return stages
}

