                    } else {
                        List results = seRunHarness('checkout', scenarios, [:])
                        writeFile(file: 'harness_main_results.json', encoding: 'UTF-8',
                                  text: groovy.json.JsonOutput.toJson([main_sha: env.MAIN_SHA, functions_src: 'checkout', results: results]))
                        List notPass = results.findAll { !it.ok }
                        env.CI_STAGE_HARNESS_MAIN = notPass ? 'FAIL' : 'PASS'
                        if (notPass) { unstable("[Harness] ${notPass.size()}개 시나리오가 기대 결과가 아니다: ${notPass.collect { it.scenario + '=' + it.result + '(expected ' + it.expected + ')' }} (harness_main_results.json)") }
                    }
                    // Tier 2(BOUNDED=true) — 승인 4 시그니처가 없는 Jenkins 에서는 설계대로 재전파 → Harness 가 PARTIAL/승인 으로 둔다(UNSTABLE).
                    //   승격 조건이 아니므로 이 stage 의 결과를 FAIL 로 만들지 않고 HARNESS_BOUNDED 에 따로 적는다 — "interruption 충족" 으로 합산하지 않는다 (검토 C5).
                    List bounded = params.HARNESS_BOUNDED_SCENARIOS.split(',').collect { it.trim() }.findAll { it }
