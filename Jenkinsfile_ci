                        env.CI_STAGE_GATE = 'PARTIAL'
                        def skipped = readFile(file: 'ci_gate.log', encoding: 'UTF-8').split('\n').findAll { it.contains('건너뜀') || it.contains('skipped') }
                        skipped.each { echo "[Gate] skipped: ${it.trim()}" }
                        unstable("[Gate] PARTIAL — 건너뛴 단계 ${skipped.size()}건 (통과로 보고하지 않는다, ci_gate.log 참조)")
                    } else {
                        env.CI_STAGE_GATE = 'FAIL'
                        // 빌드는 FAILURE 로 두되 뒤 stage 는 계속 돌려 한 빌드에서 전부 보이게 한다 — Promote 는 stage 결과를 읽어 원격을 바꾸지 않는다.
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
